function addToCart(){
  if(selectedSize==='Theo yêu cầu'){zaloCurrentProduct();return}
  const note='';
  const cartImg=takumiColorImage(currentProduct,selectedColor);
  const appliedPromo=productBestPromoData(currentProduct,selectedSize);
  cart.push({id:Date.now(),productId:currentProduct.id,name:currentProduct.name,img:cartImg,size:selectedSize,style:selectedStyle,color:selectedColor,qty:selectedQuantity,basePrice:baseProductPrice(currentProduct,selectedSize),price:currentPrice(),oldPrice:oldProductPriceFor(currentProduct,selectedSize),appliedPromoCode:appliedPromo?appliedPromo.code:'',note});
  updateCart();

  // Không mở bảng giỏ hàng bên phải nữa. Thay vào đó cho ảnh sản phẩm bay về icon giỏ hàng.
  flyProductToCart().then(()=>{
    showTakumiToast('Đã thêm vào giỏ hàng', `${currentProduct.name} · ${selectedSize}${selectedStyle?' · '+selectedStyle:''} · ${selectedColor} · SL ${selectedQuantity}`);
    // Giữ popup chi tiết mở để khách có thể xem tiếp / mua ngay / chọn thêm biến thể.
    // Muốn tự đóng popup sau khi bay vào giỏ thì bỏ comment dòng dưới.
    // closeProductModal();
  });
}
function updateCart(){
  document.getElementById('cartCount').textContent=cart.reduce((s,i)=>s+cartItemQuantity(i),0);
  const box=document.getElementById('cartItems');
  const total=cart.reduce((s,i)=>s+cartItemLineTotal(i),0);
  document.getElementById('cartTotal').textContent=money(total);if(activeCheckoutVoucher&&checkoutVoucherDiscount(activeCheckoutVoucher)===0)activeCheckoutVoucher=null;
  if(!cart.length){activeCheckoutVoucher=null;activeShippingVoucher=null;box.innerHTML='<div class="cart-empty">Giỏ hàng đang trống.</div>';return}
  box.innerHTML=cart.map((item,i)=>`<div class="cart-item"><img src="${item.img}" alt="${item.name}"><div><b>${item.name}</b><small>Size: ${item.size}${item.style?'<br>Kiểu dáng: '+escapeAttr(item.style):''}<br>Màu: ${item.color}<br>Số lượng: ${cartItemQuantity(item)}${item.note?'<br>Ghi chú: '+item.note:''}</small><div class="cart-delivery"><i class="fa-solid fa-truck-fast"></i><span class="delivery-label">Vận chuyển</span><span>${deliveryDateRange()}</span></div><button class="remove-cart" onclick="removeCartItem(${i})">Xóa</button></div><div class="cart-item-price">${money(cartItemLineTotal(item))}</div></div>`).join('');
}

function buyNow(){
  if(!currentProduct)return;
  if(selectedSize==='Theo yêu cầu'){zaloCurrentProduct();return}
  const cartImg=takumiColorImage(currentProduct,selectedColor);
  cart=[{
    id:Date.now(),
    productId:currentProduct.id,
    name:currentProduct.name,
    img:cartImg,
    size:selectedSize,
    style:selectedStyle,
    color:selectedColor,
    qty:selectedQuantity,
    basePrice:baseProductPrice(currentProduct,selectedSize),
    price:currentPrice(),
    oldPrice:oldProductPriceFor(currentProduct,selectedSize),
    appliedPromoCode:(productBestPromoData(currentProduct,selectedSize)||{}).code||'',
    note:''
  }];
  updateCart();
  closeProductModal();
  openCheckout();
}

function removeCartItem(i){cart.splice(i,1);updateCart()}
function toggleCart(forceOpen){
  const drawer=document.getElementById('cartDrawer'), overlay=document.getElementById('cartOverlay');
  const open=forceOpen===true?!drawer.classList.contains('active'):drawer.classList.contains('active');
  if(forceOpen===true){drawer.classList.add('active');overlay.classList.add('active');return}
  drawer.classList.toggle('active');overlay.classList.toggle('active');
}
function siteBaseUrl(){
  try{return window.location.origin+window.location.pathname}catch(e){return ''}
}
function productPageLink(productId){
  const base=siteBaseUrl();
  return base?`${base}?product=${encodeURIComponent(productId)}`:`#product-${productId}`;
}
function orderProductLinksText(){
  return cart.map(item=>`- ${item.name}: ${productPageLink(item.productId)}`).join('\n');
}
function safeOrderImageRef(src){
  src=String(src||'').trim();
  if(!src)return '';
  if(src.startsWith('data:'))return '[Ảnh đang lưu dạng base64 - không gửi qua Formspree để tránh quá dung lượng]';
  return src.length>500?src.slice(0,500)+'...':src;
}
function compactText(value,limit=9000){
  value=String(value||'');
  return value.length>limit?value.slice(0,limit)+'\n...[Nội dung đã được rút gọn để Formspree nhận ổn định]':value;
}
function orderProductImagesText(){
  return cart.map(item=>`- ${item.name}: ${safeOrderImageRef(item.img)}`).join('\n');
}
function orderItemsText(){
  return cart.map((item,index)=>{
    const qty=cartItemQuantity(item);
    const unit=cartItemCheckoutPrice(item);
    const line=cartItemLineTotal(item);
    const style=item.style&&String(item.style).trim()?String(item.style).trim():'Mặc định';
    const size=item.size&&String(item.size).trim()?String(item.size).trim():'Chưa chọn';
    const color=item.color&&String(item.color).trim()?String(item.color).trim():'Chưa chọn';
    return [
      `${index+1}) ${item.name}`,
      `   Kiểu dáng / phân loại: ${style}`,
      `   Kích thước: ${size}`,
      `   Màu sắc: ${color}`,
      `   Số lượng: ${qty}`,
      `   Đơn giá: ${money(unit)}`,
      `   Thành tiền: ${money(line)}`,
      item.note?`   Ghi chú sản phẩm: ${item.note}`:''
    ].filter(Boolean).join('\n');
  }).join('\n\n');
}
function orderInternalRefsText(){
  return cart.map((item,index)=>{
    const id=item.productId||item.id||'';
    return `${index+1}) ${item.name}${id?' | ID: '+id:''}`;
  }).join('\n');
}
function orderQuantitySummary(){
  const totalQty=cart.reduce((s,item)=>s+cartItemQuantity(item),0);
  return `Tổng số lượng: ${totalQty}`;
}
function openCheckout(){
  if(!cart.length){alert('Giỏ hàng đang trống.');return}
  document.getElementById('cartDrawer').classList.remove('active');
  document.getElementById('cartOverlay').classList.remove('active');
  const best=bestUnlockedCheckoutVoucher();
  activeCheckoutVoucher=best;
  activeShippingVoucher=shippingVoucherInfo();
  const voucherInput=document.getElementById('checkoutVoucherInput');if(voucherInput)voucherInput.value=best?best.code:'';
  const voucherMsg=document.getElementById('checkoutVoucherMessage');if(voucherMsg){voucherMsg.textContent='';voucherMsg.className='voucher-message';}
  const orderCodeEl=document.getElementById('orderCode');if(orderCodeEl)orderCodeEl.textContent=Math.floor(1000+Math.random()*9000);
  const checkoutSummaryEl=document.getElementById('checkoutSummary');if(checkoutSummaryEl){checkoutSummaryEl.innerHTML=cart.map(item=>`<div class="summary-item"><img src="${item.img}" alt="${item.name}"><div><b>${item.name}</b><small>${item.style?`Kiểu dáng: ${item.style}<br>`:''}Size: ${item.size} · Màu: ${item.color} · SL ${cartItemQuantity(item)}<br>Đơn giá: ${money(cartItemCheckoutPrice(item))}${item.note?'<br>'+item.note:''}</small></div><div class="summary-price">${money(cartItemLineTotal(item))}</div></div>`).join('');}
  document.getElementById('orderItemsField').value=orderItemsText();
  const orderQuantityField=document.getElementById('orderQuantityField');if(orderQuantityField)orderQuantityField.value=orderQuantitySummary();
  renderAvailableVouchers();
  refreshCheckoutTotals();
  backToCheckoutMain();
  document.getElementById('checkoutModal').classList.add('active');
  updateCheckoutSubmitText();
}
function closeCheckout(){document.getElementById('checkoutModal').classList.remove('active');backToCheckoutMain();}
function updateCheckoutSubmitText(){
  const method=document.getElementById('paymentMethod')?.value||'COD';
  const btn=document.getElementById('submitOrderBtn');
  if(btn)btn.textContent=method==='QR'?'Tiếp tục quét mã':'Xác nhận đặt hàng';
}
function selectPayment(method){
  document.getElementById('paymentMethod').value=method;updateCheckoutSubmitText();
  document.getElementById('payCOD').classList.toggle('active',method==='COD');
  document.getElementById('payQR').classList.toggle('active',method==='QR');
  document.getElementById('qrBox').classList.toggle('active',method==='QR');
}

function updateBankConfirmButtonState(){
  const checkbox=document.getElementById('qrConfirmCheck');
  const btn=document.getElementById('confirmBankTransferBtn');
  if(btn)btn.disabled=!(checkbox&&checkbox.checked);
}

function customerTransferName(){
  const name=document.querySelector('#checkoutForm input[name="name"]')?.value.trim()||'';
  return name || 'Họ và tên';
}
function updateTransferContentFields(){
  const name=customerTransferName();
  const transferField=document.getElementById('transferContentField');
  if(transferField)transferField.value=name;
  const qrName=document.getElementById('qrTransferName');
  if(qrName)qrName.textContent=name;
}
function startCheckoutCountdown(){
  const el=document.getElementById('checkoutCountdown');
  if(checkoutQrTimer)clearInterval(checkoutQrTimer);
  checkoutQrDeadline=Date.now()+10*60*1000;
  const tick=()=>{
    const left=Math.max(0, checkoutQrDeadline-Date.now());
    const m=String(Math.floor(left/60000)).padStart(2,'0');
    const s=String(Math.floor((left%60000)/1000)).padStart(2,'0');
    if(el)el.textContent=`${m}:${s}`;
    if(left<=0){
      clearInterval(checkoutQrTimer);
      checkoutQrTimer=null;
      if(el)el.textContent='00:00';
    }
  };
  tick();
  checkoutQrTimer=setInterval(tick,1000);
}
function showCheckoutQrStep(){
  updateTransferContentFields();
  refreshCheckoutTotals();
  const total=document.getElementById('checkoutTotal')?.textContent||'0 ₫';
  const qrTotal=document.getElementById('qrStepTotal');
  if(qrTotal)qrTotal.textContent=total;
  const main=document.getElementById('checkoutMainStep');
  const qr=document.getElementById('checkoutQrStep');
  const card=document.querySelector('.checkout-card');
  if(card)card.classList.add('qr-mode');
  if(main)main.classList.add('is-hidden');
  if(qr)qr.classList.add('active');
  const checkbox=document.getElementById('qrConfirmCheck'); if(checkbox) checkbox.checked=false;
  updateBankConfirmButtonState();
  startCheckoutCountdown();
}
function backToCheckoutMain(){
  const main=document.getElementById('checkoutMainStep');
  const qr=document.getElementById('checkoutQrStep');
  const card=document.querySelector('.checkout-card');
  if(card)card.classList.remove('qr-mode');
  if(qr)qr.classList.remove('active');
  if(main)main.classList.remove('is-hidden');
  if(checkoutQrTimer){clearInterval(checkoutQrTimer);checkoutQrTimer=null;}
  const checkbox=document.getElementById('qrConfirmCheck'); if(checkbox) checkbox.checked=false;
  updateBankConfirmButtonState();
}
async function sendCheckoutForm(){
  const btn=document.getElementById('submitOrderBtn');
  const bankBtn=document.getElementById('confirmBankTransferBtn');
  const form=document.getElementById('checkoutForm');
  if(!form)return false;

  updateCheckoutAddressField();
  updateTransferContentFields();
  refreshCheckoutTotals();

  const submittedMethod=document.getElementById('paymentMethod')?.value||'COD';
  const total=document.getElementById('checkoutTotal')?.textContent||'';
  const name=form.querySelector('[name="name"]')?.value?.trim()||'';
  const phone=form.querySelector('[name="phone"]')?.value?.trim()||'';
  const emailInput=form.querySelector('[name="email"]');
  const customerEmail=emailInput?.value?.trim()||'';
  const province=document.getElementById('checkoutProvince')?.value||'';
  const district=document.getElementById('checkoutDistrict')?.value||'';
  const ward=document.getElementById('checkoutWard')?.value||'';
  const street=document.getElementById('checkoutStreet')?.value||'';
  const address=document.getElementById('checkoutAddressHidden')?.value||[street,ward,district,province].filter(Boolean).join(', ');
  const quantitySummary=orderQuantitySummary();
  const itemsText=orderItemsText();
  const internalRefs=orderInternalRefsText();
  const submittedAt=new Date().toLocaleString('vi-VN');

  if(!name || !phone || !address){
    showOrderError('Bạn vui lòng nhập đủ họ tên, số điện thoại và địa chỉ trước khi gửi đơn.');
    if(btn){btn.disabled=false;updateCheckoutSubmitText();}
    if(bankBtn){bankBtn.disabled=false;updateBankConfirmButtonState();}
    return false;
  }

  const orderNote=[
    document.getElementById('voucherCodeField')?.value?`Voucher: ${document.getElementById('voucherCodeField')?.value}`:'',
    document.getElementById('shippingVoucherField')?.value?`Voucher ship: ${document.getElementById('shippingVoucherField')?.value}`:'',
    document.getElementById('discountAmountField')?.value?`Giảm giá: ${document.getElementById('discountAmountField')?.value}`:''
  ].filter(Boolean).join(' | ') || 'Không có';

  const message=compactText([
    'ĐƠN HÀNG TAKUMI STUDIO',
    `Thời gian gửi: ${submittedAt}`,
    '',
    '1. KHÁCH HÀNG',
    `Họ tên: ${name}`,
    `SĐT/Zalo: ${phone}`,
    `Email: ${customerEmail || 'Khách không nhập'}`,
    `Địa chỉ: ${address}`,
    '',
    '2. SẢN PHẨM KHÁCH ĐÃ CHỌN',
    itemsText || '(Không có dữ liệu sản phẩm)',
    '',
    '3. THANH TOÁN',
    `Phương thức: ${submittedMethod==='QR'?'Chuyển khoản / Banking QR':'COD - thanh toán khi nhận hàng'}`,
    `${quantitySummary}`,
    `Tổng thanh toán: ${total}`,
    `Nội dung chuyển khoản: ${customerTransferName()}`,
    `Ưu đãi: ${orderNote}`,
    '',
    '4. GHI CHÚ NỘI BỘ',
    internalRefs || '(Không có ID sản phẩm)',
    `Trang gửi đơn: ${location.href}`
  ].join('\n'), 6000);

  // Tạo form tối giản giống file test đã nhận mail.
  // Không gửi base64 ảnh / quá nhiều field để tránh Formspree từ chối vì payload quá lớn.
  // Gửi vào iframe ẩn để khách không bị chuyển sang trang Formspree.
  let hiddenFrame=document.getElementById('takumiFormspreeNativeFrame');
  if(!hiddenFrame){
    hiddenFrame=document.createElement('iframe');
    hiddenFrame.name='takumiFormspreeNativeFrame';
    hiddenFrame.id='takumiFormspreeNativeFrame';
    hiddenFrame.title='Formspree hidden submit';
    hiddenFrame.style.cssText='display:none;width:0;height:0;border:0;visibility:hidden';
    document.body.appendChild(hiddenFrame);
  }
  const postForm=document.createElement('form');
  postForm.action='https://formspree.io/f/xaqykqap';
  postForm.method='POST';
  postForm.target='takumiFormspreeNativeFrame';
  postForm.style.cssText='position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;';

  const add=(name,value)=>{
    const input=document.createElement('input');
    input.type='hidden';
    input.name=name;
    input.value=value==null?'':String(value);
    postForm.appendChild(input);
  };

  add('_subject', `${submittedMethod==='QR'?'Đơn Banking QR':'Đơn COD'} - ${name} - ${phone}`);
  add('name', name);
  add('email', customerEmail || 'takumistudiovn@gmail.com');
  add('phone', phone);
  add('order_total', total);
  add('message', message);

  document.body.appendChild(postForm);

  try{
    postForm.submit();
    setTimeout(()=>{
      try{postForm.remove();}catch(_){ }
      cart=[];
      activeCheckoutVoucher=null;
      activeShippingVoucher=null;
      updateCart();
      closeCheckout();
      form.reset();
      resetCheckoutAddressFields();
      initCheckoutAddressAutocomplete();
      selectPayment('COD');
      backToCheckoutMain();
      showOrderSuccess(submittedMethod);
      showTakumiToast('Đã gửi đơn hàng', 'Takumi Studio đã nhận thông tin. Shop sẽ liên hệ xác nhận sớm.');
      if(btn){btn.disabled=false;updateCheckoutSubmitText();}
      if(bankBtn){bankBtn.disabled=false;updateBankConfirmButtonState();}
    },1000);
    return true;
  }catch(err){
    console.warn('Formspree minimal native submit error:',err);
    showOrderError('Chưa gửi được đơn. Bạn vui lòng thử lại hoặc nhắn Zalo shop để đặt hàng.');
    if(btn){btn.disabled=false;updateCheckoutSubmitText();}
    if(bankBtn){bankBtn.disabled=false;updateBankConfirmButtonState();}
    return false;
  }
}

async function submitBankTransferOrder(){
  const checkbox=document.getElementById('qrConfirmCheck');
  if(checkbox && !checkbox.checked){alert('Bạn vui lòng xác nhận đã chuyển khoản trước khi gửi đơn.');return;}
  const bankBtn=document.getElementById('confirmBankTransferBtn');
  if(bankBtn){bankBtn.textContent='Đang gửi xác nhận...';}
  await sendCheckoutForm();
  if(bankBtn){bankBtn.innerHTML='<i class="fa-solid fa-paper-plane"></i> Gửi xác nhận đơn hàng';}
}

async function submitOrder(e){
  e.preventDefault();
  updateCheckoutAddressField();
  updateTransferContentFields();
  const method=document.getElementById('paymentMethod')?.value||'COD';
  if(method==='QR'){
    showCheckoutQrStep();
    return;
  }
  const btn=document.getElementById('submitOrderBtn');
  if(btn){btn.textContent='Đang gửi đơn...';btn.disabled=true;}
  showTakumiToast('Đang gửi đơn hàng', 'Đơn đang được gửi về Takumi Studio.');
  await sendCheckoutForm();
}

/* === Admin Product Manager JS === */
let adminPreviewColorIndex=0;

function loadStoredProducts(){
  /* Website khách dùng GitHub/takumi-data.json làm nguồn chính.
     Không đọc takumi_products cũ trong localStorage để tránh sản phẩm đã xóa bị kéo lại. */
  try{localStorage.removeItem('takumi_products');localStorage.removeItem('takumi_deleted_product_ids');}catch(e){}
  return JSON.parse(JSON.stringify(defaultProducts));
}
function persistProducts(){
  try{
    localStorage.removeItem('takumi_products');
    localStorage.setItem('takumi_products',JSON.stringify(products||[]));
    return true;
  }catch(e){
    console.error('Không lưu được dữ liệu sản phẩm:',e);
    alert('Trình duyệt chưa lưu được thay đổi sản phẩm. Nguyên nhân thường là dữ liệu ảnh trong admin quá nặng. Mình đã xóa trên giao diện hiện tại, nhưng để lưu lâu dài bạn nên bấm “Tải file HTML” hoặc giảm dung lượng ảnh rồi thử lại.');
    return false;
  }
}
function adminSafeColorHex(hex){
  return /^#[0-9A-Fa-f]{6}$/.test(hex||'')?hex:'#F4F1EA';
}
function adminColorClass(hex,name){
  const h=adminSafeColorHex(hex).toLowerCase();
  if(/đen|black/i.test(name||'')||h==='#252525'||h==='#000000')return 'color-black';
  if(/vàng|gold/i.test(name||'')||h==='#c6a65c')return 'color-gold';
  if(/xám|gray|grey/i.test(name||'')||h==='#a7a59e')return 'color-gray';
  if(/trắng|white/i.test(name||''))return 'color-white';
  return 'color-white';
}
function adminDefaultColorRows(){
  return [
    {name:'Trắng đá',hex:'#F4F1EA'},
    {name:'Xám đá',hex:'#A7A59E'},
    {name:'Vàng cổ',hex:'#C6A65C'}
  ];
}

function adminDefaultCategories(){
  return [
    {id:'buddha',name:'Tượng Phật'},
    {id:'decor',name:'Decor'},
    {id:'figure',name:'Chibi/Figure'}
  ];
}
function adminSlugify(str){
  return String(str||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'')||'danh-muc-moi';
}
function getCategories(){
  try{
    const saved=localStorage.getItem('takumi_categories');
    if(saved){
      const parsed=JSON.parse(saved);
      if(Array.isArray(parsed)&&parsed.length)return parsed;
    }
  }catch(e){}
  const fromProducts=[...new Set((products||[]).map(p=>p.type).filter(Boolean))];
  const defaults=adminDefaultCategories();
  const merged=[...defaults];
  fromProducts.forEach(id=>{
    if(!merged.some(c=>c.id===id))merged.push({id,name:id});
  });
  return merged;
}
function persistCategories(list){
  localStorage.setItem('takumi_categories',JSON.stringify(list));
}
function categoryLabel(id){
  const found=getCategories().find(c=>c.id===id);
  return found?found.name:(id==='buddha'?'Tượng Phật':id==='decor'?'Decor':id==='figure'?'Chibi/Figure':id||'Danh mục');
}
function renderCategoryOptions(selected){
  const select=document.getElementById('adminType');
  if(!select)return;
  const cats=getCategories();
  select.innerHTML=cats.map(c=>`<option value="${escapeAttr(c.id)}">${escapeAttr(c.name)}</option>`).join('');
  select.value=selected&&cats.some(c=>c.id===selected)?selected:(cats[0]?.id||'buddha');
}
function renderFilterOptions(){
  const filterRow=document.getElementById('filterRow');
  if(!filterRow)return;
  const cats=getCategories();
  const current=activeFilter;
  const base=[['all','Tất cả'],...cats.map(c=>[c.id,c.name]),['hot','Được chọn nhiều'],['custom','Nhận custom']];
  filterRow.innerHTML=base.map(f=>`<button class="filter-btn ${f[0]===current?'active':''}" onclick="setFilter('${escapeAttr(f[0])}',this)">${escapeAttr(f[1])}</button>`).join('');
}
function adminCategoriesFromRows(){
  const rows=[...document.querySelectorAll('.admin-category-row')];
  const used=new Set();
  const list=rows.map(row=>{
    const id=adminSlugify(row.querySelector('.admin-category-id').value.trim()||row.querySelector('.admin-category-name').value.trim());
    const name=row.querySelector('.admin-category-name').value.trim()||id;
    if(used.has(id))return null;
    used.add(id);
    return {id,name};
  }).filter(Boolean);
  return list.length?list:adminDefaultCategories();
}
function adminRenderCategoryRows(){
  const box=document.getElementById('adminCategoryList');
  if(!box)return;
  const cats=getCategories();
  box.innerHTML=cats.map(c=>`<div class="admin-category-row">
    <div>
      <small>Tên danh mục</small>
      <input class="admin-category-name" type="text" value="${escapeAttr(c.name)}" placeholder="Ví dụ: Tượng Phật" oninput="adminSuggestCategoryId(this)">
    </div>
    <div>
      <small>Mã danh mục</small>
      <input class="admin-category-id" type="text" value="${escapeAttr(c.id)}" placeholder="tuong-phat">
    </div>
    <button class="admin-mini-btn danger" type="button" onclick="adminRemoveCategoryRow(this)">Xóa</button>
  </div>`).join('');
}
function adminSuggestCategoryId(input){
  const row=input.closest('.admin-category-row');
  const idInput=row.querySelector('.admin-category-id');
  if(!idInput.dataset.touched){
    idInput.value=adminSlugify(input.value);
  }
}
function adminAddCategoryRow(){
  const cats=adminCategoriesFromRows();
  cats.push({id:'danh-muc-moi',name:'Danh mục mới'});
  persistCategories(cats);
  adminRenderCategoryRows();
  renderCategoryOptions(document.getElementById('adminType')?.value);
  renderFilterOptions();
}
function adminRemoveCategoryRow(btn){
  const rows=document.querySelectorAll('.admin-category-row');
  if(rows.length<=1){alert('Cần giữ ít nhất 1 danh mục.');return;}
  btn.closest('.admin-category-row').remove();
  const cats=adminCategoriesFromRows();
  persistCategories(cats);
  renderCategoryOptions(document.getElementById('adminType')?.value);
  renderFilterOptions();
}
function adminSaveCategories(){
  const currentType=document.getElementById('adminType')?.value;
  const cats=adminCategoriesFromRows();
  persistCategories(cats);
  renderCategoryOptions(currentType);
  renderFilterOptions();
}
function adminResetCategories(){
  if(!confirm('Khôi phục danh mục mặc định?'))return;
  persistCategories(adminDefaultCategories());
  adminRenderCategoryRows();
  renderCategoryOptions(document.getElementById('adminType')?.value);
  renderFilterOptions();
}
function normalizeProducts(){
  products.forEach(p=>{
    p.colors=p.colors&&p.colors.length?p.colors:colors;
    p.galleryImages=p.galleryImages&&p.galleryImages.length?p.galleryImages:[p.img];
    p.colorImages=p.colorImages||{'Trắng đá':p.img,'Xám đá':p.img,'Vàng cổ':p.img,'Đen nhám':p.img};
    p.colors=p.colors.map(c=>({...c,hex:c.hex||'#F4F1EA',cls:c.cls||adminColorClass(c.hex,c.name),image:(p.colorImages&&p.colorImages[c.name])||c.image||p.img||''}));
    p.selectedColor=p.colors[0];
  });
}
function refreshStorefront(){
  normalizeProducts();

  // Nếu đang mở popup sản phẩm, đồng bộ lại currentProduct theo dữ liệu mới trong admin
  if(currentProduct){
    const updated=products.find(p=>Number(p.id)===Number(currentProduct.id));
    if(updated)currentProduct=updated;
  }

  renderFeatured();
  renderProducts();
  updateFlashSaleStrip();

  // Nếu popup chi tiết đang mở thì cập nhật lại giá/ảnh/tên ngay, không cần reload trang
  if(document.getElementById('productModal')?.classList.contains('active') && currentProduct){
    updateModal();
  }

  // Cập nhật lại giỏ hàng/checkout/voucher nếu đang mở
  updateCart();
  try{renderAvailableVouchers();refreshCheckoutTotals();}catch(e){}

  if(document.getElementById('adminWorkspace')?.style.display!=='none'){
    renderAdminProducts();
    adminRenderPromos();
  }
}
function openAdmin(){
  document.getElementById('adminModal').classList.add('active');
  document.body.style.overflow='hidden';
  if(sessionStorage.getItem('takumi_admin_ok')==='1')showAdminWorkspace();
}
function closeAdmin(){
  document.getElementById('adminModal').classList.remove('active');
  document.body.style.overflow='';
}
function adminLogin(){
  const pass=document.getElementById('adminPassword').value.trim();
  if(pass==='takumi123'){
    sessionStorage.setItem('takumi_admin_ok','1');
    showAdminWorkspace();
  }else{
    alert('Mật khẩu chưa đúng.');
  }
}
function showAdminWorkspace(){
  document.getElementById('adminLoginBox').style.display='none';
  document.getElementById('adminWorkspace').style.display='grid';
  loadStoredPromos();
  adminRenderCategoryRows();
  renderCategoryOptions(document.getElementById('adminType')?.value);
  renderAdminProducts();
  adminRenderPromos();
  if(!document.getElementById('adminId').value){
    const first=products[0];
    if(first)adminEditProduct(first.id);else adminNewProduct();
  }
}
function typeLabel(t){return categoryLabel(t)}
let adminProductListMode='card';
function adminNormalizeText(str){
  return String(str||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d');
}
function syncAdminProductFilterOptions(){
  const select=document.getElementById('adminProductCategoryFilter');
  if(!select)return;
  const current=select.value||'all';
  const cats=getCategories();
  select.innerHTML='<option value="all">Tất cả danh mục</option>'+cats.map(c=>`<option value="${escapeAttr(c.id)}">${escapeAttr(c.name)}</option>`).join('')+'<option value="hot">Được chọn nhiều</option><option value="custom">Nhận custom</option>';
  select.value=[...select.options].some(o=>o.value===current)?current:'all';
}
function setAdminListMode(mode){
  adminProductListMode=mode==='list'?'list':'card';
  document.getElementById('adminModeCard')?.classList.toggle('active',adminProductListMode==='card');
  document.getElementById('adminModeList')?.classList.toggle('active',adminProductListMode==='list');
  renderAdminProducts();
}
function clearAdminProductFilters(){
  const q=document.getElementById('adminProductSearch');
  const cat=document.getElementById('adminProductCategoryFilter');
  const sort=document.getElementById('adminProductSort');
  if(q)q.value='';
  if(cat)cat.value='all';
  if(sort)sort.value='newest';
  renderAdminProducts();
}
function getAdminFilteredProducts(){
  const keyword=adminNormalizeText(document.getElementById('adminProductSearch')?.value||'').trim();
  const cat=document.getElementById('adminProductCategoryFilter')?.value||'all';
  const sort=document.getElementById('adminProductSort')?.value||'newest';
  let list=[...products];
  if(cat!=='all'){
    if(cat==='hot'||cat==='custom')list=list.filter(p=>p.filter===cat);
    else list=list.filter(p=>p.type===cat);
  }
  if(keyword){
    list=list.filter(p=>{
      const hay=[p.name,p.short,p.desc,typeLabel(p.type),p.filter,(p.colors||[]).map(c=>c.name).join(' '),money(Number(p.price||0))].join(' ');
      return adminNormalizeText(hay).includes(keyword);
    });
  }
  list.sort((a,b)=>{
    if(sort==='name')return String(a.name||'').localeCompare(String(b.name||''),'vi');
    if(sort==='price-asc')return Number(a.price||0)-Number(b.price||0);
    if(sort==='price-desc')return Number(b.price||0)-Number(a.price||0);
    return Number(b.id||0)-Number(a.id||0);
  });
  return list;
}
function renderAdminProducts(){
  const box=document.getElementById('adminProductList');
  if(!box)return;
  syncAdminProductFilterOptions();
  const selectedId=String(document.getElementById('adminId')?.value||'');
  const list=getAdminFilteredProducts();
  document.getElementById('adminCount').textContent=products.length+' sản phẩm';
  const result=document.getElementById('adminListResult');
  if(result)result.textContent=`Hiển thị ${list.length}/${products.length} sản phẩm`;
  box.classList.toggle('list-mode',adminProductListMode==='list');
  if(!list.length){
    box.innerHTML=`<div class="admin-list-empty"><i class="fa-solid fa-magnifying-glass"></i>Không tìm thấy sản phẩm phù hợp.<br>Hãy thử xóa lọc hoặc nhập từ khóa khác.</div>`;
    return;
  }
  box.innerHTML=list.map(p=>{
    const colors=(p.colors||[]).map(c=>c.name).join(' · ');
    const rowClass=adminProductListMode==='list'?'admin-product-row compact':'admin-product-row';
    const shortMeta=`${typeLabel(p.type)} · Từ ${money(Number(p.price||0))}${p.filter==='hot'?' · Được chọn nhiều':''}${p.filter==='custom'?' · Custom':''}`;
    const image=(p.galleryImages&&p.galleryImages[0])||p.img;
    const idArg=takumiIdArg(p.id);
    return `<div class="${rowClass} ${takumiSameId(p.id,selectedId)?'active':''}" onclick='adminEditProduct(${idArg})'>
      <img src="${escapeAttr(image)}" alt="${escapeAttr(p.name)}">
      <div><b>${escapeAttr(p.name)}</b><small>${escapeAttr(shortMeta)}<br>${escapeAttr(colors||'Chưa có màu')}</small></div>
      <div class="admin-row-actions">
        <button type="button" class="admin-mini-btn" onclick='event.preventDefault();event.stopPropagation();adminEditProduct(${idArg});document.getElementById("adminProductForm")?.scrollIntoView({behavior:"smooth",block:"start"})'><i class="fa-solid fa-pen"></i> Sửa</button>
        <button type="button" class="admin-mini-btn danger" onclick='event.preventDefault();event.stopPropagation();adminDeleteProduct(${idArg})'><i class="fa-solid fa-trash"></i> Xóa</button>
      </div>
    </div>`;
  }).join('');
}
function escapeAttr(str){
  return String(str||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function adminCompressImageFile(file,callback){
  if(!file)return;
  if(!file.type.startsWith('image/')){alert('Bạn hãy chọn file ảnh JPG/PNG/WebP.');return;}
  const reader=new FileReader();
  reader.onload=()=>{
    const img=new Image();
    img.onload=()=>{
      const max=1200;
      let w=img.width,h=img.height;
      if(w>max||h>max){
        if(w>h){h=Math.round(h*max/w);w=max}else{w=Math.round(w*max/h);h=max}
      }
      const canvas=document.createElement('canvas');
      canvas.width=w;canvas.height=h;
      const ctx=canvas.getContext('2d');
      ctx.drawImage(img,0,0,w,h);
      callback(canvas.toDataURL('image/jpeg',0.86));
    };
    img.src=reader.result;
  };
  reader.readAsDataURL(file);
}
function adminGalleryFromRows(){
  return [...document.querySelectorAll('.admin-gallery-row')].map(row=>(row.querySelector('.admin-gallery-image')?.value||'').trim()).filter(Boolean);
}
function adminRenderGalleryRows(list){
  const box=document.getElementById('adminGalleryList');
  if(!box)return;
  const fallback=(document.getElementById('adminImg')?.value||'').trim()||'https://iili.io/Cdj4yS1.jpg';
  const gallery=(list&&list.length?list:[fallback]).filter(Boolean);
  box.innerHTML=gallery.map((src,i)=>`<div class="admin-gallery-row" data-index="${i}">
    <input class="admin-gallery-image" type="text" value="${escapeAttr(src)}" placeholder="Link ảnh minh họa hoặc tải ảnh" oninput="adminPreviewGalleryImage(this);adminUpdateLivePreview()">
    <label class="admin-file-button"><input type="file" accept="image/*" onchange="adminUploadGalleryImage(event,this)"> Tải ảnh</label>
    <div class="admin-gallery-thumb"><img src="${escapeAttr(src||fallback)}" alt="Ảnh minh họa"></div>
    <button class="admin-mini-btn danger" type="button" onclick="adminRemoveGalleryRow(this)">Xóa</button>
  </div>`).join('');
}
function adminPreviewGalleryImage(input){
  const img=input.closest('.admin-gallery-row').querySelector('.admin-gallery-thumb img');
  const fallback=(document.getElementById('adminImg')?.value||'').trim()||'https://iili.io/Cdj4yS1.jpg';
  img.src=input.value.trim()||fallback;
}
function adminAddGalleryRow(){
  const current=adminGalleryFromRows();
  current.push((document.getElementById('adminImg')?.value||'').trim()||'https://iili.io/Cdj4yS1.jpg');
  adminRenderGalleryRows(current);
  adminUpdateLivePreview();
}
function adminRemoveGalleryRow(btn){
  const rows=document.querySelectorAll('.admin-gallery-row');
  if(rows.length<=1){alert('Cần giữ ít nhất 1 ảnh minh họa.');return;}
  btn.closest('.admin-gallery-row').remove();
  adminUpdateLivePreview();
}
function adminUploadGalleryImage(event,inputEl){
  const file=event.target.files&&event.target.files[0];
  if(!file)return;
  adminCompressImageFile(file,(data)=>{
    const row=event.target.closest('.admin-gallery-row');
    row.querySelector('.admin-gallery-image').value=data;
    row.querySelector('.admin-gallery-thumb img').src=data;
    adminUpdateLivePreview();
  });
}
function adminUploadGalleryBulk(event){
  const files=[...(event.target.files||[])].filter(file=>file.type&&file.type.startsWith('image/'));
  if(!files.length){alert('Bạn hãy chọn các file ảnh JPG/PNG/WebP.');return;}
  const current=adminGalleryFromRows().filter(Boolean);
  const shouldReplace=current.length===1 && /iili\.io\/Cdj4yS1|^$/.test(current[0]||'');
  const uploaded=[];
  let done=0;
  files.forEach(file=>{
    adminCompressImageFile(file,(data)=>{
      uploaded.push(data);
      done++;
      if(done===files.length){
        const next=shouldReplace?uploaded:[...current,...uploaded];
        adminRenderGalleryRows(next);
        if(next[0])document.getElementById('adminImg').value=next[0];
        adminUpdateLivePreview();
        event.target.value='';
      }
    });
  });
}
function adminColorObjectsFromRows(){
  const rows=[...document.querySelectorAll('.admin-color-row')];
  const result=rows.map(row=>{
    const name=row.querySelector('.admin-color-name').value.trim();
    const hex=adminSafeColorHex(row.querySelector('.admin-color-picker').value);
    const image=(row.querySelector('.admin-color-image')?.value||'').trim();
    return name?{name,hex,image,cls:adminColorClass(hex,name)}:null;
  }).filter(Boolean);
  return result.length?result:adminDefaultColorRows().map(c=>({...c,image:'',cls:adminColorClass(c.hex,c.name)}));
}
function adminRenderColorRows(colorList){
  const box=document.getElementById('adminColorList');
  const fallbackImg=(document.getElementById('adminImg')?.value||'').trim()||'https://iili.io/Cdj4yS1.jpg';
  const list=(colorList&&colorList.length?colorList:adminDefaultColorRows()).map(c=>({
    name:c.name||'Màu mới',
    hex:adminSafeColorHex(c.hex||'#F4F1EA'),
    image:(c.image||c.img||fallbackImg||'').trim()
  }));
  box.innerHTML=list.map((c,i)=>`<div class="admin-color-row" data-index="${i}">
    <div>
      <div class="admin-color-label-mini">Tên màu</div>
      <input class="admin-color-name" type="text" value="${escapeAttr(c.name)}" placeholder="Ví dụ: Trắng đá" oninput="adminUpdateLivePreview()">
    </div>
    <div>
      <div class="admin-color-label-mini">Bảng màu</div>
      <div class="admin-color-picker-wrap">
        <input class="admin-color-picker" type="color" value="${adminSafeColorHex(c.hex)}" oninput="adminSyncColorHex(this);adminUpdateLivePreview()">
        <span class="admin-color-hex">${adminSafeColorHex(c.hex)}</span>
      </div>
    </div>
    <div>
      <div class="admin-color-label-mini">Ảnh riêng khi chọn màu này</div>
      <div class="admin-color-image-tools">
        <input class="admin-color-image" type="text" value="${escapeAttr(c.image)}" placeholder="Link ảnh hoặc tải ảnh riêng cho màu này" oninput="adminPreviewColorImage(this);adminUpdateLivePreview()">
        <label class="admin-color-upload">Tải ảnh màu<input type="file" accept="image/*" onchange="adminUploadColorImage(event,this)"></label>
        <div class="admin-color-thumb"><img src="${escapeAttr(c.image||fallbackImg)}" alt="Ảnh màu"></div>
      </div>
    </div>
    <button class="admin-mini-btn danger" type="button" onclick="adminRemoveColorRow(this)">Xóa</button>
  </div>`).join('');
  adminPreviewColorIndex=0;
  adminUpdateLivePreview();
}
function adminSyncColorHex(input){
  const label=input.closest('.admin-color-picker-wrap').querySelector('.admin-color-hex');
  label.textContent=input.value.toUpperCase();
}
function adminPreviewColorImage(input){
  const img=input.closest('.admin-color-image-tools').querySelector('.admin-color-thumb img');
  const fallback=(document.getElementById('adminImg')?.value||'').trim()||'https://iili.io/Cdj4yS1.jpg';
