function adminRemoveBaseSale(id){
  const p=takumiProductById(id);
  if(!p)return;
  if(confirm(`Xóa giảm giá gốc của "${p.name}"? Giá gốc sẽ được đặt về 0, sản phẩm chỉ còn giá bán hiện tại.`)){
    p.old=0;
    p.sale=0;
    persistProducts();
    refreshStorefront();
    adminEditProduct(id);
  }
}

function adminRenderPromos(){
  const vbox=document.getElementById('adminVoucherList');
  if(vbox){
    const manual=vouchers||[];
    const baseSales=productBaseVoucherList();
    const list=[...baseSales,...manual];
    const manualHtml=manual.length?manual.map(adminVoucherItemHtml).join(''):'';
    const baseHtml=baseSales.length?baseSales.map(adminBaseSaleItemHtml).join(''):'';
    vbox.innerHTML=adminPromoOverviewHtml(list,'voucher')+(list.length?baseHtml+manualHtml:'<div class="admin-program-empty">Chưa có voucher hoặc chương trình dịp đặc biệt.<br>Tạo mã ở tab “Voucher / Dịp đặc biệt” hoặc nhập Giá gốc lớn hơn Giá ưu đãi trong sản phẩm.</div>');
  }
  const fbox=document.getElementById('adminFlashList');
  if(fbox){
    const list=flashSales||[];
    fbox.innerHTML=adminPromoOverviewHtml(list,'flash')+(list.length?list.map(adminFlashItemHtml).join(''):'<div class="admin-program-empty">Chưa có flash sale.<br>Tạo chương trình ở tab “Flash sale”.</div>');
  }
}

function adminBuildFullHtml(){
  adminSaveCategories();
  persistProducts();
  let html='<!DOCTYPE html>\n'+document.documentElement.outerHTML;
  const data=JSON.stringify(products,null,2).replace(/</g,'\\u003c');
  const categoryData=JSON.stringify(getCategories(),null,2).replace(/</g,'\\u003c');
  const voucherData=JSON.stringify(vouchers||[],null,2).replace(/</g,'\\u003c');
  const flashData=JSON.stringify(flashSales||[],null,2).replace(/</g,'\\u003c');
  const productBoot=`const defaultProducts=${data};\nlet products=JSON.parse(JSON.stringify(defaultProducts));\ntry{localStorage.setItem('takumi_products',JSON.stringify(defaultProducts));localStorage.removeItem('takumi_deleted_product_ids');localStorage.setItem('takumi_categories',JSON.stringify(${categoryData}));localStorage.setItem('takumi_vouchers',JSON.stringify(${voucherData}));localStorage.setItem('takumi_flashSales',JSON.stringify(${flashData}));}catch(e){}`;
  const productBootRegex=/const defaultProducts=\[[\s\S]*?\];\s*let products=[\s\S]*?;\s*(?:try\{localStorage\.setItem\('takumi_products'[\s\S]*?\}\s*catch\(e\)\{\}\s*)?/;
  const replaced=html.replace(productBootRegex,productBoot);
  if(replaced===html){alert('Chưa thể nhúng dữ liệu sản phẩm vào file xuất. Bạn hãy báo lại để mình chỉnh phần xuất HTML.');}
  html=replaced;
  html=html.replace(/let vouchers=\[[\s\S]*?\];/, 'let vouchers='+voucherData+';');
  html=html.replace(/let flashSales=\[[\s\S]*?\];/, 'let flashSales='+flashData+';');
  return html;
}
