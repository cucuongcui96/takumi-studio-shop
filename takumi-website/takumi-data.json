function adminFillVoucherForm(code){
  const v=(vouchers||[]).find(x=>String(x.code).toUpperCase()===String(code).toUpperCase());
  if(!v)return;
  adminSwitchPromoTab('voucher');
  document.getElementById('adminVoucherCampaign').value=v.campaign||'';
