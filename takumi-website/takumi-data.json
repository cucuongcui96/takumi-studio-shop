  document.getElementById('adminVoucherType').value=v.type||'percent';
  document.getElementById('adminVoucherValue').value=v.value||'';
  document.getElementById('adminVoucherScope').value=v.scope||'all';
  document.getElementById('adminVoucherMinSpend').value=v.minSpend||'';
  document.getElementById('adminVoucherNote').value=v.note||'';
  document.getElementById('adminVoucherStart').value=v.start||'';
  document.getElementById('adminVoucherEnd').value=v.end||'';
  adminSyncVoucherTypeUI();
}
function adminFillFlashForm(id){
  const f=(flashSales||[]).find(x=>Number(x.id)===Number(id));
  if(!f)return;
  adminSwitchPromoTab('flash');
  document.getElementById('adminFlashTitle').value=f.title||'';
  document.getElementById('adminFlashTitle').dataset.editId=f.id||'';
  document.getElementById('adminFlashEnabled').value=flashEnabled(f)?'true':'false';
  document.getElementById('adminFlashType').value=flashType(f);
  document.getElementById('adminFlashValue').value=flashValue(f)||'';
  document.getElementById('adminFlashScope').value=f.scope||'all';
  document.getElementById('adminFlashStart').value=f.start||'';
  document.getElementById('adminFlashEnd').value=f.end||'';
  adminSyncFlashTypeUI();
}
function adminDeleteVoucher(code){
  const v=(vouchers||[]).find(x=>String(x.code).toUpperCase()===String(code).toUpperCase());
  const label=v?`mã ${v.code}`:'voucher này';
  if(confirm(`Xóa ${label}?`)){
    const deletedCode=String(code||'').toUpperCase();
    vouchers=vouchers.filter(v=>String(v.code).toUpperCase()!==deletedCode);
    if(activeVoucher&&String(activeVoucher.code||'').toUpperCase()===deletedCode)activeVoucher=null;
    if(activeCheckoutVoucher&&String(activeCheckoutVoucher.code||'').toUpperCase()===deletedCode)activeCheckoutVoucher=null;
    const checkoutInput=document.getElementById('checkoutVoucherInput');
    if(checkoutInput&&String(checkoutInput.value||'').toUpperCase()===deletedCode)checkoutInput.value='';
    const checkoutMsg=document.getElementById('checkoutVoucherMessage');
    if(checkoutMsg){checkoutMsg.textContent='';checkoutMsg.className='voucher-message';}
    persistPromos();
    refreshStorefront();
  }
}
function adminSaveFlashSale(){
  const title=document.getElementById('adminFlashTitle').value.trim()||'Flash Sale hôm nay';
  const enabled=document.getElementById('adminFlashEnabled')?.value!=='false';
  const type=document.getElementById('adminFlashType')?.value||'percent';
  const value=Number(document.getElementById('adminFlashValue').value||0);
  const scope=document.getElementById('adminFlashScope').value;
  const productId=adminCurrentProductId();
  if(!value){alert('Bạn nhập giá trị giảm flash sale.');return}
  if(scope==='product'&&!productId){alert('Bạn chọn/sửa một sản phẩm trước khi tạo flash sale riêng cho sản phẩm.');return}
  adminEnsureFlashDefaults(false);
  const existingId=Number(document.getElementById('adminFlashTitle').dataset.editId||0);
  const item={id:existingId||Date.now(),title,enabled,type,value,percent:type==='percent'?value:0,scope,productIds:scope==='product'?[productId]:[],start:document.getElementById('adminFlashStart').value||adminTodayDateTime(0,0),end:document.getElementById('adminFlashEnd').value||adminTodayDateTime(23,59)};
  flashSales=flashSales.filter(f=>Number(f.id)!==Number(item.id));
  flashSales.unshift(item);
  document.getElementById('adminFlashTitle').dataset.editId='';
  persistPromos();refreshStorefront();
  adminSwitchPromoTab('list');
  alert('Đã lưu flash sale.');
}
function adminToggleFlashSale(id){
  const f=(flashSales||[]).find(x=>Number(x.id)===Number(id));
  if(!f)return;
  f.enabled=!flashEnabled(f);
  persistPromos();
  refreshStorefront();
}
function adminDeleteFlashSale(id){
  const f=(flashSales||[]).find(x=>Number(x.id)===Number(id));
  const label=f?`flash sale "${f.title}"`:'flash sale này';
  if(confirm(`Xóa ${label}?`)){
    flashSales=flashSales.filter(f=>Number(f.id)!==Number(id));
    persistPromos();
    refreshStorefront();
  }
}

function productBaseVoucherList(){
  return (products||[]).filter(p=>Number(p.old)>Number(p.price)&&Number(p.price)>0).map(p=>{
    const amount=Number(p.old)-Number(p.price);
    const percent=Math.round(amount/Number(p.old)*100);
    return {
      code:`SALE-${p.id}`,
      campaign:`Giảm giá gốc: ${p.name}`,
      note:`Sản phẩm đang có giá gốc ${money(Number(p.old))}, giá ưu đãi ${money(Number(p.price))}.`,
      type:'fixed',
      value:amount,
      percent,
      scope:'product',
      productIds:[p.id],
      start:'',
      end:'',
      _baseSale:true,
      _product:p
    };
  });
}
function adminBaseSaleItemHtml(v){
  const p=v._product;
  return `<div class="admin-promo-item is-active">
    <div class="admin-promo-item-top">
      <div class="admin-promo-name">
        <b>${escapeAttr(v.campaign)}</b>
        <small>${escapeAttr(v.note)}</small>
      </div>
      <div class="admin-promo-code base-sale"><i class="fa-solid fa-ticket"></i>${escapeAttr(v.code)}</div>
    </div>
    <span class="admin-program-status active"><i class="fa-solid fa-circle"></i>Đang hoạt động</span>
    <div class="admin-promo-meta-grid">
      <div class="admin-promo-meta"><span>Giá trị</span><b>-${money(Number(v.value)||0)} (${v.percent}%)</b></div>
      <div class="admin-promo-meta"><span>Áp dụng</span><b>${escapeAttr(p.name)}</b></div>
      <div class="admin-promo-meta"><span>Thời gian</span><b>Luôn chạy theo giá sản phẩm</b></div>
