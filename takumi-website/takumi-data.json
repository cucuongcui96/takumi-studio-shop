}
function adminAddColorRow(){
  const current=adminColorObjectsFromRows().map(c=>({name:c.name,hex:c.hex,image:c.image}));
  const fallback=(document.getElementById('adminImg')?.value||'').trim()||'https://iili.io/Cdj4yS1.jpg';
  current.push({name:'Màu mới',hex:'#D8C8A8',image:fallback});
