<script>
function takumiScrollFeatured(direction){
  const grid=document.getElementById('featuredGrid');
  if(!grid) return;
  const amount=Math.max(150, Math.round(grid.clientWidth*0.52));
  grid.scrollBy({left: direction*amount, behavior:'smooth'});
}
</script>



