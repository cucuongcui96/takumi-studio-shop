<style>
:root{--bg:#F7F4EE;--paper:#fff;--ink:#2C2A28;--muted:#77726A;--line:#E5E2D9;--soft:#F0F1EA;--soft2:#EEF0E8;--olive:#7A8062;--olive2:#666C52;--red:#B8675D;--radius:14px;--pill:999px;--shadow:0 10px 30px rgba(44,42,40,.055);--body:'Plus Jakarta Sans',sans-serif}
*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}body{font-family:var(--body);background:var(--bg);color:var(--ink);line-height:1.6;font-size:15px;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.028'/%3E%3C/svg%3E");overflow-x:hidden}a{text-decoration:none;color:inherit}button,input,textarea{font-family:inherit}button{border:0}h1,h2,h3{line-height:1.15;font-weight:800;letter-spacing:-.035em}img{max-width:100%;display:block}
.navbar{position:fixed;top:0;left:0;right:0;z-index:1000;display:flex;align-items:center;justify-content:space-between;padding:15px 6%;background:rgba(247,244,238,.92);backdrop-filter:blur(14px);border-bottom:1px solid rgba(44,42,40,.05)}.logo{font-weight:800;font-size:20px;letter-spacing:.8px}.logo span{color:var(--olive)}.nav-links{display:flex;gap:30px;list-style:none}.nav-links a{font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}.nav-links a:hover{color:var(--ink)}.nav-actions{display:flex;gap:18px;align-items:center}.cart-btn{position:relative;cursor:pointer}.cart-count{position:absolute;top:-10px;right:-11px;background:var(--ink);color:#fff;border-radius:50%;font-size:10px;width:18px;height:18px;display:grid;place-items:center;font-weight:800}
section{padding:76px 6%}.eyebrow{color:var(--olive);font-weight:800;text-transform:uppercase;letter-spacing:.16em;font-size:10px;margin-bottom:12px}.btn{border-radius:10px;padding:12px 20px;font-weight:800;cursor:pointer;transition:.25s;display:inline-flex;align-items:center;gap:8px;font-size:13px}.btn-dark{background:var(--ink);color:#fff}.btn-dark:hover{background:var(--olive)}.btn-light{background:rgba(255,255,255,.55);border:1px solid var(--line);color:var(--ink)}.btn-light:hover{border-color:var(--ink);background:#fff}.btn-olive{background:var(--olive);color:#fff}.btn-olive:hover{background:var(--olive2)}
.hero{position:relative;min-height:74vh;display:flex;align-items:center;padding:112px 6% 88px;background:url('https://iili.io/CqsZRmN.png') center right/cover no-repeat;overflow:hidden;isolation:isolate}
.hero::before{content:"";position:absolute;inset:0;background:
linear-gradient(90deg,rgba(247,244,238,.94) 0%,rgba(247,244,238,.90) 20%,rgba(247,244,238,.70) 38%,rgba(247,244,238,.24) 58%,rgba(247,244,238,.05) 74%,rgba(247,244,238,0) 100%);
z-index:0}
.hero::after{content:"";position:absolute;left:0;right:0;bottom:0;height:140px;background:linear-gradient(to bottom,rgba(247,244,238,0) 0%,rgba(247,244,238,.56) 54%,var(--bg) 100%);z-index:0;pointer-events:none}
.hero-content{max-width:680px;position:relative;z-index:2;padding:10px 0}
.hero h1{font-size:clamp(38px,5vw,64px);margin-bottom:20px}
.hero p{font-size:17px;color:#5e584f;margin-bottom:30px;max-width:610px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap}
.hero .btn-light{background:rgba(255,255,255,.70);border:1px solid rgba(229,226,217,.95);backdrop-filter:blur(8px)}
.mini-policy{display:flex;gap:10px;flex-wrap:wrap;margin-top:26px}
.mini-policy span{background:rgba(255,255,255,.66);border:1px solid rgba(229,226,217,.95);backdrop-filter:blur(10px);border-radius:var(--pill);padding:8px 12px;font-size:12px;font-weight:700;color:#5d5a52}
.mini-policy i{color:var(--olive);margin-right:6px}
.hero-visual{display:none}
.section-title{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:30px}.section-title h2{font-size:clamp(28px,3.4vw,42px);margin-top:6px}.section-title p:last-child{color:var(--muted);max-width:520px;font-size:14px}.catalog-toolbar{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:26px}.filter-row{display:flex;gap:8px;flex-wrap:wrap}.filter-btn{padding:8px 12px;border-radius:var(--pill);background:#fff;border:1px solid var(--line);color:var(--muted);font-size:12px;font-weight:700;cursor:pointer}.filter-btn.active,.filter-btn:hover{background:var(--ink);border-color:var(--ink);color:#fff}.search-box{position:relative;min-width:260px}.search-box input{width:100%;border:1px solid var(--line);background:rgba(255,255,255,.75);border-radius:var(--pill);padding:11px 14px 11px 38px;outline:none;font-weight:600;color:var(--ink)}.search-box i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:13px}
.product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:42px 24px}.product-card{background:transparent;cursor:pointer;transition:.25s}.product-card:hover{transform:translateY(-4px)}.product-img{height:360px;background:#E5E2D9;border-radius:var(--radius);overflow:hidden;margin-bottom:16px;position:relative;box-shadow:0 8px 26px rgba(44,42,40,.045)}.product-img img{width:100%;height:100%;object-fit:cover;transition:.5s}.product-card:hover .product-img img{transform:scale(1.045)}.product-img.color-white img{filter:saturate(.96) brightness(1.03)}.product-img.color-gray img{filter:grayscale(.35) contrast(.95) brightness(.92)}.product-img.color-gold img{filter:sepia(.42) saturate(1.12) brightness(1.02)}.product-img.color-black img{filter:grayscale(.7) brightness(.58) contrast(1.08)}
.badge-layer{position:absolute;inset:12px 12px auto 12px;display:flex;justify-content:space-between;gap:8px;z-index:3;pointer-events:none}.badge-left,.badge-right{display:flex;flex-direction:column;gap:7px;align-items:flex-start}.badge-right{align-items:flex-end}.badge{border-radius:var(--pill);padding:6px 10px;font-size:10px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;box-shadow:0 4px 12px rgba(0,0,0,.08);backdrop-filter:blur(10px)}.badge.sale{background:linear-gradient(135deg,#E94735,#C92F24);color:#fff;border:1px solid rgba(255,255,255,.35);box-shadow:0 8px 18px rgba(201,47,36,.28);text-shadow:0 1px 1px rgba(0,0,0,.16)}.badge.ship{background:rgba(255,255,255,.92);border:1px solid rgba(122,128,98,.18);color:#505947}.badge.hot{background:rgba(111,118,88,.94);color:#fff;border:1px solid rgba(255,255,255,.34);box-shadow:0 8px 18px rgba(111,118,88,.20);text-transform:none;letter-spacing:.02em;white-space:nowrap}
.flash-sale-strip{padding:0 6% 28px;margin-top:-24px;position:relative;z-index:3}
.flash-sale-box{display:flex;align-items:center;justify-content:space-between;gap:18px;background:linear-gradient(135deg,#2C2A28,#5E4638);color:#fff;border-radius:20px;padding:18px 20px;box-shadow:0 18px 42px rgba(44,42,40,.16);overflow:hidden;position:relative}
.flash-sale-box::after{content:"";position:absolute;right:-60px;top:-80px;width:220px;height:220px;border-radius:50%;background:rgba(233,71,53,.24)}
.flash-sale-left{position:relative;z-index:2;display:flex;align-items:center;gap:14px}
.flash-sale-icon{width:46px;height:46px;border-radius:16px;background:linear-gradient(135deg,#FF6B42,#E94735);display:grid;place-items:center;box-shadow:0 10px 26px rgba(233,71,53,.30)}
.flash-sale-left h3{font-size:20px;margin-bottom:2px;letter-spacing:-.02em}
.flash-sale-left p{font-size:13px;color:rgba(255,255,255,.72)}
.flash-countdown{position:relative;z-index:2;display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.flash-time{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.16);border-radius:12px;padding:8px 10px;min-width:54px;text-align:center}
.flash-time b{display:block;font-size:17px;line-height:1}.flash-time small{font-size:9px;color:rgba(255,255,255,.62);font-weight:800;text-transform:uppercase}
.voucher-box{margin:14px 0 16px;border:1px solid var(--line);background:#FAF8F4;border-radius:16px;padding:12px}
.voucher-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px;font-size:12px;font-weight:900;color:#5d5a52;text-transform:uppercase;letter-spacing:.08em}
.voucher-row{display:flex;gap:8px}.voucher-row input{flex:1;border:1px solid var(--line);background:#fff;border-radius:12px;padding:11px 12px;outline:none;font-weight:700;color:var(--ink)}.voucher-row input:focus{border-color:var(--olive);box-shadow:0 0 0 3px rgba(122,128,98,.10)}
.voucher-message{font-size:12px;font-weight:800;margin-top:8px;color:var(--muted)}.voucher-message.success{color:#4D7A50}.voucher-message.error{color:#C92F24}.checkout-discount{display:flex;justify-content:space-between;align-items:center;margin:12px 0 8px;font-size:14px;font-weight:900;color:#C92F24}.checkout-voucher-box{margin:14px 0}.admin-promo-note{font-size:12px;color:var(--muted);line-height:1.5;margin:-4px 0 10px}
.promo-price-line{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}.discount-note{font-size:12px;color:#C92F24;font-weight:900;background:rgba(233,71,53,.08);border:1px solid rgba(233,71,53,.15);border-radius:999px;padding:5px 8px}
.admin-promo-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.admin-promo-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:14px;margin-top:12px}.admin-promo-card h4{font-size:15px;margin-bottom:10px}.admin-promo-list{display:grid;gap:8px;max-height:220px;overflow:auto}.admin-promo-item{border:1px solid #eee;border-radius:12px;padding:10px;background:#FAF8F4;font-size:12px}.admin-promo-item b{font-size:13px}.admin-promo-actions{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap}
.admin-promo-actions button{border-radius:999px;padding:6px 9px;font-size:11px;font-weight:800;cursor:pointer}
@media(max-width:900px){.flash-sale-strip{padding:0 4% 22px;margin-top:-10px}.flash-sale-box{align-items:flex-start;flex-direction:column}.flash-countdown{justify-content:flex-start}.admin-promo-grid{grid-template-columns:1fr}.voucher-row{flex-direction:column}}

.quick-color{position:absolute;left:12px;right:12px;bottom:12px;z-index:4;background:rgba(255,255,255,.82);border:1px solid rgba(255,255,255,.8);backdrop-filter:blur(12px);border-radius:12px;padding:8px 10px;display:flex;align-items:center;justify-content:space-between;gap:10px;box-shadow:0 8px 20px rgba(44,42,40,.06)}.quick-color small{font-size:10px;font-weight:800;color:#625e57;text-transform:uppercase;letter-spacing:.08em}.swatches{display:flex;gap:7px}.swatch{width:20px;height:20px;border-radius:50%;border:1px solid rgba(0,0,0,.16);box-shadow:inset 0 0 0 2px rgba(255,255,255,.6);cursor:pointer;transition:.2s}.swatch.active{outline:2px solid var(--ink);outline-offset:2px;transform:scale(.92)}
.product-info{padding:0 2px}.product-title{font-size:17px;font-weight:800;margin-bottom:6px;letter-spacing:-.02em}.product-short{font-size:13px;color:var(--muted);line-height:1.45;min-height:38px;margin-bottom:10px}.price-line{display:flex;align-items:baseline;gap:9px;margin-bottom:9px}.product-price{font-size:16px;color:var(--olive);font-weight:800}.old-price{font-size:12px;color:#a39d96;text-decoration:line-through;font-weight:600}.meta-line{display:flex;align-items:center;justify-content:space-between;gap:10px;color:#8a837b;font-size:12px;font-weight:800;letter-spacing:0}.rating-stars{display:inline-flex;align-items:center;gap:2px;color:#C49A45;font-size:12px}.rating-stars b{color:#5d5a52;font-size:12px;margin-left:4px;font-weight:800}.sold-count{display:inline-flex;align-items:center;gap:5px;color:#7d766d;font-size:12px;font-weight:800;background:rgba(255,255,255,.62);border:1px solid rgba(229,226,217,.85);border-radius:999px;padding:5px 8px}.sold-count i{color:var(--olive);font-size:11px}
.custom-strip{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.custom-card{display:flex;justify-content:space-between;align-items:center;gap:22px;background:linear-gradient(135deg,#fff,#EEF0E8);border:1px solid rgba(122,128,98,.16);border-radius:18px;padding:24px;box-shadow:var(--shadow)}.custom-card h2{font-size:28px;margin-bottom:8px}.custom-card p{color:var(--muted);font-size:14px;max-width:760px}
.modal{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(18,17,16,.62);z-index:5000;padding:22px;backdrop-filter:blur(8px)}.modal.active{display:flex}.modal-card{width:min(1180px,96vw);max-height:92vh;overflow:auto;background:#fff;border-radius:26px;display:grid;grid-template-columns:minmax(460px,1.05fr) minmax(420px,.95fr);box-shadow:0 34px 90px rgba(0,0,0,.30);position:relative}.modal-close{position:absolute;right:18px;top:14px;font-size:24px;cursor:pointer;color:#888;z-index:3}.modal-media{padding:22px;background:var(--soft);position:relative}.modal-media img{height:590px;width:100%;object-fit:cover;border-radius:20px}.modal-gallery-btn{position:absolute;top:50%;transform:translateY(-50%);z-index:5;width:42px;height:42px;border-radius:50%;background:rgba(255,255,255,.86);border:1px solid rgba(229,226,217,.92);box-shadow:0 8px 22px rgba(44,42,40,.10);display:grid;place-items:center;cursor:pointer;color:var(--ink);transition:.2s}.modal-gallery-btn:hover{background:#fff;transform:translateY(-50%) scale(1.04)}.modal-gallery-btn.prev{left:28px}.modal-gallery-btn.next{right:28px}.modal-gallery-btn.is-hidden{display:none}.modal-thumbs{display:flex;gap:8px;overflow-x:auto;padding:10px 2px 0;margin-top:8px}.modal-thumb{width:64px;height:64px;border-radius:10px;border:2px solid transparent;background:#e5e2d9;overflow:hidden;cursor:pointer;flex:0 0 auto;opacity:.72}.modal-thumb.active{border-color:var(--olive);opacity:1}.modal-thumb img{width:100%;height:100%;object-fit:cover;border-radius:8px}.modal-actions.single{grid-template-columns:1fr}.modal-actions.single .btn{justify-content:center}.modal-actions.buy-actions{grid-template-columns:1fr 1fr}.modal-actions.buy-actions .btn{justify-content:center}.modal-actions.buy-actions .btn-dark{box-shadow:0 8px 20px rgba(44,42,40,.12)}
.modal-extra{grid-column:1 / -1;border-top:1px solid var(--line);padding:30px;background:linear-gradient(180deg,#fff,#FAF8F4);position:relative;z-index:1}
.product-detail-box{display:flex;flex-direction:column;gap:22px;margin-bottom:0}
.detail-panel,.review-panel{border:1px solid var(--line);background:#fff;border-radius:22px;padding:26px;box-shadow:0 12px 34px rgba(44,42,40,.045)}
.detail-panel h3,.review-panel h3{font-size:22px;margin-bottom:14px;letter-spacing:-.025em;display:flex;align-items:center;gap:10px}
.detail-panel h3::before{content:"";width:7px;height:24px;border-radius:999px;background:var(--olive);display:inline-block}.review-panel h3::before{content:"";width:7px;height:24px;border-radius:999px;background:#C49A45;display:inline-block}
.detail-panel p{font-size:15px;color:#5f5a52;margin-bottom:16px;line-height:1.85;max-width:980px;white-space:pre-line;overflow-wrap:anywhere}
.detail-list{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px}
.detail-item{background:#FAF8F4;border:1px solid #eee;border-radius:14px;padding:12px 13px;font-size:13px;color:#5d5a52;font-weight:800}
.detail-item i{color:var(--olive);margin-right:7px}
.review-summary{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:16px;background:#FAF8F4;border:1px solid #eee;border-radius:16px;padding:15px}
.review-score{font-size:30px;font-weight:900;color:var(--ink);line-height:1}
.review-score small{font-size:12px;color:var(--muted);font-weight:800}
.review-stars{color:#C49A45;font-size:13px;white-space:nowrap}
.review-form{display:grid;gap:10px;margin-top:14px;background:#FAF8F4;border:1px solid #eee;border-radius:18px;padding:16px}
.review-form input,.review-form textarea,.review-form select{width:100%;border:1px solid var(--line);border-radius:12px;padding:11px;background:#fff;outline:none;font-family:inherit;font-size:13px}
.review-form textarea{min-height:82px;resize:vertical}.review-image-upload{border:1px dashed var(--olive);background:#fff;border-radius:14px;padding:12px;display:flex;align-items:center;justify-content:space-between;gap:12px;cursor:pointer;color:#5d5a52;font-size:13px;font-weight:800}
.review-image-upload input{display:none}
.review-image-upload i{color:var(--olive)}
.review-image-preview{display:none;grid-template-columns:repeat(auto-fill,minmax(72px,1fr));gap:8px;margin-top:8px}
.review-image-preview.active{display:grid}
.review-image-preview img{width:100%;height:72px;object-fit:cover;border-radius:10px;border:1px solid var(--line);background:#e5e2d9}
.review-photos{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.review-photos img{width:76px;height:76px;object-fit:cover;border-radius:11px;border:1px solid var(--line);background:#e5e2d9;cursor:pointer;transition:.2s}
.review-photos img:hover{transform:scale(1.04)}
.review-photo-modal{position:fixed;inset:0;background:rgba(18,17,16,.76);z-index:9000;display:none;align-items:center;justify-content:center;padding:22px}
.review-photo-modal.active{display:flex}
.review-photo-modal img{max-width:min(920px,94vw);max-height:88vh;border-radius:18px;box-shadow:0 30px 80px rgba(0,0,0,.38)}
.review-photo-close{position:absolute;top:18px;right:24px;width:42px;height:42px;border-radius:50%;background:#fff;color:#333;display:grid;place-items:center;cursor:pointer;font-size:22px}
.review-form input:focus,.review-form textarea:focus,.review-form select:focus{border-color:var(--olive);box-shadow:0 0 0 3px rgba(122,128,98,.10)}
.review-list{display:grid;gap:12px;margin-top:18px;max-height:420px;overflow:auto;padding-right:4px}
.review-card{background:#fff;border:1px solid #eee;border-radius:14px;padding:12px}
.review-card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:6px}
.review-card b{font-size:13px}.review-card small{color:#8a837b;font-size:11px;font-weight:700}
.review-card p{font-size:13px;color:#5f5a52;line-height:1.55;margin:0;white-space:pre-line;overflow-wrap:anywhere}
.review-empty{background:#fff;border:1px dashed #ddd;border-radius:14px;padding:14px;font-size:13px;color:var(--muted);text-align:center}
@media(max-width:900px){.product-detail-box{display:flex;flex-direction:column}.modal-extra{padding:18px}.detail-list{grid-template-columns:1fr 1fr}.review-summary{align-items:flex-start;flex-direction:column}.detail-panel,.review-panel{padding:20px}}
.modal-info{padding:36px}.modal-info h2{font-size:32px;margin-bottom:12px}.modal-info p{color:var(--muted);font-size:14px;margin-bottom:18px}.modal-info #modalDesc{font-size:14px;line-height:1.55;margin-bottom:20px;max-width:440px;color:#5f5a52}.option-title{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:#5d5a52;margin:18px 0 10px}.chip-row{display:flex;gap:8px;flex-wrap:wrap}.chip{border:1px solid var(--line);background:#fff;border-radius:var(--pill);padding:10px 14px;font-size:13px;font-weight:700;cursor:pointer;color:var(--muted);display:inline-flex;align-items:center;gap:8px}.chip.active{background:var(--soft2);border-color:var(--olive);color:var(--olive)}.modal-price{font-size:28px;font-weight:800;margin:22px 0 10px;color:var(--ink)}.delivery-date{display:inline-flex;flex-direction:column;align-items:flex-start;gap:5px;background:#F8F7F4;border:1px solid var(--line);border-radius:14px;padding:10px 13px;font-size:13px;font-weight:900;color:#5d5a52;margin:0 0 16px}.delivery-title{font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.08em;color:#34302b;line-height:1}.delivery-main{display:inline-flex;align-items:center;gap:8px;line-height:1.2}.delivery-date i{color:#00BFA5;font-size:15px}.delivery-range{color:#5d5a52}.cart-delivery{display:inline-flex;align-items:center;gap:6px;margin-top:6px;color:#6d675f;font-size:12px;font-weight:800}.cart-delivery i{color:#00BFA5;font-size:11px}.cart-delivery .delivery-label{color:#34302b}.modal-policies{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:16px 0}.modal-policy{background:#F8F7F4;border:1px solid var(--line);border-radius:12px;padding:10px;font-size:12px;font-weight:700;color:#5d5a52}.modal-policy i{color:var(--olive);margin-right:6px}.modal-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}
.footer{position:relative;overflow:hidden;padding:0;background:#171614;color:#BDB7AD;font-size:13px;border-top:1px solid rgba(255,255,255,.06)}
.footer::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 12% 8%,rgba(122,128,98,.24),transparent 34%),radial-gradient(circle at 86% 20%,rgba(184,103,93,.16),transparent 30%),linear-gradient(180deg,#1F1E1B 0%,#141311 100%);pointer-events:none}
.footer-wrap{position:relative;z-index:1;padding:56px 6% 26px}
.footer-main{display:grid;grid-template-columns:1.25fr .75fr .75fr 1fr;gap:28px;align-items:start}
.footer-brand{max-width:420px}.footer-logo{display:inline-flex;align-items:center;gap:10px;font-size:21px;font-weight:900;letter-spacing:.08em;color:#fff;margin-bottom:14px}.footer-logo-mark{width:38px;height:38px;border-radius:14px;background:linear-gradient(135deg,var(--olive),#A7A981);display:grid;place-items:center;color:#fff;box-shadow:0 14px 34px rgba(122,128,98,.22)}.footer-logo span{color:#BFC3A0}
.footer-desc{color:#BDB7AD;line-height:1.75;margin-bottom:18px}.footer-trust{display:flex;gap:8px;flex-wrap:wrap}.footer-trust span{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);border-radius:999px;padding:8px 11px;color:#E6E0D6;font-size:12px;font-weight:800}.footer-trust i{color:#BFC3A0}
.footer-col h3{font-size:13px;color:#fff;text-transform:uppercase;letter-spacing:.12em;margin-bottom:14px}.footer-links{display:grid;gap:10px}.footer-links a,.footer-links button{color:#BDB7AD;background:transparent;text-align:left;border:0;padding:0;font-size:13px;cursor:pointer;transition:.2s}.footer-links a:hover,.footer-links button:hover{color:#fff;transform:translateX(3px)}
.footer-contact-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.09);border-radius:20px;padding:18px;box-shadow:0 18px 45px rgba(0,0,0,.14)}.footer-contact-card h3{font-size:18px;color:#fff;margin-bottom:8px;letter-spacing:-.02em}.footer-contact-card p{color:#BDB7AD;line-height:1.65;margin-bottom:14px}.footer-contact-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}.footer-contact-actions .btn{justify-content:center;padding:11px 13px;border-radius:12px}.footer-contact-actions .btn-light{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.12);color:#fff}.footer-contact-actions .btn-light:hover{background:rgba(255,255,255,.14)}
.footer-bottom{position:relative;z-index:1;margin-top:34px;padding-top:18px;border-top:1px solid rgba(255,255,255,.08);display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;color:#8F8980;font-size:12px}.footer-bottom b{color:#fff}.footer-mini-links{display:flex;gap:14px;flex-wrap:wrap}.footer-mini-links a{color:#8F8980}.footer-mini-links a:hover{color:#fff}
