/* === Takumi GitHub Data Connector ===
   Giữ nguyên giao diện gốc của website, chỉ thay nguồn sản phẩm bằng takumi-data.json trên GitHub Pages. */
const TAKUMI_GITHUB_DATA_URL='https://cucuongcui96.github.io/takumi-studio-shop/takumi-website/takumi-data.json';
function takumiSetDataStatus(message,type=''){
  const el=document.getElementById('githubDataStatus');
  if(!el)return;
  el.classList.remove('success','error');
  if(type)el.classList.add(type);
  el.innerHTML=`<i class="fa-solid ${type==='error'?'fa-triangle-exclamation':type==='success'?'fa-circle-check':'fa-cloud-arrow-down'}"></i><span>${escapeAttr(message)}</span>`;
}
function takumiColorClassFrom(hex,name){
  const h=String(hex||'').toLowerCase();
  const n=String(name||'').toLowerCase();
  if(n.includes('đen')||n.includes('black')||h==='#252525'||h==='#000000')return 'color-black';
  if(n.includes('vàng')||n.includes('gold')||h==='#c6a65c'||h==='#b79a62')return 'color-gold';
  if(n.includes('xám')||n.includes('gray')||n.includes('grey')||h==='#a7a59e'||h==='#8b8980')return 'color-gray';
  return 'color-white';
}
function takumiNormalizeGithubCategories(raw){
  const cats=(raw?.categories||[]).filter(c=>c&&c.id&&c.id!=='all').map(c=>({id:String(c.id),name:String(c.name||c.id)}));
  return cats.length?cats:adminDefaultCategories();
}
function takumiNormalizeGithubProducts(raw){
  const list=Array.isArray(raw?.products)?raw.products:[];
  return list.filter(p=>p&&p.active!==false).map((p,idx)=>{
    const imgs=(Array.isArray(p.images)?p.images:[]).filter(Boolean);
    const colorRows=(Array.isArray(p.colors)?p.colors:[]).filter(c=>c&&c.name);
    const mappedColors=(colorRows.length?colorRows:[{name:'Trắng đá',hex:'#F4F1EA',image:imgs[0]||p.image||''}]).map(c=>({
      name:String(c.name||'Mặc định'),
      hex:String(c.hex||'#F4F1EA'),
      cls:takumiColorClassFrom(c.hex,c.name)
    }));
    const colorImages={};
    colorRows.forEach((c,i)=>{colorImages[String(c.name||'Mặc định')]=c.image||imgs[i]||imgs[0]||p.image||'';});
    mappedColors.forEach(c=>{if(!colorImages[c.name])colorImages[c.name]=imgs[0]||p.image||'';});
    const variants=(Array.isArray(p.variants)?p.variants:[]).map(v=>({
      size:String(v.size||'10cm'),
      style:String(v.style||'Mặc định'),
      price:Number(v.price||0),
      oldPrice:Number(v.oldPrice||v.old||0)
    })).filter(v=>v.price>0);
    const firstVariant=variants[0]||{};
    const basePrice=Number(firstVariant.price||p.price||0);
    const oldPrice=Number(firstVariant.oldPrice||p.oldPrice||p.old||0);
    const sale=oldPrice&&basePrice&&oldPrice>basePrice?Math.round((oldPrice-basePrice)/oldPrice*100):Number(p.sale||0);
    const rawBadge=String(p.badge||p.label||p.tag||'').trim();
    const badgeMarksHot=/được chọn|duoc chon|bán chạy|ban chay|hot/i.test(rawBadge);
    return {
      id:idx+1,
      githubId:String(p.id||idx+1),
      type:String(p.category||p.type||'decor'),
      filter:(p.featured||badgeMarksHot)?'hot':String(p.filter||p.category||'decor'),
      name:String(p.name||'Sản phẩm Takumi'),
      img:imgs[0]||p.image||'https://iili.io/Cdj4yS1.jpg',
      price:basePrice,
      old:oldPrice,
      sale:sale,
      ship:p.ship!==false,
      short:String(p.short||p.description||''),
      desc:String(p.description||p.desc||p.short||''),
      longDesc:String(p.description||p.desc||p.short||''),
      colors:mappedColors,
      colorImages,
      galleryImages:imgs.slice(1),
      variants,
      rating:Number(p.rating||4.9),
      sold:Number(p.sold||0),
      featured:!!p.featured,
      badge:rawBadge
    };
  });
}
function takumiNormalizeGithubVouchers(rawProducts,rawVouchers){
  const idMap=new Map((rawProducts||[]).map((p,idx)=>[String(p.id||idx+1),idx+1]));
  return (Array.isArray(rawVouchers)?rawVouchers:[]).filter(v=>v&&v.active!==false).map(v=>({
    code:String(v.code||'').trim().toUpperCase(),
    campaign:String(v.campaign||v.note||'Voucher Takumi'),
    note:String(v.note||''),
    type:String(v.type||'fixed'),
    value:Number(v.value||0),
    minSpend:Number(v.minSpend??v.minOrder??0),
    scope:String(v.scope||'all'),
    productIds:(v.productIds||[]).map(id=>idMap.get(String(id))||Number(id)).filter(Boolean),
    start:v.start||'',
    end:v.end||''
  })).filter(v=>v.code&&v.value>0);
}
function takumiNormalizeGithubFlash(rawProducts,rawFlash){
  const idMap=new Map((rawProducts||[]).map((p,idx)=>[String(p.id||idx+1),idx+1]));
  return (Array.isArray(rawFlash)?rawFlash:[]).filter(f=>f&&f.active!==false).map(f=>({
    campaign:String(f.campaign||f.name||'Flash Sale'),
    type:String(f.type||'percent'),
    value:Number(f.value||f.percent||f.fixed||0),
    scope:String(f.scope||'all'),
    productIds:(f.productIds||[]).map(id=>idMap.get(String(id))||Number(id)).filter(Boolean),
    start:f.start||'',
    end:f.end||'',
    enabled:f.enabled!==false
  })).filter(f=>f.value>0);
}
async function takumiLoadGithubData(){
  
  try{
    const res=await fetch(TAKUMI_GITHUB_DATA_URL+'?v='+Date.now(),{cache:'no-store'});
    if(!res.ok)throw new Error('HTTP '+res.status);
    const raw=await res.json();
    const nextProducts=takumiNormalizeGithubProducts(raw);
    if(!nextProducts.length)throw new Error('File JSON chưa có sản phẩm');
    products=nextProducts;
    products.forEach(p=>{p.colorImages=p.colorImages||{'Trắng đá':p.img,'Xám đá':p.img,'Vàng cổ':p.img,'Đen nhám':p.img};});
    try{localStorage.removeItem('takumi_products');localStorage.setItem('takumi_categories',JSON.stringify(takumiNormalizeGithubCategories(raw)));}catch(e){}
    vouchers=takumiNormalizeGithubVouchers(raw.products,raw.vouchers);
    flashSales=takumiNormalizeGithubFlash(raw.products,raw.flashSales);
    activeFilter='all';
    renderFilters();renderFeatured();renderProducts();updateCart();updateFlashSaleStrip();/* auto open product disabled */
    
  }catch(err){
    console.error('Không tải được dữ liệu GitHub:',err);
    
  }
}
function takumiInitShop(){
  loadStoredPromos();
  renderFilters();renderFeatured();renderProducts();adminRenderPromos();adminSyncVoucherTypeUI();adminSyncFlashTypeUI();adminEnsureFlashDefaults(false);observeRevealItems();updateCart();/* auto open product disabled */updateFlashSaleStrip();setInterval(updateFlashSaleStrip,1000);
  initCheckoutAddressAutocomplete();
  takumiLoadGithubData();
}


/* === Takumi v6: fix mở sản phẩm với ID dạng chữ + giữ Formspree v4 đang gửi mail được === */
function takumiEncode(value){return encodeURIComponent(String(value==null?'':value));}
function takumiDecode(value){try{return decodeURIComponent(String(value==null?'':value));}catch(e){return String(value==null?'':value);}}
function takumiSafeHtml(value){return escapeAttr(String(value==null?'':value));}
function takumiSameIdSafe(a,b){return String(a??'')===String(b??'');}
function takumiProductByAnyId(id){
  const key=String(id??'');
  return (products||[]).find(p=>takumiSameIdSafe(p.id,key)||takumiSameIdSafe(p.githubId,key));
}
function takumiSafeProductColor(product){
  if(!product.colors||!product.colors.length){
    product.colors=[{name:'Mặc định',hex:'#F4F1EA',cls:'color-white'}];
  }
  product.colorImages=product.colorImages||{};
  const selected=product.selectedColor||product.colors[0];
  return typeof selected==='string' ? (product.colors.find(c=>c.name===selected)||product.colors[0]) : (selected||product.colors[0]);
}
function takumiSafeImg(src){return escapeAttr(src||'https://iili.io/Cdj4yS1.jpg');}

/* === Takumi v11: tách ảnh bìa khỏi ảnh theo màu === */
function takumiCoverImage(product){
  return (product&&product.img)||'https://iili.io/Cdj4yS1.jpg';
}
function takumiColorImage(product,colorName){
  const name=String(colorName||'');
  return (product&&product.colorImages&&product.colorImages[name])||takumiCoverImage(product);
}
function takumiCardDisplayImage(product,colorName){
  // Ngoài card: mặc định luôn dùng ảnh bìa. Chỉ đổi sang ảnh màu sau khi khách bấm chọn màu.
  return product&&product._takumiCardColorSelected?takumiColorImage(product,colorName):takumiCoverImage(product);
}
function takumiProductGallery(product,colorName){
  const cover=takumiCoverImage(product);
  const gallery=Array.isArray(product&&product.galleryImages)?product.galleryImages:[];
  if(!(product&&product._takumiModalColorSelected)){
    return [...new Set([cover,...gallery].filter(Boolean))];
  }
  const colorImg=takumiColorImage(product,colorName);
  return [...new Set([colorImg,cover,...gallery].filter(Boolean))];
}

function takumiBadgeHtml(p){
  const raw=String((p&&p.badge)||'').trim();
  const hotByFilter=p&&p.filter==='hot';
  const text=raw || (hotByFilter?'Được chọn nhiều':'');
  if(!text)return '';
  const normalized=text.toLowerCase();
  const isCode=/mã\s*sp|ma\s*sp|sku|code/.test(normalized);
  const isHot=/được chọn|duoc chon|bán chạy|ban chay|hot/.test(normalized) || (!raw&&hotByFilter);
  const cls=isCode?'code':(isHot?'hot':'code');
  return `<span class="badge ${cls}">${takumiSafeHtml(text)}</span>`;
}
function takumiOpenProductFromEl(el){
  const id=takumiDecode(el&&el.dataset?el.dataset.productId:'');
  openProduct(id);
}
function takumiSelectCardColorSafe(event,el){
  if(event)event.stopPropagation();
  const id=takumiDecode(el&&el.dataset?el.dataset.productId:'');
  const color=takumiDecode(el&&el.dataset?el.dataset.color:'');
  selectCardColor(event,id,color);
}
function takumiChooseColor(el){
  selectedColor=takumiDecode(el&&el.dataset?el.dataset.value:'');
  if(currentProduct)currentProduct._takumiModalColorSelected=true;
  updateModal();
}
function takumiChooseSize(el){
  selectedSize=takumiDecode(el&&el.dataset?el.dataset.value:'');
  updateModal();
}
function takumiChooseStyle(el){
  selectedStyle=takumiDecode(el&&el.dataset?el.dataset.value:'');
  updateModal();
}
function featuredCard(p){
  const s=takumiSafeProductColor(p);
  const colorName=s.name||'Mặc định';
  const imgSrc=takumiCardDisplayImage(p,colorName);
  const display=productDisplayPrice(p);
  const old=productDisplayOldPrice(p);
  const id=takumiEncode(p.id);
  return `<article class="featured-mini reveal-on-scroll" data-product-id="${id}" onclick="takumiOpenProductFromEl(this)">
    <div class="featured-mini-img ${escapeAttr(s.cls||'color-white')}">
      <img src="${takumiSafeImg(imgSrc)}" alt="${takumiSafeHtml(p.name)}" loading="lazy">
      <div class="badge-layer"><div class="badge-left">${p.sale?`<span class="badge sale">-${escapeAttr(p.sale)}%</span>`:''}</div><div class="badge-right">${takumiBadgeHtml(p)}${p.ship?`<span class="badge ship"><i class="fa-solid fa-truck"></i> Freeship</span>`:''}</div></div>
    </div>
    <div class="featured-mini-info"><h3>${takumiSafeHtml(p.name)}</h3><p>${takumiSafeHtml(p.short)}</p><div class="featured-mini-price">Từ ${money(display)} ${old?`<span class="old-price">${money(old)}</span>`:''}</div></div>
  </article>`;
}
function productCard(p){
  const s=takumiSafeProductColor(p);
  const colorName=s.name||'Mặc định';
  const imgSrc=takumiCardDisplayImage(p,colorName);
  const display=productDisplayPrice(p);
  const old=productDisplayOldPrice(p);
  const id=takumiEncode(p.id);
  return `<article class="product-card reveal-on-scroll" data-product-id="${id}" onclick="takumiOpenProductFromEl(this)">
    <div class="product-img ${escapeAttr(s.cls||'color-white')}" id="imgWrap-${id}">
      <img id="cardImg-${id}" src="${takumiSafeImg(imgSrc)}" alt="${takumiSafeHtml(p.name)}" loading="lazy">
      <div class="badge-layer"><div class="badge-left">${p.sale?`<span class="badge sale">-${escapeAttr(p.sale)}%</span>`:''}</div><div class="badge-right">${takumiBadgeHtml(p)}${p.ship?`<span class="badge ship"><i class="fa-solid fa-truck"></i> Freeship</span>`:''}</div></div>
      <div class="quick-color" onclick="event.stopPropagation()"><small>Chọn màu</small><div class="swatches">${(p.colors||[]).map(c=>`<button type="button" title="${takumiSafeHtml(c.name)}" class="swatch ${c.name===colorName?'active':''}" style="background:${escapeAttr(c.hex||'#F4F1EA')}" data-product-id="${id}" data-color="${takumiEncode(c.name)}" onclick="takumiSelectCardColorSafe(event,this)"></button>`).join('')}</div></div>
    </div>
    <div class="product-info"><h3 class="product-title">${takumiSafeHtml(p.name)}</h3><p class="product-short">${takumiSafeHtml(p.short)}</p><div class="price-line"><span class="product-price">Từ ${money(display)}</span>${old?`<span class="old-price">${money(old)}</span>`:''}</div><div class="meta-line">${ratingHtml(p)}${soldHtml(p)}</div></div>
  </article>`;
}
function selectCardColor(event,id,colorName){
  if(event)event.stopPropagation();
  const p=takumiProductByAnyId(id);if(!p)return;
  takumiSafeProductColor(p);
  const c=(p.colors||[]).find(x=>x.name===colorName)||p.colors[0];p.selectedColor=c;p._takumiCardColorSelected=true;
  const safeId=takumiEncode(p.id);
  const wrap=document.getElementById('imgWrap-'+safeId);if(!wrap)return;
  const cardImg=document.getElementById('cardImg-'+safeId);
  const nextSrc=(p.colorImages&&p.colorImages[c.name])||p.img;
  wrap.querySelectorAll('.swatch').forEach(b=>b.classList.remove('active'));
  if(event&&event.currentTarget)event.currentTarget.classList.add('active');
  wrap.classList.add('is-fading');
  setTimeout(()=>{
    wrap.classList.remove('color-white','color-gray','color-gold','color-black');wrap.classList.add(c.cls||'color-white');
    if(cardImg&&cardImg.src!==nextSrc)cardImg.src=nextSrc;
    requestAnimationFrame(()=>wrap.classList.remove('is-fading'));
  },150);
}
function renderProducts(){
  const q=(document.getElementById('searchInput')?.value||'').toLowerCase().trim();
  const list=(products||[]).filter(p=>((p.name||'')+' '+(p.short||'')+' '+(p.desc||'')+' '+(p.type||'')).toLowerCase().includes(q)&&(activeFilter==='all'||p.type===activeFilter||p.filter===activeFilter));
  const grid=document.getElementById('productGrid');
  if(grid)grid.innerHTML=list.map(productCard).join('');
  observeRevealItems();
}
function renderFeatured(){
  const list=(products||[]).filter(p=>p.featured||p.filter==='hot').slice(0,3);
  const finalList=list.length?list:(products||[]).slice(0,3);
  const grid=document.getElementById('featuredGrid');
  if(grid)grid.innerHTML=finalList.map(featuredCard).join('');
  observeRevealItems();
}
function openProduct(id){
  currentProduct=takumiProductByAnyId(id);
  if(!currentProduct){showOrderError('Không tìm thấy dữ liệu sản phẩm. Bạn tải lại trang rồi thử lại nhé.');return;}
  takumiSafeProductColor(currentProduct);
  const firstVariant=(currentProduct.variants||[]).find(v=>v&&v.size&&String(v.size)!=='Theo yêu cầu');
  selectedSize=firstVariant?.size || (currentProduct.variants||[]).find(v=>v&&v.size)?.size || '10cm';
  selectedColor=(currentProduct.selectedColor&&currentProduct.selectedColor.name)||currentProduct.selectedColor||currentProduct.colors[0].name;
  selectedStyle=takumiVariantStyles(currentProduct)[0]||'';
  selectedQuantity=1;
  currentProduct._takumiModalColorSelected=false;
  try{updateModal();}catch(err){console.error('Lỗi mở sản phẩm:',err);showOrderError('Sản phẩm này đang thiếu dữ liệu lựa chọn. Bạn kiểm tra lại màu/size/giá trong file takumi-data.json.');return;}
  const modal=document.getElementById('productModal');
  if(modal)modal.classList.add('active');
  document.body.style.overflow='hidden';
  requestAnimationFrame(resetProductModalScroll);
}
function updateModal(){
  if(!currentProduct)return;
  takumiSafeProductColor(currentProduct);
  const c=(currentProduct.colors||[]).find(x=>x.name===selectedColor)||currentProduct.colors[0];
  const modalMedia=document.querySelector('.modal-media');
  if(modalMedia){
    modalMedia.classList.remove('color-white','color-gray','color-gold','color-black');
    modalMedia.classList.add(c.cls||'color-white');
  }
  modalGallery=getProductGalleryForColor(currentProduct,c.name);modalGalleryIndex=0;softSwapModalImage();
  const modalImg=document.getElementById('modalImg');if(modalImg)modalImg.className=c.cls||'color-white';
  const typeEl=document.getElementById('modalType');if(typeEl)typeEl.textContent=currentProduct.type==='decor'?'Takumi Decor':currentProduct.type==='figure'?'Custom Figure':'Zen Collection';
  const nameEl=document.getElementById('modalName');if(nameEl)nameEl.textContent=currentProduct.name||'Sản phẩm Takumi';
  const descEl=document.getElementById('modalDesc');if(descEl)descEl.innerHTML=`<strong style="color:#2C2A28">${takumiSafeHtml(currentProduct.short||'')}</strong>`;
  const longDesc=document.getElementById('modalLongDesc');if(longDesc)longDesc.textContent=currentProduct.longDesc||currentProduct.desc||currentProduct.short||'';
  const selectedColorLabel=document.getElementById('selectedColorLabel');if(selectedColorLabel)selectedColorLabel.textContent=c.name||'Mặc định';
  const selectedSizeLabel=document.getElementById('selectedSizeLabel');if(selectedSizeLabel)selectedSizeLabel.textContent=selectedSize==='Theo yêu cầu'?'Đặt riêng':selectedSize;

  const sizeFromVariants=[...new Set((currentProduct.variants||[]).map(v=>String(v.size||'').trim()).filter(Boolean))];
  const modalSizeOptions=[...(sizeFromVariants.length?sizeFromVariants:['10cm','15cm','20cm']),'Theo yêu cầu'];
  const colorChips=document.getElementById('colorChips');
  if(colorChips){
    colorChips.innerHTML=(currentProduct.colors||[]).map(color=>{
      const active=color.name===selectedColor;
      return `<button type="button" class="color-choice ${active?'active':''}" data-value="${takumiEncode(color.name)}" onclick="takumiChooseColor(this)"><b>${takumiSafeHtml(color.name)}</b></button>`;
    }).join('');
  }
  const sizeChips=document.getElementById('sizeChips');
  if(sizeChips){
    sizeChips.innerHTML=modalSizeOptions.map(s=>{
      const active=s===selectedSize;
      const label=s==='Theo yêu cầu'?'Đặt riêng':s;
      return `<button type="button" class="size-choice ${active?'active':''}" data-value="${takumiEncode(s)}" onclick="takumiChooseSize(this)"><span class="size-name">${takumiSafeHtml(label)}</span></button>`;
    }).join('');
  }
  const styles=takumiVariantStyles(currentProduct);
  const styleBlock=document.getElementById('styleOptionBlock');
  const styleChips=document.getElementById('styleChips');
  const selectedStyleLabel=document.getElementById('selectedStyleLabel');
  if(styleBlock&&styleChips){
    styleBlock.classList.toggle('active',styles.length>1);
    styleBlock.style.display=styles.length>1?'block':'none';
    if(styles.length){
      if(!styles.includes(selectedStyle))selectedStyle=styles[0];
      if(selectedStyleLabel)selectedStyleLabel.textContent=selectedStyle||'Mặc định';
      styleChips.innerHTML=styles.map(st=>`<button type="button" class="size-choice ${st===selectedStyle?'active':''}" data-value="${takumiEncode(st)}" onclick="takumiChooseStyle(this)"><span class="size-name">${takumiSafeHtml(st)}</span></button>`).join('');
    }else{
      selectedStyle='';
      if(selectedStyleLabel)selectedStyleLabel.textContent='Mặc định';
      styleChips.innerHTML='';
    }
  }
  const promo=productBestPromoData(currentProduct,selectedSize);
  const final=productDisplayPriceForSize(currentProduct,selectedSize);
  const oldDisplay=productDisplayOldPriceForSize(currentProduct,selectedSize);
  const priceEl=document.getElementById('modalPrice');
  if(priceEl){
    if(selectedSize==='Theo yêu cầu')priceEl.textContent='Liên hệ báo giá';
    else priceEl.innerHTML=`<div class="promo-price-line"><span>${money(final)}</span>${oldDisplay?`<span class="old-price">${money(oldDisplay)}</span>`:''}${promo?`<span class="discount-note">${takumiSafeHtml(promo.label)}</span>`:''}</div>`;
  }
  const deliveryEl=document.getElementById('modalDeliveryRange');if(deliveryEl) deliveryEl.textContent=deliveryDateRange();
  syncQuantityInput();syncStickyBuybarPrice();renderProductReviews();renderRelatedProducts();
}
function renderRelatedProducts(){
  const box=document.getElementById('relatedProducts');
  if(!box||!currentProduct)return;
  const list=relatedProductList(currentProduct);
  box.innerHTML=list.map(p=>{
    const c=takumiSafeProductColor(p);
    const colorName=c.name||'Mặc định';
    const img=(p.colorImages&&p.colorImages[colorName])||p.img;
    const typeLabel=p.type==='decor'?'Decor':p.type==='figure'?'Figure':'Tượng';
    return `<article class="related-card" data-product-id="${takumiEncode(p.id)}" onclick="takumiOpenRelatedFromEl(this)">
      <div class="related-img ${escapeAttr(c.cls||'color-white')}"><img src="${takumiSafeImg(img)}" alt="${takumiSafeHtml(p.name)}" loading="lazy"><span class="related-badge">${takumiSafeHtml(typeLabel)}</span></div>
      <div class="related-info"><b>${takumiSafeHtml(p.name)}</b><span>Từ ${money(p.price)}</span></div>
    </article>`;
  }).join('');
}
function takumiOpenRelatedFromEl(el){openRelatedProduct(takumiDecode(el&&el.dataset?el.dataset.productId:''));}
function openRelatedProduct(id){
  currentProduct=takumiProductByAnyId(id);
  if(!currentProduct)return;
  takumiSafeProductColor(currentProduct);
  selectedSize=(currentProduct.variants||[]).find(v=>v&&v.size&&String(v.size)!=='Theo yêu cầu')?.size || '10cm';
  selectedColor=(currentProduct.selectedColor&&currentProduct.selectedColor.name)||currentProduct.selectedColor||currentProduct.colors[0].name;
  selectedStyle=takumiVariantStyles(currentProduct)[0]||'';
  selectedQuantity=1;
  updateModal();
  const card=document.querySelector('#productModal .modal-card');
  if(card)card.scrollTo({top:0,behavior:'smooth'});
}
function addToCart(){
  try{
    if(!currentProduct){showOrderError('Bạn vui lòng chọn lại sản phẩm.');return;}
    if(selectedSize==='Theo yêu cầu'){zaloCurrentProduct();return}
    takumiSafeProductColor(currentProduct);
    const cartImg=(currentProduct.colorImages&&currentProduct.colorImages[selectedColor])||currentProduct.img;
    const appliedPromo=productBestPromoData(currentProduct,selectedSize);
    cart.push({id:Date.now(),productId:currentProduct.id,name:currentProduct.name,img:cartImg,size:selectedSize,style:selectedStyle,color:selectedColor,qty:selectedQuantity,basePrice:baseProductPrice(currentProduct,selectedSize),price:currentPrice(),oldPrice:oldProductPriceFor(currentProduct,selectedSize),appliedPromoCode:appliedPromo?appliedPromo.code:'',note:''});
    updateCart();
    flyProductToCart().then(()=>showTakumiToast('Đã thêm vào giỏ hàng', `${currentProduct.name} · ${selectedSize}${selectedStyle?' · '+selectedStyle:''} · ${selectedColor} · SL ${selectedQuantity}`));
  }catch(err){console.error('Lỗi thêm giỏ:',err);showOrderError('Sản phẩm này đang thiếu dữ liệu giá/màu/size. Bạn kiểm tra lại trong admin rồi xuất JSON mới.');}
}
function buyNow(){
  try{
    if(!currentProduct){showOrderError('Bạn vui lòng chọn lại sản phẩm.');return;}
    if(selectedSize==='Theo yêu cầu'){zaloCurrentProduct();return}
    takumiSafeProductColor(currentProduct);
    const cartImg=(currentProduct.colorImages&&currentProduct.colorImages[selectedColor])||currentProduct.img;
    cart=[{id:Date.now(),productId:currentProduct.id,name:currentProduct.name,img:cartImg,size:selectedSize,style:selectedStyle,color:selectedColor,qty:selectedQuantity,basePrice:baseProductPrice(currentProduct,selectedSize),price:currentPrice(),oldPrice:oldProductPriceFor(currentProduct,selectedSize),appliedPromoCode:(productBestPromoData(currentProduct,selectedSize)||{}).code||'',note:''}];
    updateCart();closeProductModal();openCheckout();
  }catch(err){console.error('Lỗi mua ngay:',err);showOrderError('Sản phẩm này đang thiếu dữ liệu giá/màu/size. Bạn kiểm tra lại trong admin rồi xuất JSON mới.');}
}


/* === Takumi v8: không tự mở sản phẩm khi tải trang === */
function takumiForceCloseStartupModals(){
  ['productModal','checkoutModal','reviewPhotoModal','orderSuccessModal','cartOverlay'].forEach(id=>{
    const el=document.getElementById(id);
    if(el)el.classList.remove('active');
  });
  const cartDrawer=document.querySelector('.cart-drawer');
  if(cartDrawer)cartDrawer.classList.remove('active');
  document.body.style.overflow='';
}
takumiForceCloseStartupModals();
setTimeout(takumiForceCloseStartupModals,80);
setTimeout(takumiForceCloseStartupModals,650);


takumiInitShop();
setTimeout(takumiForceCloseStartupModals,1200);
</script>

<script>
(function takumiImageProtectionV20(){
  const protectedSelectors = [
    '.product-img', '.featured-mini-img', '.modal-media', '.modal-thumb',
    '.related-card', '.cart-item', '.summary-item', '.review-photos', '.review-photo-modal'
  ];
  const protectedQuery = protectedSelectors.join(',');
  let toastTimer = null;

  function showImageProtectToast(){
    let toast = document.getElementById('takumiImageProtectToast');
    if(!toast){
      toast = document.createElement('div');
      toast.id = 'takumiImageProtectToast';
      toast.className = 'takumi-image-protect-toast';
      toast.textContent = 'Ảnh thuộc Takumi Studio. Vui lòng liên hệ để sử dụng.';
      document.body.appendChild(toast);
    }
    toast.classList.add('active');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('active'), 2100);
  }

  function isProtectedTarget(target){
    if(!target || !target.closest) return false;
    return !!target.closest(protectedQuery) || (target.tagName === 'IMG' && !target.closest('.logo, .footer-logo, .logo-img, .footer-logo-img'));
  }

  function hardenImages(root=document){
    root.querySelectorAll('img').forEach(img => {
      if(img.closest('.logo, .footer-logo')) return;
      img.setAttribute('draggable','false');
      img.setAttribute('loading', img.getAttribute('loading') || 'lazy');
      img.addEventListener('dragstart', e => e.preventDefault(), {passive:false});
    });
  }

  document.addEventListener('contextmenu', function(e){
    if(isProtectedTarget(e.target)){
      e.preventDefault();
      showImageProtectToast();
    }
  }, {capture:true});

  document.addEventListener('dragstart', function(e){
    if(isProtectedTarget(e.target)){
      e.preventDefault();
      showImageProtectToast();
    }
  }, {capture:true});

  document.addEventListener('copy', function(e){
    if(isProtectedTarget(document.activeElement)){
      e.preventDefault();
      showImageProtectToast();
    }
  }, {capture:true});

  // Hạn chế long-press lưu ảnh trên mobile, nhưng không khóa thao tác vuốt/click bình thường.
  let longPressTimer = null;
  document.addEventListener('touchstart', function(e){
    if(!isProtectedTarget(e.target)) return;
    clearTimeout(longPressTimer);
    longPressTimer = setTimeout(showImageProtectToast, 650);
  }, {passive:true, capture:true});
  document.addEventListener('touchend', () => clearTimeout(longPressTimer), {passive:true, capture:true});
  document.addEventListener('touchmove', () => clearTimeout(longPressTimer), {passive:true, capture:true});

  hardenImages();
  const mo = new MutationObserver(mutations => {
    mutations.forEach(m => m.addedNodes && m.addedNodes.forEach(node => {
      if(node.nodeType === 1) hardenImages(node);
    }));
  });
  if(document.body) mo.observe(document.body, {childList:true, subtree:true});
})();
</script>

