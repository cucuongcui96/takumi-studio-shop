let VN_ADDRESS_LOADED = false;
let VN_ADDRESS_LOADING = false;

function normalizeVNText(str=''){
  return String(str).normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/Đ/g,'D').toLowerCase().trim();
}
function stripAdminPrefix(name=''){
  return String(name)
    .replace(/^(Thành phố|Tỉnh|Quận|Huyện|Thị xã|Phường|Xã|Thị trấn)\s+/i,'')
    .trim();
}
function displayProvinceName(apiName=''){
  const raw=String(apiName||'').trim();
  if(/Hồ Chí Minh/i.test(raw)) return 'TP. Hồ Chí Minh';
  return stripAdminPrefix(raw);
}
function exactVNMatch(value,list){
  const n=normalizeVNText(value);
  return (list||[]).find(item=>normalizeVNText(item)===n)||'';
}
function fuzzyVNFilter(value,list,limit=12){
  const n=normalizeVNText(value);
  if(!n) return (list||[]).slice(0,limit);
  return (list||[]).filter(item=>normalizeVNText(item).includes(n)).slice(0,limit);
}
function setDatalistOptions(id,items){
  const el=document.getElementById(id); if(!el) return;
  el.innerHTML=(items||[]).map(v=>`<option value="${escapeAttr(v)}"></option>`).join('');
}
function getProvinceMatch(){return exactVNMatch(document.getElementById('checkoutProvince')?.value||'', VN_PROVINCES);}
function getDistrictMatch(){
  const province=getProvinceMatch();
  const districts=province && VN_ADDRESS_DATA[province]?Object.keys(VN_ADDRESS_DATA[province]):[];
  return exactVNMatch(document.getElementById('checkoutDistrict')?.value||'', districts);
}
async function loadFullVNAddressData(){
  if(VN_ADDRESS_LOADED || VN_ADDRESS_LOADING) return;
  VN_ADDRESS_LOADING = true;
  try{
    const res = await fetch('https://provinces.open-api.vn/api/?depth=3');
    if(!res.ok) throw new Error('Không tải được dữ liệu địa chỉ');
    const provinces = await res.json();
    const data = {};
    const provinceNames = [];
    provinces.forEach(p=>{
      const provinceName = displayProvinceName(p.name);
      provinceNames.push(provinceName);
      data[provinceName] = {};
      (p.districts||[]).forEach(d=>{
        const districtName = stripAdminPrefix(d.name);
        data[provinceName][districtName] = (d.wards||[]).map(w=>stripAdminPrefix(w.name));
      });
    });
    VN_PROVINCES = provinceNames;
    VN_ADDRESS_DATA = data;
    VN_ADDRESS_LOADED = true;
    setDatalistOptions('provinceList', VN_PROVINCES);
    handleProvinceInput(false);
  }catch(e){
    console.warn('Dùng dữ liệu địa chỉ dự phòng vì không tải được danh sách đầy đủ.', e);
  }finally{
    VN_ADDRESS_LOADING = false;
  }
}
function handleProvinceInput(clearChildren=true){
  const provinceInput=document.getElementById('checkoutProvince');
  const districtInput=document.getElementById('checkoutDistrict');
  const wardInput=document.getElementById('checkoutWard');
  const provinceValue=provinceInput?.value||'';
  const province=getProvinceMatch();
  const provinceSuggestions=fuzzyVNFilter(provinceValue,VN_PROVINCES,16);
  setDatalistOptions('provinceList', provinceSuggestions.length?provinceSuggestions:VN_PROVINCES);

  const districts=province && VN_ADDRESS_DATA[province]?Object.keys(VN_ADDRESS_DATA[province]):[];
  setDatalistOptions('districtList', districts);
  if(clearChildren){
    if(districtInput && !districts.some(d=>normalizeVNText(d)===normalizeVNText(districtInput.value||''))) districtInput.value='';
    if(wardInput) wardInput.value='';
  }
  setDatalistOptions('wardList', []);
  updateCheckoutAddressField();
}
function handleDistrictInput(clearWard=true){
  const province=getProvinceMatch();
  const districtValue=document.getElementById('checkoutDistrict')?.value||'';
  const district=getDistrictMatch();
  const wardInput=document.getElementById('checkoutWard');
  const districts=province && VN_ADDRESS_DATA[province]?Object.keys(VN_ADDRESS_DATA[province]):[];
  setDatalistOptions('districtList', fuzzyVNFilter(districtValue,districts,16));

  const wards=province && district && VN_ADDRESS_DATA[province] && VN_ADDRESS_DATA[province][district] ? VN_ADDRESS_DATA[province][district] : [];
  setDatalistOptions('wardList', wards);
  if(clearWard && wardInput && !wards.some(w=>normalizeVNText(w)===normalizeVNText(wardInput.value||''))) wardInput.value='';
  updateCheckoutAddressField();
}
function handleWardInput(){
  const province=getProvinceMatch();
  const district=getDistrictMatch();
  const wardValue=document.getElementById('checkoutWard')?.value||'';
  const wards=province && district && VN_ADDRESS_DATA[province] && VN_ADDRESS_DATA[province][district] ? VN_ADDRESS_DATA[province][district] : [];
  setDatalistOptions('wardList', fuzzyVNFilter(wardValue,wards,16));
  updateCheckoutAddressField();
}
function updateCheckoutAddressField(){
  const province=document.getElementById('checkoutProvince')?.value.trim()||'';
  const district=document.getElementById('checkoutDistrict')?.value.trim()||'';
  const ward=document.getElementById('checkoutWard')?.value.trim()||'';
  const street=document.getElementById('checkoutStreet')?.value.trim()||'';
  const hidden=document.getElementById('checkoutAddressHidden');
  if(hidden){hidden.value=[street,ward,district,province].filter(Boolean).join(', ')}
  try{renderAvailableVouchers();refreshCheckoutTotals();}catch(e){}
}
function initCheckoutAddressAutocomplete(){
  setDatalistOptions('provinceList', VN_PROVINCES);
  setDatalistOptions('districtList', []);
  setDatalistOptions('wardList', []);
  updateCheckoutAddressField();
  loadFullVNAddressData();
}
function resetCheckoutAddressFields(){
  ['checkoutProvince','checkoutDistrict','checkoutWard','checkoutStreet','checkoutAddressHidden'].forEach(id=>{const el=document.getElementById(id); if(el) el.value='';});
  setDatalistOptions('provinceList', VN_PROVINCES);
  setDatalistOptions('districtList', []);
  setDatalistOptions('wardList', []);
}

function cartItemQuantity(item){return Math.max(1,Number(item.qty||item.quantity||1))}
function cartItemCheckoutPrice(item){
  const regular=cartItemRegularPrice(item);
  const old=Number(item.oldPrice||0);
  const itemPrice=Number(item.price||regular||0);
  const hasBaseSale=old>regular;

  // Sửa quan trọng:
  // Mã giảm gốc của sản phẩm chỉ được tính từ Giá gốc -> Giá ưu đãi hiện tại.
  // Ví dụ 249.000đ giảm 20% thì đơn giá đúng phải là 199.000đ.
  // Không lấy giá đã bị giảm tiếp bởi flash/voucher khác như 174.000đ để tránh cộng chồng sai.
  if(hasBaseSale && !isBaseSaleChecked(item.id))return old;
  if(hasBaseSale)return regular;

  return itemPrice;
}
function cartItemLineTotal(item){return cartItemCheckoutPrice(item)*cartItemQuantity(item)}
function cartSubtotal(){return cart.reduce((s,i)=>s+cartItemLineTotal(i),0)}
function isHanoiAddress(){
  const address=document.querySelector('#checkoutForm input[name="address"]')?.value||'';
  return /hà nội|ha noi|hanoi|hn/i.test(address);
}
function shippingVoucherInfo(){
  if(!cart.length)return null;
  if(isHanoiAddress())return {code:'FREESHIPHN',label:'Freeship nội thành Hà Nội',discount:SHIPPING_ESTIMATE,desc:'Áp dụng khi địa chỉ thuộc Hà Nội'};
  return {code:'SHIP50',label:'Hỗ trợ 50% phí ship',discount:Math.round(SHIPPING_ESTIMATE*0.5),desc:'Áp dụng cho tỉnh/thành khác'};
}
function voucherEligibleItems(v){
  if(!v||!cart.length)return [];
  const code=String(v.code||'').toUpperCase();
  let eligible=cart.filter(i=>String(i.appliedPromoCode||'').toUpperCase()!==code);
  if(v.scope==='product'){
    const ids=(v.productIds||[]).map(Number);
    eligible=eligible.filter(i=>ids.includes(Number(i.productId||0)));
  }
  return eligible;
}
function voucherEligibleSubtotal(v){
  return voucherEligibleItems(v).reduce((s,i)=>s+cartItemLineTotal(i),0);
}
function voucherMinSpend(v){
  return Math.max(0,Number(v?.minSpend||0));
}
function voucherRemainingAmount(v){
  return Math.max(0,voucherMinSpend(v)-voucherEligibleSubtotal(v));
}
function voucherUnlocked(v){
  return voucherEligibleSubtotal(v)>=voucherMinSpend(v);
}
function checkoutVoucherDiscount(v){
  if(!v||!promoActive(v)||!cart.length)return 0;
  const eligibleTotal=voucherEligibleSubtotal(v);
  if(!eligibleTotal||!voucherUnlocked(v))return 0;
  return v.type==='fixed'?Math.min(eligibleTotal,Number(v.value)||0):Math.round(eligibleTotal*(Number(v.value)||0)/100/1000)*1000;
}
function checkoutFinalTotal(){return Math.max(0,cartSubtotal()-checkoutVoucherDiscount(activeCheckoutVoucher))}
function voucherLabel(v){
  return v.type==='fixed'?`Giảm ${money(Number(v.value)||0)}`:`Giảm ${v.value}%`;
}
function availableCheckoutVouchers(){
  return (vouchers||[]).filter(v=>{
    if(!promoActive(v)||!cart.length)return false;
    if(v.scope==='product')return voucherEligibleItems(v).length>0;
    return true;
  });
}
function bestUnlockedCheckoutVoucher(){
  return availableCheckoutVouchers().filter(v=>voucherUnlocked(v)).sort((a,b)=>checkoutVoucherDiscount(b)-checkoutVoucherDiscount(a))[0]||null;
}
function productCardBasePrice(p){
  return Number(p?.price||0);
}
function productDisplayBasePrice(p,size='10cm'){
  return baseProductPrice(p,size);
}
function productApplicableVouchers(p,size='10cm'){
  const basePrice=productDisplayBasePrice(p,size);
  return (vouchers||[]).filter(v=>{
    if(!promoActive(v))return false;
    if(v.scope==='product'){
      const ids=(v.productIds||[]).map(Number);
      if(!ids.includes(Number(p.id)))return false;
    }
    return basePrice >= voucherMinSpend(v);
  });
}
function productVoucherDiscountAmount(p,v,size='10cm'){
  const basePrice=productDisplayBasePrice(p,size);
  if(!basePrice||!v)return 0;
  if(v.type==='fixed')return Math.min(basePrice, Number(v.value)||0);
  return Math.round(basePrice*(Number(v.value)||0)/100/1000)*1000;
}
function bestVoucherForProduct(p,size='10cm'){
  return productApplicableVouchers(p,size).sort((a,b)=>productVoucherDiscountAmount(p,b,size)-productVoucherDiscountAmount(p,a,size))[0]||null;
}
function productBestVoucherData(p,size='10cm'){
  const basePrice=productDisplayBasePrice(p,size);
  const voucher=bestVoucherForProduct(p,size);
  if(!voucher||!basePrice)return null;
  const discount=productVoucherDiscountAmount(p,voucher,size);
  if(!discount)return null;
  return {
    source:'voucher',
    code:voucher.code,
    label:voucherLabel(voucher),
    voucher,
    discount,
    finalPrice:Math.max(0, basePrice-discount)
  };
}
function productBestPromoData(p,size='10cm'){
  const basePrice=productDisplayBasePrice(p,size);
  if(!basePrice)return null;

  // Giá hiển thị ngoài card và popup chi tiết chỉ lấy GIÁ ƯU ĐÃI của sản phẩm.
  // Không tự lấy voucher checkout để trừ thêm vào giá hiển thị, tránh trường hợp:
  // Giá gốc 249.000đ -> giá ưu đãi 199.000đ nhưng ngoài web lại hiện 175.000đ.
  // Nếu muốn chạy flash sale thật, hãy tạo Flash sale trong admin; mặc định không có flash sale tự động.
  const flash=getActiveFlashForProduct(p);
  if(flash){
    const discount=flashDiscountAmount(flash,basePrice);
    if(discount){
      return {source:'flash',code:'FLASH',label:flashValueLabel(flash),flash,discount,finalPrice:Math.max(0,basePrice-discount)};
    }
  }
  return null;
}
function productBestPriceHtml(p){return '';}
function productDisplayPriceForSize(p,size='10cm'){
  const data=productBestPromoData(p,size);
  return data?data.finalPrice:productDisplayBasePrice(p,size);
}
function productDisplayPrice(p){
  return productDisplayPriceForSize(p,'10cm');
}
function productDisplayOldPriceForSize(p,size='10cm'){
  const display=productDisplayPriceForSize(p,size);
  const old=oldProductPriceFor(p,size);
  const base=productDisplayBasePrice(p,size);
  if(old>display)return old;
  if(display<base)return base;
  return 0;
}
function productDisplayOldPrice(p){
  return productDisplayOldPriceForSize(p,'10cm');
}
function productDisplayVoucherBadge(p){
  return '';
}
function featuredBestPriceHtml(p){return '';}
let baseSaleSelectionState={};
function isBaseSaleChecked(itemId){
  return baseSaleSelectionState[itemId]!==false;
}
function toggleBaseSaleCheckbox(itemId){
  baseSaleSelectionState[itemId]=!isBaseSaleChecked(itemId);
  if(activeCheckoutVoucher&&checkoutVoucherDiscount(activeCheckoutVoucher)===0)activeCheckoutVoucher=null;
  renderAvailableVouchers();
  refreshCheckoutTotals();
  updateCart();
}
function toggleSuggestedVoucher(code){
  const v=(vouchers||[]).find(x=>String(x.code||'').toUpperCase()===String(code||'').toUpperCase());
  const input=document.getElementById('checkoutVoucherInput');
  const msg=document.getElementById('checkoutVoucherMessage');
  if(v && !voucherUnlocked(v)){
    activeCheckoutVoucher=null;
    if(input)input.value='';
    if(msg){
      msg.textContent=`Mua thêm ${money(voucherRemainingAmount(v))} để mở mã ${v.code}.`;
      msg.className='voucher-message';
    }
    renderAvailableVouchers();
    refreshCheckoutTotals();
    return;
  }
  const same=activeCheckoutVoucher&&v&&String(activeCheckoutVoucher.code||'').toUpperCase()===String(v.code||'').toUpperCase();
  activeCheckoutVoucher=same?null:(v||null);
  if(input)input.value=activeCheckoutVoucher?activeCheckoutVoucher.code:'';
  if(msg){
    msg.textContent=activeCheckoutVoucher?`Đã áp dụng ${activeCheckoutVoucher.code}.`:'Chọn mã có sẵn hoặc nhập mã giảm giá.';
    msg.className=activeCheckoutVoucher?'voucher-message success':'voucher-message';
  }
  renderAvailableVouchers();
  refreshCheckoutTotals();
}
function toggleShippingVoucher(){
  const info=shippingVoucherInfo();
  activeShippingVoucher=activeShippingVoucher?null:info;
  renderAvailableVouchers();
  refreshCheckoutTotals();
}
function renderAvailableVouchers(){
  const box=document.getElementById('availableVoucherList');
  if(!box)return;
  const list=availableCheckoutVouchers();
  const ship=shippingVoucherInfo();
  const baseSaleItems=cartBaseSaleItems();

  const baseSaleHtml=baseSaleItems.map(item=>{
    const saved=productBaseSaleAmountForCartItem(item);
    const percent=productBaseSalePercentForCartItem(item);
    const checked=isBaseSaleChecked(item.id);
    const qty=cartItemQuantity(item);
    const qtyText=qty>1?' · SL '+qty:'';
    return `<label class="discount-voucher-card ${checked?'checked':''}">
      <input type="checkbox" ${checked?'checked':''} onclick="toggleBaseSaleCheckbox(${item.id})">
      <span class="discount-voucher-left">
        <i class="fa-solid fa-ticket"></i>
      </span>
      <span class="discount-voucher-right">
        <span class="discount-voucher-title-row">
          <b>Giảm ${percent}%</b>
          <span class="discount-voucher-best">${checked?'Đã chọn':'Có thể bỏ'}</span>
        </span>
        <span class="discount-voucher-sub">${escapeAttr(item.name)} · ${item.size}${qtyText}</span>
        <span class="discount-voucher-code">
          <span>Tiết kiệm ${money(saved*qty)}</span>
          <span class="discount-voucher-tag">SALE-${item.productId}</span>
        </span>
      </span>
      <span class="discount-voucher-check"><span><i class="fa-solid fa-check"></i></span></span>
    </label>`;
  }).join('');

  const voucherHtml=list.length?list.map(v=>{
    const discount=checkoutVoucherDiscount(v);
    const unlocked=voucherUnlocked(v);
    const remaining=voucherRemainingAmount(v);
    const checked=unlocked&&activeCheckoutVoucher&&activeCheckoutVoucher.code===v.code;
    const desc=unlocked
      ? (v.scope==='all'?'Toàn website':'Sản phẩm trong đơn')
      : `Mua thêm ${money(remaining)}`;
    const valueText=unlocked
      ? `Tiết kiệm ${money(discount)}`
      : `Đơn từ ${money(voucherMinSpend(v))}`;

    return `<label class="discount-voucher-card ${checked?'checked':''} ${unlocked?'':'locked'}">
      <input type="checkbox" ${checked?'checked':''} onclick="toggleSuggestedVoucher('${escapeAttr(v.code)}')">
      <span class="discount-voucher-left">
        <i class="fa-solid fa-ticket"></i>
      </span>
      <span class="discount-voucher-right">
        <span class="discount-voucher-title-row">
          <b>${voucherLabel(v)}</b>
          <span class="discount-voucher-best">${checked?'Đang chọn':(unlocked?'Có thể dùng':'Chưa đủ')}</span>
        </span>
        <span class="discount-voucher-sub">${desc}</span>
        <span class="discount-voucher-code">
          <span>${valueText}</span>
          <span class="discount-voucher-tag">${escapeAttr(v.code)}</span>
        </span>
      </span>
      <span class="discount-voucher-check"><span><i class="fa-solid fa-check"></i></span></span>
    </label>`;
  }).join(''):`<div class="auto-voucher-card disabled"><span class="auto-voucher-icon"><i class="fa-solid fa-ticket"></i></span><span class="auto-voucher-info"><b>Chưa có voucher phù hợp</b><span>Đơn hàng hiện chưa có mã có thể áp dụng.</span></span></div>`;

  const shipChecked=!!activeShippingVoucher;
  const shipTitle=isHanoiAddress()?'Freeship nội thành Hà Nội':`${ship.code} · Hỗ trợ 50% phí ship`;
  const shipDesc=isHanoiAddress()?'Miễn phí vận chuyển cho địa chỉ thuộc Hà Nội':(ship?.desc||'Áp dụng theo địa chỉ giao hàng');
  const shipSmall=isHanoiAddress()?'Tất cả hình thức thanh toán':'Áp dụng cho tỉnh/thành khác';
  const shipHtml=ship?`<label class="ship-compact-card ${shipChecked?'checked':''}">
      <input type="checkbox" ${shipChecked?'checked':''} onclick="toggleShippingVoucher()">
      <span class="ship-compact-icon"><i class="fa-solid fa-truck-fast"></i></span>
      <span class="ship-compact-content">
        <b>${shipTitle}</b>
        <span>${shipDesc}</span>
        <small>Tiết kiệm ${money(ship.discount)} · ${shipSmall}</small>
      </span>
      <span class="ship-compact-check"><span><i class="fa-solid fa-check"></i></span></span>
    </label>`:'';

  box.innerHTML=baseSaleHtml+voucherHtml+shipHtml;
}
function applyCheckoutVoucher(){
  const input=document.getElementById('checkoutVoucherInput');
  const msg=document.getElementById('checkoutVoucherMessage');
  if(!input||!msg)return;
  const code=input.value.trim().toUpperCase();
  const v=(vouchers||[]).find(x=>String(x.code||'').toUpperCase()===code);
  if(!code){activeCheckoutVoucher=null;msg.textContent='';msg.className='voucher-message';renderAvailableVouchers();refreshCheckoutTotals();return;}
  if(!v){activeCheckoutVoucher=null;msg.textContent='Mã voucher không tồn tại.';msg.className='voucher-message error';renderAvailableVouchers();refreshCheckoutTotals();return;}
  if(!promoActive(v)){activeCheckoutVoucher=null;msg.textContent='Mã voucher chưa đến thời gian áp dụng hoặc đã hết hạn.';msg.className='voucher-message error';renderAvailableVouchers();refreshCheckoutTotals();return;}
  if(!voucherUnlocked(v)){activeCheckoutVoucher=null;msg.textContent=`Bạn cần mua thêm ${money(voucherRemainingAmount(v))} để dùng mã này.`;msg.className='voucher-message error';renderAvailableVouchers();refreshCheckoutTotals();return;}
  const discount=checkoutVoucherDiscount(v);
  if(!discount){activeCheckoutVoucher=null;msg.textContent='Mã voucher này không áp dụng cho sản phẩm trong đơn hàng.';msg.className='voucher-message error';renderAvailableVouchers();refreshCheckoutTotals();return;}
  activeCheckoutVoucher=v;
  msg.textContent='';
  msg.className='voucher-message success';
  renderAvailableVouchers();
  refreshCheckoutTotals();
}
function refreshCheckoutTotals(){
  const subtotal=cartSubtotal();
  const discount=checkoutVoucherDiscount(activeCheckoutVoucher);
  if(activeCheckoutVoucher&&!discount)activeCheckoutVoucher=null;
  const shipInfo=shippingVoucherInfo();
  if(activeShippingVoucher&&shipInfo)activeShippingVoucher=shipInfo;
  const shipDiscount=activeShippingVoucher?activeShippingVoucher.discount:0;
  const total=Math.max(0,subtotal-discount);
  const subtotalEl=document.getElementById('checkoutSubtotal');if(subtotalEl)subtotalEl.textContent=money(subtotal);
  const discountLine=document.getElementById('checkoutDiscountLine');if(discountLine)discountLine.style.display=discount?'flex':'none';
  const discountEl=document.getElementById('checkoutDiscount');if(discountEl)discountEl.textContent='-'+money(discount);
  const shipLine=document.getElementById('shippingDiscountLine');if(shipLine)shipLine.style.display=shipDiscount?'flex':'none';
  const shipEl=document.getElementById('shippingDiscount');if(shipEl)shipEl.textContent='-'+money(shipDiscount);
  const checkoutTotal=document.getElementById('checkoutTotal');if(checkoutTotal)checkoutTotal.textContent=money(total);
  const qrTotal=document.getElementById('qrTotal');if(qrTotal)qrTotal.textContent=money(total);
  const voucherField=document.getElementById('voucherCodeField');if(voucherField)voucherField.value=activeCheckoutVoucher?activeCheckoutVoucher.code:'';
  const shipField=document.getElementById('shippingVoucherField');if(shipField)shipField.value=activeShippingVoucher?`${activeShippingVoucher.code} - ${activeShippingVoucher.label} (-${money(activeShippingVoucher.discount)})`:'';
  const baseSale=cartBaseSaleDiscount();
  const discountField=document.getElementById('discountAmountField');if(discountField)discountField.value=[baseSale?`Giảm sẵn theo giá gốc sản phẩm: -${money(baseSale)}`:'',discount?`Voucher nhập thêm: -${money(discount)}`:'',shipDiscount?`Ưu đãi ship: -${money(shipDiscount)}`:''].filter(Boolean).join(' | ');
  const orderTotal=document.getElementById('orderTotalField');if(orderTotal)orderTotal.value=money(total);
}
function updateFlashSaleStrip(){
  const strip=document.getElementById('flashSaleStrip');
  if(!strip)return;
  const now=Date.now();
  const activeOrUpcoming=(flashSales||[]).find(f=>{
    if(!flashEnabled(f)||!flashValue(f))return false;
    const start=toTime(f.start),end=toTime(f.end);
    if(end && now>end)return false;
    return !start || now<=end || now<start;
  });
  if(!activeOrUpcoming){strip.style.display='none';return;}
  const start=toTime(activeOrUpcoming.start);
  const end=toTime(activeOrUpcoming.end);
  const isUpcoming=start && now<start;
  const isRunning=(!start||now>=start) && (!end||now<=end);
  if(!isUpcoming&&!isRunning){strip.style.display='none';return;}

  strip.style.display='block';
  document.getElementById('flashSaleTitle').textContent=isUpcoming
    ? `Sắp diễn ra: ${activeOrUpcoming.title||'Flash Sale'}`
    : `Đang diễn ra: ${activeOrUpcoming.title||'Flash Sale'}`;
  document.getElementById('flashSaleDesc').textContent=isUpcoming
    ? `${flashValueLabel(activeOrUpcoming)} ${activeOrUpcoming.scope==='all'?'toàn website':'cho sản phẩm được chọn'} · Đếm ngược đến lúc bắt đầu.`
    : `${flashValueLabel(activeOrUpcoming)} ${activeOrUpcoming.scope==='all'?'toàn website':'cho sản phẩm được chọn'} · Đếm ngược đến khi kết thúc.`;

  const target=isUpcoming?start:end;
  const remain=target?Math.max(0,target-now):0;
  const d=Math.floor(remain/86400000),h=Math.floor(remain%86400000/3600000),m=Math.floor(remain%3600000/60000),s=Math.floor(remain%60000/1000);
  document.getElementById('flashDays').textContent=String(d).padStart(2,'0');
  document.getElementById('flashHours').textContent=String(h).padStart(2,'0');
  document.getElementById('flashMinutes').textContent=String(m).padStart(2,'0');
  document.getElementById('flashSeconds').textContent=String(s).padStart(2,'0');
}

function starText(r){const n=Math.round(Number(r)||5);return Array.from({length:5},(_,i)=>`<i class="${i<n?'fa-solid':'fa-regular'} fa-star"></i>`).join('')}
function reviewKey(productId){return 'takumi_reviews_'+productId}
function getStoredReviews(productId){
  try{return JSON.parse(localStorage.getItem(reviewKey(productId))||'[]')}catch(e){return []}
}
function defaultReviews(p){
  return [
    {name:'Khách hàng',rating:5,comment:'Tượng đẹp, chi tiết rõ và đóng gói cẩn thận.',date:'Mới đây'},
    {name:'Người mua đã xác nhận',rating:5,comment:'Màu bên ngoài nhìn trầm và sang hơn ảnh, shop tư vấn nhiệt tình.',date:'Mới đây'}
  ];
}
function allReviews(p){return [...getStoredReviews(p.id),...defaultReviews(p)]}
let pendingReviewImages=[];
function compressReviewImage(file,callback){
  if(!file||!file.type.startsWith('image/'))return;
  const reader=new FileReader();
  reader.onload=()=>{
    const img=new Image();
    img.onload=()=>{
      const max=1000;
      let w=img.width,h=img.height;
      if(w>max||h>max){
        if(w>h){h=Math.round(h*max/w);w=max}else{w=Math.round(w*max/h);h=max}
      }
      const canvas=document.createElement('canvas');
      canvas.width=w;canvas.height=h;
      const ctx=canvas.getContext('2d');
      ctx.drawImage(img,0,0,w,h);
      callback(canvas.toDataURL('image/jpeg',0.82));
    };
    img.src=reader.result;
  };
  reader.readAsDataURL(file);
}
function previewReviewImages(event){
  const files=[...(event.target.files||[])].filter(f=>f.type&&f.type.startsWith('image/')).slice(0,5);
  pendingReviewImages=[];
  const box=document.getElementById('reviewImagePreview');
  if(!files.length){box.classList.remove('active');box.innerHTML='';return;}
  let done=0;
  files.forEach(file=>{
    compressReviewImage(file,(data)=>{
      pendingReviewImages.push(data);
      done++;
      if(done===files.length){
        box.innerHTML=pendingReviewImages.map(src=>`<img src="${src}" alt="Ảnh đánh giá">`).join('');
        box.classList.add('active');
      }
    });
  });
}
function openReviewPhoto(src){
  const modal=document.getElementById('reviewPhotoModal');
  const img=document.getElementById('reviewPhotoLarge');
  if(!modal||!img)return;
  img.src=src;
  modal.classList.add('active');
}
function closeReviewPhoto(){
  const modal=document.getElementById('reviewPhotoModal');
  if(modal)modal.classList.remove('active');
}

function reviewAverageValue(p){
  const list=allReviews(p);
  if(!list.length)return Number(p.rating||4.9);
  const avg=list.reduce((s,r)=>s+Number(r.rating||5),0)/list.length;
  return Math.min(5,Math.max(1,avg));
}



/* Thêm loading="lazy" vào thẻ img */
