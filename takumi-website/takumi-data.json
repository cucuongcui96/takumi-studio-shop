    <div class="admin-promo-stat"><i class="fa-solid fa-clock"></i><div><b>${s.scheduled}</b><span>Sắp chạy</span></div></div>
    <div class="admin-promo-stat"><i class="fa-solid fa-ban"></i><div><b>${s.expired}</b><span>Hết hạn</span></div></div>
