let takumiRevealObserver=null;
function initRevealObserver(){
  const reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce){document.querySelectorAll('.reveal-on-scroll').forEach(el=>el.classList.add('is-visible'));return;}
  if(!('IntersectionObserver' in window)){document.querySelectorAll('.reveal-on-scroll').forEach(el=>el.classList.add('is-visible'));return;}
  takumiRevealObserver=new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){entry.target.classList.add('is-visible');takumiRevealObserver.unobserve(entry.target);}
    });
  },{threshold:.14,rootMargin:'0px 0px -40px 0px'});
}
function observeRevealItems(){
  if(!takumiRevealObserver)initRevealObserver();
  document.querySelectorAll('.reveal-on-scroll:not(.is-visible)').forEach((el,i)=>{
    el.style.transitionDelay=Math.min(i*35,210)+'ms';
    takumiRevealObserver?takumiRevealObserver.observe(el):el.classList.add('is-visible');
  });
}
function softSwapModalImage(){
  const media=document.querySelector('.modal-media');
  if(!media){renderModalGallery();return;}
  media.classList.add('is-fading');
  setTimeout(()=>{renderModalGallery();requestAnimationFrame(()=>media.classList.remove('is-fading'));},140);
}

