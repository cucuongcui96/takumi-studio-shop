    </div>
    <div class="admin-promo-actions">
      <button type="button" onclick='adminEditProduct(${takumiIdArg(p.id)})'><i class="fa-solid fa-pen"></i> Sửa sản phẩm</button>
      <button class="danger" type="button" onclick='adminRemoveBaseSale(${takumiIdArg(p.id)})'><i class="fa-solid fa-trash"></i> Xóa giảm giá</button>
    </div>
  </div>`;
