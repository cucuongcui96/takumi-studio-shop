function getProductGalleryForColor(product,colorName){
  if(!product)return [];
  const colorImg=(product.colorImages&&product.colorImages[colorName])||product.img;
  const gallery=[colorImg,...(product.galleryImages||[]),product.img].filter(Boolean);
  return [...new Set(gallery)];
}
function renderModalGallery(){
  const img=document.getElementById('modalImg');
  const thumbs=document.getElementById('modalThumbs');
  const prev=document.getElementById('modalPrevBtn');
  const next=document.getElementById('modalNextBtn');
  if(!img||!thumbs)return;
  if(!modalGallery.length)modalGallery=[currentProduct?.img].filter(Boolean);
  if(modalGalleryIndex<0)modalGalleryIndex=modalGallery.length-1;
  if(modalGalleryIndex>=modalGallery.length)modalGalleryIndex=0;
  img.src=modalGallery[modalGalleryIndex]||'';
  const showControls=modalGallery.length>1;
  if(prev)prev.classList.toggle('is-hidden',!showControls);
  if(next)next.classList.toggle('is-hidden',!showControls);
  thumbs.innerHTML=modalGallery.map((src,i)=>`<button class="modal-thumb ${i===modalGalleryIndex?'active':''}" onclick="event.stopPropagation();modalSetImage(${i})"><img src="${src}" alt="Ảnh sản phẩm ${i+1}" loading="lazy"></button>`).join('');
}
function modalSetImage(i){modalGalleryIndex=i;renderModalGallery()}
function modalPrevImage(){modalGalleryIndex--;renderModalGallery()}
function modalNextImage(){modalGalleryIndex++;renderModalGallery()}



function relatedProductList(product){
  if(!product)return [];
  const sameType=products.filter(p=>p.id!==product.id && p.type===product.type);
  const hot=products.filter(p=>p.id!==product.id && p.filter==='hot' && !sameType.some(x=>x.id===p.id));
  const others=products.filter(p=>p.id!==product.id && !sameType.some(x=>x.id===p.id) && !hot.some(x=>x.id===p.id));
  return [...sameType,...hot,...others].slice(0,4);
}
function renderRelatedProducts(){
  const box=document.getElementById('relatedProducts');
  if(!box||!currentProduct)return;
  const list=relatedProductList(currentProduct);
  box.innerHTML=list.map(p=>{
    const c=(p.selectedColor||p.colors?.[0]||{name:'',cls:''});
    const colorName=typeof c==='string'?c:c.name;
    const colorCls=typeof c==='string'?'':(c.cls||'');
    const img=takumiCardDisplayImage(p,colorName);
    const typeLabel=p.type==='decor'?'Decor':p.type==='figure'?'Figure':'Tượng';
    return `<article class="related-card" onclick="openRelatedProduct(${p.id})">
      <div class="related-img ${colorCls}"><img src="${img}" alt="${escapeAttr(p.name)}" loading="lazy"><span class="related-badge">${typeLabel}</span></div>
      <div class="related-info"><b>${escapeAttr(p.name)}</b><span>Từ ${money(p.price)}</span></div>
    </article>`;
  }).join('');
}
function openRelatedProduct(id){
  currentProduct=products.find(p=>p.id===id);
  if(!currentProduct)return;
  selectedSize='10cm';
  selectedColor=(currentProduct.selectedColor||currentProduct.colors[0]).name;
  selectedQuantity=1;
  updateModal();
  const card=document.querySelector('#productModal .modal-card');
  if(card)card.scrollTo({top:0,behavior:'smooth'});
}

function renderProductReviews(){
  if(!currentProduct)return;
  const list=allReviews(currentProduct);
  const avg=reviewAverageValue(currentProduct);
  const avgEl=document.getElementById('reviewAverage');
  const starsEl=document.getElementById('reviewAverageStars');
  const soldEl=document.getElementById('reviewSold');
  const listEl=document.getElementById('reviewList');
  if(avgEl)avgEl.innerHTML=`${avg.toFixed(1)} <small>/5</small>`;
  if(starsEl)starsEl.innerHTML=starText(avg);
  if(soldEl)soldEl.innerHTML=`<i class="fa-solid fa-bag-shopping"></i>Đã bán ${productSold(currentProduct)}`;
  if(listEl){
    listEl.innerHTML=list.length?list.map(r=>`<div class="review-card">
      <div class="review-card-head"><div><b>${escapeAttr(r.name||'Khách hàng')}</b><div class="review-stars">${starText(r.rating||5)}</div></div><small>${escapeAttr(r.date||'Mới đây')}</small></div>
      <p>${escapeAttr(r.comment||'')}</p>
      ${r.images&&r.images.length?`<div class="review-photos">${r.images.map(src=>`<img src="${src}" onclick="openReviewPhoto('${src}')" alt="Ảnh đánh giá">`).join('')}</div>`:''}
    </div>`).join(''):`<div class="review-empty">Chưa có bình luận. Hãy là người đầu tiên đánh giá sản phẩm này.</div>`;
  }
}
function submitProductReview(e){
  e.preventDefault();
  if(!currentProduct)return;
  const name=document.getElementById('reviewName').value.trim();
  const rating=Number(document.getElementById('reviewRating').value||5);
  const comment=document.getElementById('reviewComment').value.trim();
  if(!name||!comment){alert('Bạn nhập tên và bình luận giúp mình nhé.');return;}
  const list=getStoredReviews(currentProduct.id);
  list.unshift({name,rating,comment,images:pendingReviewImages.slice(0,5),date:new Date().toLocaleDateString('vi-VN')});
  localStorage.setItem(reviewKey(currentProduct.id),JSON.stringify(list.slice(0,50)));
  document.getElementById('reviewName').value='';
  document.getElementById('reviewComment').value='';
  document.getElementById('reviewRating').value='5';
  const imageInput=document.getElementById('reviewImages');if(imageInput)imageInput.value='';
  const preview=document.getElementById('reviewImagePreview');if(preview){preview.innerHTML='';preview.classList.remove('active');}
  pendingReviewImages=[];
  const deliveryEl=document.getElementById('modalDeliveryRange');if(deliveryEl)deliveryEl.textContent=deliveryDateRange();
  renderProductReviews();
  renderRelatedProducts();
}


function pad2(n){return String(n).padStart(2,'0')}
function deliveryDateRange(){
  const start=new Date();
  start.setDate(start.getDate()+1);
  const end=new Date();
  end.setDate(end.getDate()+6);
  return `${pad2(start.getDate())}/${pad2(start.getMonth()+1)} - ${pad2(end.getDate())}/${pad2(end.getMonth()+1)}`;
}

function normalizedQuantity(value){
  const n=parseInt(value,10);
  return Number.isFinite(n)&&n>0?n:1;
}
function syncQuantityInput(){
  const input=document.getElementById('modalQtyInput');
  if(input)input.value=selectedQuantity;
}
function changeSelectedQuantity(delta){
  selectedQuantity=Math.max(1, normalizedQuantity(selectedQuantity)+Number(delta||0));
  syncQuantityInput();
  syncStickyBuybarPrice();
}
function setSelectedQuantity(value){
  selectedQuantity=Math.max(1, normalizedQuantity(value));
  syncQuantityInput();
  syncStickyBuybarPrice();
}
function syncStickyBuybarPrice(){
  const priceEl=document.getElementById('stickyBuyPrice');
  const labelEl=document.getElementById('stickyBuyLabel');
  if(!priceEl||!labelEl||!currentProduct)return;
  if(selectedSize==='Theo yêu cầu'){
    labelEl.textContent='Đặt riêng';
    priceEl.textContent='Liên hệ';
    return;
  }
  const qty=Math.max(1, normalizedQuantity(selectedQuantity));
  labelEl.textContent=qty>1?`Tạm tính · SL ${qty}`:'Giá bán';
  priceEl.textContent=money(productDisplayPriceForSize(currentProduct,selectedSize)*qty);
}
function updateModal(){
  const c=currentProduct.colors.find(x=>x.name===selectedColor)||currentProduct.colors[0];
  const modalMedia=document.querySelector('.modal-media');
  modalMedia.classList.remove('color-white','color-gray','color-gold','color-black');
  modalMedia.classList.add(c.cls);
  modalGallery=takumiProductGallery(currentProduct,c.name);modalGalleryIndex=0;softSwapModalImage();
  document.getElementById('modalImg').className=c.cls;
  document.getElementById('modalType').textContent=currentProduct.type==='decor'?'Takumi Decor':currentProduct.type==='figure'?'Custom Figure':'Zen Collection';
  document.getElementById('modalName').textContent=currentProduct.name;
  document.getElementById('modalDesc').innerHTML=`<strong style="color:#2C2A28">${currentProduct.short}</strong>`;
  const longDesc=document.getElementById('modalLongDesc');if(longDesc)longDesc.textContent=currentProduct.longDesc||currentProduct.desc||currentProduct.short||'';
  const selectedColorLabel=document.getElementById('selectedColorLabel');
  if(selectedColorLabel)selectedColorLabel.textContent=c.name;
  const selectedSizeLabel=document.getElementById('selectedSizeLabel');
  if(selectedSizeLabel)selectedSizeLabel.textContent=selectedSize==='Theo yêu cầu'?'Đặt riêng':selectedSize;

  const sizeFromVariants=[...new Set((currentProduct.variants||[]).map(v=>String(v.size||'').trim()).filter(Boolean))];
  const modalSizeOptions=[...(sizeFromVariants.length?sizeFromVariants:['10cm','15cm','20cm']),'Theo yêu cầu'];
  document.getElementById('colorChips').innerHTML=currentProduct.colors.map(color=>{
    const active=color.name===selectedColor;
    return `<button type="button" class="color-choice ${active?'active':''}" onclick="selectedColor='${escapeAttr(color.name)}';updateModal()"><b>${escapeAttr(color.name)}</b></button>`;
  }).join('');
  document.getElementById('sizeChips').innerHTML=modalSizeOptions.map(s=>{
    const active=s===selectedSize;
    const label=s==='Theo yêu cầu'?'Đặt riêng':s;
    return `<button type="button" class="size-choice ${active?'active':''}" onclick="selectedSize='${s}';updateModal()"><span class="size-name">${label}</span></button>`;
  }).join('');
  const styles=takumiVariantStyles(currentProduct);
  const styleBlock=document.getElementById('styleOptionBlock');
  const styleChips=document.getElementById('styleChips');
  const selectedStyleLabel=document.getElementById('selectedStyleLabel');
  if(styleBlock&&styleChips){
    styleBlock.classList.toggle('active',styles.length>1);
    styleBlock.style.display=styles.length>1?'block':'none';
    if(styles.length){
      if(!styles.includes(selectedStyle))selectedStyle=styles[0];
      if(selectedStyleLabel)selectedStyleLabel.textContent=selectedStyle||'Mặc định';
      styleChips.innerHTML=styles.map(st=>`<button type="button" class="size-choice ${st===selectedStyle?'active':''}" onclick="selectedStyle='${escapeAttr(st)}';updateModal()"><span class="size-name">${escapeAttr(st)}</span></button>`).join('');
    }else{
      selectedStyle='';
      if(selectedStyleLabel)selectedStyleLabel.textContent='Mặc định';
      styleChips.innerHTML='';
    }
  }
  
  const promo=productBestPromoData(currentProduct,selectedSize);
  const final=productDisplayPriceForSize(currentProduct,selectedSize);
  const oldDisplay=productDisplayOldPriceForSize(currentProduct,selectedSize);
  const priceEl=document.getElementById('modalPrice');
  if(selectedSize==='Theo yêu cầu'){
    priceEl.textContent='Liên hệ báo giá';
  }else{
    priceEl.innerHTML=`<div class="promo-price-line"><span>${money(final)}</span>${oldDisplay?`<span class="old-price">${money(oldDisplay)}</span>`:''}${promo?`<span class="discount-note">${escapeAttr(promo.label)}</span>`:''}</div>`;
  }

  // Cập nhật thời gian nhận hàng mỗi lần mở / đổi lựa chọn sản phẩm
  const deliveryEl=document.getElementById('modalDeliveryRange');
  if(deliveryEl) deliveryEl.textContent=deliveryDateRange();
  syncQuantityInput();
  syncStickyBuybarPrice();

  renderProductReviews();
}

