/* === Cart & Checkout === */
.cart-overlay{position:fixed;inset:0;background:rgba(18,17,16,.48);z-index:3800;display:none}
.cart-overlay.active{display:block}
.cart-drawer{position:fixed;top:0;right:-430px;width:min(430px,94vw);height:100vh;background:#fff;z-index:3900;box-shadow:-20px 0 60px rgba(0,0,0,.18);transition:.28s;display:flex;flex-direction:column}
.cart-drawer.active{right:0}
.cart-head{padding:22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}
.cart-head h2{font-size:20px}
.cart-close{font-size:24px;color:#888;cursor:pointer}
.cart-items{flex:1;overflow:auto;padding:18px 22px}
.cart-item{display:grid;grid-template-columns:76px 1fr auto;gap:12px;padding:12px 0;border-bottom:1px solid #eee}
.cart-item img{width:76px;height:76px;object-fit:cover;border-radius:12px;background:#eee}
.cart-item b{display:block;font-size:13px;margin-bottom:4px}
.cart-item small{display:block;color:var(--muted);font-size:12px;line-height:1.45}
.cart-item-price{font-size:13px;font-weight:800;color:var(--olive);white-space:nowrap}
.remove-cart{border:0;background:transparent;color:#b55f55;font-size:12px;font-weight:800;margin-top:6px;cursor:pointer}
.cart-foot{padding:20px 22px;border-top:1px solid var(--line);background:#FAF8F4}
.cart-total{display:flex;justify-content:space-between;align-items:center;font-size:18px;font-weight:800;margin-bottom:14px}
.cart-empty{text-align:center;color:var(--muted);padding:38px 10px;font-size:14px}

.checkout-modal{position:fixed;inset:0;background:rgba(18,17,16,.56);z-index:5200;display:none;align-items:center;justify-content:center;padding:22px;backdrop-filter:blur(10px)}
.checkout-modal.active{display:flex}
.checkout-card{width:min(1120px,96vw);max-height:92vh;overflow:auto;background:linear-gradient(135deg,#fff 0%,#fcfbf8 100%);border:1px solid rgba(229,226,217,.9);border-radius:28px;box-shadow:0 34px 100px rgba(0,0,0,.22);display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);position:relative}
.checkout-card::before{content:"";position:absolute;inset:0;border-radius:28px;pointer-events:none;box-shadow:inset 0 1px 0 rgba(255,255,255,.55)}
.checkout-close{position:absolute;right:18px;top:18px;width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font-size:20px;cursor:pointer;color:#7f796f;background:rgba(255,255,255,.9);border:1px solid rgba(229,226,217,.9);z-index:2;transition:.22s}
.checkout-close:hover{color:var(--ink);border-color:#d8d2c6;background:#fff;transform:rotate(90deg)}
.checkout-left,.checkout-right{padding:34px}
.checkout-right{background:linear-gradient(180deg,#f8f5ef 0%,#f3efe7 100%);border-left:1px solid rgba(229,226,217,.9)}
.checkout-panel-head{margin-bottom:22px;padding-right:34px}
.checkout-kicker{display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.12em;color:var(--olive);background:rgba(122,128,98,.08);border:1px solid rgba(122,128,98,.12);border-radius:999px;padding:8px 11px}
.checkout-panel-head h2{font-size:28px;letter-spacing:-.035em;margin:14px 0 8px}
.checkout-panel-head p{font-size:14px;color:var(--muted);line-height:1.7;max-width:560px}
.checkout-section{background:#fff;border:1px solid rgba(229,226,217,.95);border-radius:22px;padding:20px 20px 18px;box-shadow:0 10px 24px rgba(44,42,40,.04);margin-bottom:14px}
.checkout-section-title{display:flex;align-items:flex-start;gap:12px;margin-bottom:14px}
.checkout-step{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:#fff;font-size:13px;font-weight:800;flex:0 0 auto}
.checkout-section-title b{display:block;font-size:15px;line-height:1.3}
.checkout-section-title small{display:block;font-size:12px;color:var(--muted);line-height:1.45;margin-top:2px}
.checkout-fields-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.checkout-fields-grid .full{grid-column:1 / -1}
.input-group{position:relative;margin-bottom:0}
.input-group i{position:absolute;left:14px;top:14px;color:#9e978d;font-size:13px}
.input-group input,.input-group textarea{width:100%;border:1px solid var(--line);border-radius:14px;padding:13px 14px 13px 40px;outline:none;background:#fcfcfb;font-size:14px;color:var(--ink);transition:.2s}
.input-group textarea{min-height:92px;resize:vertical}
.input-group input:focus,.input-group textarea:focus{border-color:var(--olive);background:#fff;box-shadow:0 0 0 4px rgba(122,128,98,.08)}
.address-box{background:#fcfbf8;border:1px solid rgba(229,226,217,.95);border-radius:16px;padding:14px}
.address-box label{display:block;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.1em;color:#6d675f;margin-bottom:10px}
.payment-methods{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:4px}
.payment-card{display:flex;align-items:flex-start;gap:12px;border:1px solid rgba(229,226,217,.95);background:#fcfcfb;border-radius:18px;padding:15px;cursor:pointer;transition:.22s;min-height:94px}
.payment-card:hover{border-color:#d7d1c5;background:#fff;transform:translateY(-1px)}
.payment-card.active{border-color:var(--ink);background:#fff;box-shadow:0 10px 24px rgba(44,42,40,.06)}
.payment-icon{width:42px;height:42px;border-radius:14px;background:var(--olive);color:#fff;display:grid;place-items:center;font-weight:800;flex:0 0 auto;box-shadow:0 8px 18px rgba(122,128,98,.22)}
.payment-icon.cod{background:#6D7862}.payment-icon.qr{background:#2C2A28;font-size:18px}
.payment-info b{display:block;font-size:14px;line-height:1.35}.payment-info span{display:block;color:var(--muted);font-size:12px;line-height:1.5;margin-top:4px}
.qr-box{display:none;text-align:center;background:#fcfbf8;border:1px solid rgba(229,226,217,.95);border-radius:18px;padding:18px 16px;margin:4px 0 0}
.qr-box.active{display:block}
.qr-box img{width:170px;height:170px;margin:12px auto;border-radius:14px;border:1px solid var(--line);padding:8px;background:#fff;box-shadow:0 12px 24px rgba(44,42,40,.06)}
.qr-box p{font-size:12px;color:var(--muted);line-height:1.6}
.checkout-submit{width:100%;justify-content:center;margin-top:16px;height:50px;border-radius:14px;font-size:14px;box-shadow:0 12px 26px rgba(44,42,40,.12)}
.checkout-side-head{margin-bottom:16px;padding-right:24px}
.checkout-side-head h3{font-size:24px;letter-spacing:-.03em;margin-bottom:8px}
.checkout-side-head p{font-size:13px;color:var(--muted);line-height:1.6}
.checkout-side-card{background:rgba(255,255,255,.78);border:1px solid rgba(229,226,217,.92);border-radius:20px;padding:18px;box-shadow:0 12px 28px rgba(44,42,40,.04);margin-bottom:14px}
.checkout-side-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}
.checkout-side-title b{font-size:14px;letter-spacing:-.01em}
.checkout-side-title span{font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.1em;color:#8b847b}
.summary-list{display:grid;gap:12px;max-height:310px;overflow:auto;margin-bottom:0;padding-right:3px}
.summary-item{display:grid;grid-template-columns:58px 1fr auto;gap:10px;align-items:center;padding:0 0 12px;border-bottom:1px solid #ece8de}
.summary-item:last-child{padding-bottom:0;border-bottom:0}
.summary-item img{width:58px;height:58px;object-fit:cover;border-radius:12px;background:#eee}
.summary-item b{font-size:13px;display:block;line-height:1.4}
.summary-item small{font-size:12px;color:var(--muted);line-height:1.45}
.summary-price{font-size:13px;font-weight:800;white-space:nowrap;color:var(--olive)}
.shipping-note{font-size:13px;color:#5d5a52;line-height:1.7}
.shipping-note b{display:block;margin-bottom:6px;color:var(--ink);font-size:14px}
.checkout-voucher-box{margin:0;padding:18px}
.voucher-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;font-size:12px;font-weight:900;color:#5d5a52;text-transform:uppercase;letter-spacing:.08em}
.voucher-row{display:flex;gap:8px}.voucher-row input{flex:1;border:1px solid var(--line);background:#fff;border-radius:12px;padding:11px 12px;outline:none;font-weight:700;color:var(--ink)}.voucher-row input:focus{border-color:var(--olive);box-shadow:0 0 0 3px rgba(122,128,98,.10)}
.voucher-message{font-size:12px;font-weight:800;margin-top:8px;color:var(--muted)}.voucher-message.success{color:#4D7A50}.voucher-message.error{color:#C92F24}
.auto-voucher-list{display:grid;gap:9px;margin-top:10px}
.auto-voucher-card{display:flex;align-items:center;gap:10px;border:1px solid var(--line);background:#fff;border-radius:14px;padding:11px 12px;cursor:pointer;transition:.2s}
.auto-voucher-card:hover{border-color:var(--olive);box-shadow:0 8px 18px rgba(44,42,40,.06)}
.auto-voucher-card input{width:18px;height:18px;accent-color:var(--olive)}
.auto-voucher-card.disabled{opacity:.48;cursor:not-allowed;background:#f4f2ee}
.auto-voucher-icon{width:34px;height:34px;border-radius:12px;display:grid;place-items:center;background:rgba(122,128,98,.12);color:var(--olive);flex:0 0 auto}
.auto-voucher-info{flex:1}.auto-voucher-info b{display:block;font-size:13px;color:var(--ink)}.auto-voucher-info span{display:block;font-size:12px;color:var(--muted);line-height:1.35}
.auto-voucher-value{font-size:12px;font-weight:900;color:#C92F24;background:rgba(233,71,53,.08);border-radius:999px;padding:5px 8px;white-space:nowrap}
.shipping-select-note{font-size:12px;color:var(--muted);line-height:1.55;margin-top:10px}
.checkout-breakdown{display:grid;gap:10px;margin:0}
.checkout-line{display:flex;justify-content:space-between;align-items:center;font-size:13px;color:#5d5a52;font-weight:800}
.checkout-line.discount{color:#C92F24}
.checkout-total{display:flex;justify-content:space-between;align-items:center;border-top:1px dashed #cfc8bb;padding-top:14px;margin-top:14px;font-size:20px;font-weight:900}
.checkout-total span:last-child{color:var(--ink)}
@media(max-width:980px){.payment-methods,.checkout-fields-grid{grid-template-columns:1fr}.checkout-card{grid-template-columns:1fr}.checkout-right{border-left:0;border-top:1px solid rgba(229,226,217,.9)}.checkout-left,.checkout-right{padding:24px}.checkout-panel-head h2{font-size:24px}.cart-drawer{width:100vw;right:-100vw}}
@media(max-width:640px){.checkout-modal{padding:10px}.checkout-card{border-radius:22px;max-height:95vh}.checkout-close{right:12px;top:12px}.checkout-left,.checkout-right{padding:18px}.checkout-section,.checkout-side-card{padding:14px}.payment-card{min-height:auto}.checkout-panel-head{padding-right:24px}}



.featured-picks{padding-top:34px;padding-bottom:30px;background:linear-gradient(180deg,rgba(255,255,255,.65),rgba(247,244,238,0))}
.featured-wrap{display:grid;grid-template-columns:1.05fr 2.1fr;gap:22px;align-items:stretch}
.featured-copy{background:#fff;border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:var(--shadow)}
.featured-copy h2{font-size:30px;margin:6px 0 10px}.featured-copy p{color:var(--muted);font-size:14px;line-height:1.7}
.featured-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.featured-mini{background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;cursor:pointer;transition:.25s;box-shadow:0 8px 24px rgba(44,42,40,.04)}
.featured-mini:hover{transform:translateY(-4px);box-shadow:0 16px 34px rgba(44,42,40,.075)}
.featured-mini-img{height:220px;background:#e5e2d9;position:relative;overflow:hidden}.featured-mini-img img{width:100%;height:100%;object-fit:cover;transition:.45s}.featured-mini:hover img{transform:scale(1.045)}
.featured-mini-info{padding:14px}.featured-mini-info h3{font-size:15px;margin-bottom:7px}.featured-mini-info p{font-size:12px;color:var(--muted);line-height:1.45;min-height:34px;margin-bottom:8px}.featured-mini-price{font-size:14px;color:var(--olive);font-weight:800}
.zalo-primary{background:#0068FF!important;color:#fff!important}.zalo-primary:hover{background:#0056D6!important}
.product-img.color-white::after,.product-img.color-gray::after,.product-img.color-gold::after,.product-img.color-black::after,.featured-mini-img.color-white::after,.featured-mini-img.color-gray::after,.featured-mini-img.color-gold::after,.featured-mini-img.color-black::after,.modal-media::after{content:"";position:absolute;inset:0;pointer-events:none;mix-blend-mode:multiply;opacity:.16}
.product-img.color-white::after,.featured-mini-img.color-white::after{background:#fff;opacity:.05}.product-img.color-gray::after,.featured-mini-img.color-gray::after{background:#7d7d78;opacity:.22}.product-img.color-gold::after,.featured-mini-img.color-gold::after{background:#c7a65c;opacity:.20}.product-img.color-black::after,.featured-mini-img.color-black::after{background:#151515;opacity:.36}
.modal-media{position:relative}.modal-media.color-white::after{background:#fff;opacity:.05}.modal-media.color-gray::after{background:#7d7d78;opacity:.22}.modal-media.color-gold::after{background:#c7a65c;opacity:.20}.modal-media.color-black::after{background:#151515;opacity:.36}
@media(max-width:900px){.featured-wrap{grid-template-columns:1fr}.featured-grid{grid-template-columns:repeat(3,1fr)}.featured-mini-img{height:190px}}
@media(max-width:620px){.featured-grid{grid-template-columns:1fr 1fr}.featured-copy{padding:18px}.featured-copy h2{font-size:24px}.featured-mini-img{height:180px}.featured-mini:nth-child(3){display:none}}


/* === Admin Product Manager - Large Dashboard === */
.admin-modal{position:fixed;inset:0;background:rgba(18,17,16,.62);z-index:7000;display:none;align-items:center;justify-content:center;padding:10px;backdrop-filter:blur(8px)}
.admin-modal.active{display:flex}
.admin-panel{width:min(1560px,99vw);height:min(94vh,980px);max-height:96vh;overflow:hidden;background:#fff;border-radius:24px;box-shadow:0 34px 100px rgba(0,0,0,.30);display:grid;grid-template-rows:auto 1fr}
.admin-head{padding:20px 26px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:16px;background:linear-gradient(135deg,#FAF8F4,#EEF0E8)}
.admin-head h2{font-size:25px}.admin-head p{color:var(--muted);font-size:13px;margin-top:5px}
.admin-close{font-size:26px;color:#888;cursor:pointer;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#fff;border:1px solid var(--line)}
.admin-close:hover{color:var(--ink);border-color:var(--ink)}
.admin-body{overflow:auto;padding:22px;background:#F7F4EE}
.admin-login{max-width:460px;margin:54px auto;background:#fff;border:1px solid var(--line);border-radius:20px;padding:26px;box-shadow:var(--shadow)}
.admin-login input,.admin-form input,.admin-form textarea,.admin-form select{width:100%;border:1px solid var(--line);border-radius:13px;padding:13px 14px;outline:none;background:#fff;font-size:14px}
.admin-login input:focus,.admin-form input:focus,.admin-form textarea:focus,.admin-form select:focus{border-color:var(--olive);box-shadow:0 0 0 3px rgba(122,128,98,.10)}
.admin-grid{display:grid;grid-template-columns:300px minmax(520px,1fr) 430px;gap:18px;align-items:start}
.admin-card{background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow);overflow:hidden}
.admin-card-title{padding:17px 18px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:10px;background:#fff}
.admin-card-title h3{font-size:18px}.admin-card-title span{font-size:12px;color:var(--muted);font-weight:700}
.admin-products{padding:12px;display:grid;gap:10px;max-height:calc(94vh - 170px);overflow:auto}
.admin-product-row{display:grid;grid-template-columns:70px 1fr;gap:12px;align-items:center;border:1px solid #eee;border-radius:16px;padding:10px;background:#FAF8F4;cursor:pointer;transition:.2s}
.admin-product-row:hover{border-color:var(--olive);background:#fff}
.admin-product-row.active{border-color:var(--olive);box-shadow:0 0 0 3px rgba(122,128,98,.10);background:#fff}
.admin-product-row img{width:70px;height:70px;object-fit:cover;border-radius:13px;background:#e5e2d9}
.admin-product-row b{font-size:13px;display:block;line-height:1.35}.admin-product-row small{font-size:11px;color:var(--muted);display:block;margin-top:4px;line-height:1.4}
.admin-row-actions{grid-column:1 / -1;display:flex;gap:7px;justify-content:flex-end}
.admin-mini-btn{border-radius:10px;padding:9px 11px;font-size:12px;font-weight:800;cursor:pointer;background:#fff;border:1px solid var(--line);color:var(--ink)}
.admin-mini-btn:hover{border-color:var(--olive);color:var(--olive)}
.admin-mini-btn.danger{color:#b55f55}.admin-mini-btn.danger:hover{border-color:#b55f55;background:#fff6f5}
.admin-form{padding:18px;display:grid;gap:14px}
.admin-section{border:1px solid #eee;background:#FAF8F4;border-radius:18px;padding:15px}
.admin-section-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px}
.admin-section-head b{font-size:14px}.admin-section-head span{font-size:12px;color:var(--muted)}
.admin-two{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.admin-three{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.admin-field label{display:block;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#5d5a52;margin-bottom:7px}
.admin-form textarea{min-height:180px;resize:vertical;line-height:1.7;white-space:pre-wrap}
.admin-actions{display:flex;gap:10px;flex-wrap:wrap;position:sticky;bottom:0;background:linear-gradient(180deg,rgba(255,255,255,.76),#fff);padding:12px;border:1px solid var(--line);border-radius:16px;z-index:5}
.admin-tools{display:flex;gap:8px;flex-wrap:wrap}
.admin-muted{font-size:12px;color:var(--muted);line-height:1.55}
.admin-image-tools{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:end}
.admin-file-button,.admin-color-upload{border:1px dashed var(--olive);border-radius:12px;padding:11px 12px;font-size:12px;font-weight:800;color:var(--olive);background:#F7F8F2;cursor:pointer;text-align:center;white-space:nowrap;display:inline-flex;align-items:center;justify-content:center}
.admin-file-button input,.admin-color-upload input{display:none}

.admin-category-list{display:grid;gap:9px;margin-top:10px}
.admin-category-row{display:grid;grid-template-columns:1fr 1fr auto;gap:8px;align-items:center;border:1px solid #ece8de;background:#fff;border-radius:14px;padding:10px}
.admin-category-row input{padding:10px 12px}
.admin-category-row small{font-size:11px;color:var(--muted);font-weight:700}

.admin-gallery-list{display:grid;gap:10px;margin-top:10px}
.admin-gallery-row{display:grid;grid-template-columns:1fr auto auto auto;gap:8px;align-items:center;border:1px solid #ece8de;background:#fff;border-radius:14px;padding:10px}
.admin-gallery-row input{padding:10px 12px}
.admin-gallery-thumb,.admin-color-thumb{width:52px;height:52px;border-radius:12px;overflow:hidden;border:1px solid var(--line);background:#e5e2d9;display:grid;place-items:center}
.admin-gallery-thumb img,.admin-color-thumb img{width:100%;height:100%;object-fit:cover}
.admin-color-list{display:grid;gap:10px}
.admin-color-row{display:grid;grid-template-columns:minmax(130px,.8fr) 130px minmax(230px,1.4fr) auto;gap:10px;align-items:start;border:1px solid #ece8de;background:#fff;border-radius:16px;padding:12px}
.admin-color-label-mini{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#8a837b;margin-bottom:6px}
.admin-color-row input[type="text"]{padding:10px 12px}
.admin-color-picker-wrap{display:flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:7px 9px}
.admin-color-picker-wrap input[type="color"]{width:42px;height:34px;border:0;background:transparent;padding:0;cursor:pointer}
.admin-color-hex{font-size:11px;font-weight:800;color:#6d675f;text-transform:uppercase;min-width:62px}
.admin-color-image-tools{display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:end}
.admin-color-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.admin-preview-panel{position:sticky;top:0}
.admin-web-preview{padding:16px;background:#FAF8F4}
.admin-web-preview-title{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:14px;font-size:12px;font-weight:800;color:#5d5a52;text-transform:uppercase;letter-spacing:.08em}
.admin-live-card{background:transparent;margin:auto}
.admin-live-img{height:460px;background:#E5E2D9;border-radius:18px;overflow:hidden;margin-bottom:16px;position:relative;box-shadow:0 12px 34px rgba(44,42,40,.08)}
.admin-live-img img{width:100%;height:100%;object-fit:cover}
.admin-live-badges{position:absolute;inset:14px 14px auto 14px;display:flex;justify-content:space-between;gap:8px;pointer-events:none}
.admin-live-title{font-size:22px;font-weight:800;margin-bottom:7px;letter-spacing:-.03em}
.admin-live-short{font-size:14px;color:var(--muted);line-height:1.55;min-height:42px;margin-bottom:12px}
.admin-live-price{display:flex;align-items:baseline;gap:10px;margin-bottom:10px}
.admin-live-price b{font-size:20px;color:var(--olive)}
.admin-live-price span{font-size:13px;color:#a39d96;text-decoration:line-through;font-weight:700}.admin-live-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:8px 0 10px}
.admin-preview-swatches{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
.admin-preview-swatch{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:#fff;border-radius:999px;padding:7px 10px;font-size:12px;font-weight:800;color:#5d5a52;cursor:pointer}
.admin-preview-swatch.active{border-color:var(--olive);background:var(--soft2);color:var(--olive)}
.admin-preview-gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}
.admin-preview-gallery img{height:70px;width:100%;object-fit:cover;border-radius:10px;border:1px solid var(--line);background:#e5e2d9;cursor:pointer}
.admin-code-output{display:none;margin-top:10px}
.admin-code-output.active{display:block}
.admin-code-output textarea{width:100%;min-height:320px;border:1px solid var(--line);border-radius:14px;padding:12px;background:#fff;font-family:Consolas,Monaco,monospace;font-size:12px;line-height:1.45;resize:vertical}

@media(max-width:1180px){.admin-grid{grid-template-columns:280px 1fr}.admin-preview-panel{grid-column:1 / -1;position:relative}.admin-live-img{height:380px}}
@media(max-width:900px){.admin-grid{grid-template-columns:1fr}.admin-two,.admin-three,.admin-color-row,.admin-gallery-row,.admin-category-row{grid-template-columns:1fr}.admin-color-image-tools{grid-template-columns:1fr auto auto}.admin-head{align-items:flex-start}.admin-products{max-height:none}.admin-panel{height:96vh}.admin-live-img{height:340px}}



.admin-discount-preview{display:inline-flex;align-items:center;gap:6px;margin-top:8px;background:rgba(233,71,53,.08);border:1px solid rgba(233,71,53,.16);color:#C92F24;border-radius:999px;padding:7px 10px;font-size:12px;font-weight:900}
.auto-voucher-list{display:grid;gap:9px;margin-top:10px}
.auto-voucher-card{display:flex;align-items:center;gap:10px;border:1px solid var(--line);background:#fff;border-radius:14px;padding:11px 12px;cursor:pointer;transition:.2s}
.auto-voucher-card:hover{border-color:var(--olive);box-shadow:0 8px 18px rgba(44,42,40,.06)}
.auto-voucher-card input{width:18px;height:18px;accent-color:var(--olive)}
.auto-voucher-card.disabled{opacity:.48;cursor:not-allowed;background:#f4f2ee}
.auto-voucher-icon{width:34px;height:34px;border-radius:12px;display:grid;place-items:center;background:rgba(122,128,98,.12);color:var(--olive);flex:0 0 auto}
.auto-voucher-info{flex:1}
.auto-voucher-info b{display:block;font-size:13px;color:var(--ink)}
.auto-voucher-info span{display:block;font-size:12px;color:var(--muted);line-height:1.35}
.auto-voucher-value{font-size:12px;font-weight:900;color:#C92F24;background:rgba(233,71,53,.08);border-radius:999px;padding:5px 8px;white-space:nowrap}
.checkout-breakdown{display:grid;gap:8px;margin:12px 0}
.checkout-line{display:flex;justify-content:space-between;align-items:center;font-size:13px;color:#5d5a52;font-weight:800}
.checkout-line.discount{color:#C92F24}
.shipping-select-note{font-size:12px;color:var(--muted);line-height:1.45;margin-top:8px}


.admin-promo-suite{grid-column:1 / -1;background:linear-gradient(180deg,#fff,#FAF8F4);border:1px solid var(--line);border-radius:20px;padding:18px;margin-top:14px;box-shadow:0 10px 28px rgba(44,42,40,.045)}
.admin-promo-suite-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:14px}
.admin-promo-suite-head h3{font-size:20px;margin-bottom:5px}
.admin-promo-suite-head p{font-size:13px;color:var(--muted);line-height:1.55}
.admin-promo-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 16px}
.admin-promo-tab{border:1px solid var(--line);background:#fff;color:#5d5a52;border-radius:999px;padding:9px 12px;font-size:12px;font-weight:900;cursor:pointer}
.admin-promo-tab.active,.admin-promo-tab:hover{background:var(--ink);border-color:var(--ink);color:#fff}
.admin-promo-panel{display:none}.admin-promo-panel.active{display:block}
.admin-quick-programs{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:12px 0 14px}
.admin-quick-program{border:1px solid var(--line);background:#fff;border-radius:16px;padding:13px;cursor:pointer;transition:.2s}
.admin-quick-program:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(44,42,40,.07);border-color:var(--olive)}
.admin-quick-program b{display:block;font-size:13px;margin-bottom:4px}.admin-quick-program span{font-size:12px;color:var(--muted);line-height:1.45}
.admin-program-status{display:inline-flex;align-items:center;gap:5px;border-radius:999px;padding:5px 8px;font-size:11px;font-weight:900;margin-top:6px}
.admin-program-status.active{background:rgba(75,128,82,.10);color:#4D7A50}
.admin-program-status.scheduled{background:rgba(196,154,69,.13);color:#9B732B}
.admin-program-status.expired{background:rgba(185,95,85,.10);color:#B95F55}
.admin-program-empty{border:1px dashed #ddd;background:#fff;border-radius:14px;padding:14px;text-align:center;color:var(--muted);font-size:13px}
.admin-program-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:8px 0 12px}
.admin-program-toolbar small{color:var(--muted);font-weight:700}
@media(max-width:900px){.admin-quick-programs{grid-template-columns:1fr}.admin-promo-suite-head{flex-direction:column}}



/* === Admin UI Refresh 2026 - clearer, cleaner dashboard === */
.admin-modal{padding:14px;background:radial-gradient(circle at top left,rgba(122,128,98,.32),transparent 34%),rgba(18,17,16,.62)}
.admin-panel{width:min(1640px,98vw);height:min(95vh,1020px);border-radius:28px;background:#F6F2EA;border:1px solid rgba(255,255,255,.55);box-shadow:0 40px 120px rgba(0,0,0,.34)}
.admin-head{padding:18px 22px;background:linear-gradient(135deg,#2C2A28 0%,#4D5140 52%,#7A8062 100%);color:#fff;border-bottom:0;position:relative;overflow:hidden}
.admin-head::after{content:"";position:absolute;right:-70px;top:-110px;width:260px;height:260px;border-radius:50%;background:rgba(255,255,255,.10);pointer-events:none}
.admin-brand-block{display:flex;align-items:center;gap:14px;position:relative;z-index:1}
.admin-brand-icon{width:52px;height:52px;border-radius:18px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.22);display:grid;place-items:center;font-size:22px;box-shadow:inset 0 1px 0 rgba(255,255,255,.14)}
.admin-kicker{font-size:10px!important;text-transform:uppercase;letter-spacing:.18em;font-weight:900;color:rgba(255,255,255,.68)!important;margin:0 0 4px!important}
.admin-head h2{font-size:27px;color:#fff;margin:0}.admin-head p{color:rgba(255,255,255,.76);margin-top:5px}
.admin-head-actions{display:flex;align-items:center;gap:10px;position:relative;z-index:2}
.admin-top-btn{height:42px;border-radius:999px;padding:0 14px;background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.22);color:#fff;font-size:12px;font-weight:900;cursor:pointer;display:inline-flex;align-items:center;gap:7px;transition:.2s}
.admin-top-btn:hover{background:rgba(255,255,255,.22);transform:translateY(-1px)}.admin-top-btn.primary{background:#fff;color:#2C2A28;border-color:#fff;box-shadow:0 10px 24px rgba(0,0,0,.16)}
.admin-close{background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.22);color:#fff}.admin-close:hover{background:#fff;color:#2C2A28;border-color:#fff}
.admin-body{padding:18px;background:linear-gradient(180deg,#F7F4EE 0%,#EFECE4 100%)}
.admin-login{border-radius:24px;border:1px solid rgba(229,226,217,.95);box-shadow:0 24px 70px rgba(44,42,40,.12)}
.admin-grid{grid-template-columns:320px minmax(620px,1fr) 430px;gap:18px;align-items:start}
.admin-card,.admin-promo-suite{border:1px solid rgba(229,226,217,.95);border-radius:24px;background:rgba(255,255,255,.86);box-shadow:0 14px 40px rgba(44,42,40,.07);backdrop-filter:blur(10px)}
.admin-card-title{padding:16px 18px;background:linear-gradient(180deg,#fff,#FAF8F4);border-bottom:1px solid rgba(229,226,217,.9)}
.admin-card-title h3{display:flex;align-items:center;gap:9px;font-size:17px}.admin-card-title h3 i{color:var(--olive)}
.admin-products{padding:14px;gap:12px;max-height:calc(95vh - 175px)}
.admin-product-row{grid-template-columns:74px 1fr;border-radius:18px;background:#fff;border:1px solid #EEE9DF;box-shadow:0 7px 18px rgba(44,42,40,.035)}
.admin-product-row:hover{transform:translateY(-2px);box-shadow:0 14px 26px rgba(44,42,40,.075)}
.admin-product-row.active{border-color:var(--olive);box-shadow:0 0 0 4px rgba(122,128,98,.12),0 14px 26px rgba(44,42,40,.07)}
.admin-product-row img{width:74px;height:74px;border-radius:15px}.admin-product-row b{font-size:13.5px}.admin-product-row small{font-size:11.5px}
.admin-form{padding:18px;gap:16px}
.admin-section{position:relative;background:#fff;border:1px solid #ECE7DD;border-radius:22px;padding:18px;box-shadow:0 8px 24px rgba(44,42,40,.035)}
.admin-section::before{content:"";position:absolute;left:0;top:22px;bottom:22px;width:4px;border-radius:0 999px 999px 0;background:linear-gradient(180deg,var(--olive),#C49A45);opacity:.78}
.admin-section-head{margin-bottom:14px;padding-left:2px}.admin-section-head b{display:flex;align-items:center;gap:9px;font-size:15px}.admin-section-head span:not(.admin-step){font-size:12px;color:#8b857d}
.admin-step{width:24px;height:24px;border-radius:9px;background:var(--olive);color:#fff;display:inline-grid;place-items:center;font-size:12px;font-weight:900;box-shadow:0 6px 14px rgba(122,128,98,.20)}
.admin-field label{font-size:10px;color:#6b665f;margin-bottom:8px}.admin-login input,.admin-form input,.admin-form textarea,.admin-form select{border-radius:14px;border-color:#E7E2D8;background:#FFFEFC;transition:.18s;box-shadow:inset 0 1px 0 rgba(255,255,255,.6)}
.admin-login input:focus,.admin-form input:focus,.admin-form textarea:focus,.admin-form select:focus{background:#fff;border-color:var(--olive);box-shadow:0 0 0 4px rgba(122,128,98,.11)}
.admin-form textarea{min-height:230px}.admin-help{margin-top:8px;color:#7f786f;font-size:12px;line-height:1.55}.admin-help i{color:var(--olive);margin-right:5px}
.admin-mini-btn,.admin-main-btn{border-radius:999px}.admin-main-btn{background:var(--ink);color:#fff;border:0;padding:12px 16px;font-size:13px;font-weight:900;cursor:pointer;display:inline-flex;align-items:center;gap:8px;justify-content:center}.admin-main-btn:hover{background:var(--olive)}
.admin-file-button,.admin-color-upload{border-radius:14px;background:#F5F7EF;border-color:rgba(122,128,98,.48)}
.admin-category-row,.admin-gallery-row,.admin-color-row{border-radius:16px;background:#FFFEFC;border-color:#EEE9DF;box-shadow:0 5px 14px rgba(44,42,40,.025)}
.admin-actions{border-radius:20px;background:rgba(255,255,255,.92);box-shadow:0 -12px 30px rgba(44,42,40,.075);backdrop-filter:blur(12px);border-color:#EEE9DF}.admin-actions .btn-dark{background:var(--olive)}.admin-actions .btn-dark:hover{background:var(--ink)}
.admin-preview-panel{position:sticky;top:0;overflow:hidden}.admin-web-preview{padding:16px;background:linear-gradient(180deg,#F8F6F1,#EFECE4)}
.admin-web-preview-title{background:#fff;border:1px solid #ECE7DD;border-radius:16px;padding:10px 12px;letter-spacing:.06em}
.admin-live-img{height:430px;border-radius:22px;box-shadow:0 18px 42px rgba(44,42,40,.11)}.admin-live-title{font-size:21px}.admin-preview-gallery img{height:76px;border-radius:12px}
.admin-promo-suite{grid-column:1 / -1;padding:18px;margin-top:0;background:rgba(255,255,255,.9)}
.admin-promo-suite-head{background:linear-gradient(135deg,#FAF8F4,#F0F1EA);border:1px solid #ECE7DD;border-radius:20px;padding:16px;margin-bottom:14px}.admin-promo-suite-head h3{font-size:20px}.admin-promo-suite-head h3 i{color:var(--olive)}
.admin-quick-program{background:#fff;border-radius:18px;box-shadow:0 8px 20px rgba(44,42,40,.035)}.admin-promo-tab{padding:10px 14px}.admin-promo-card{border-radius:18px;box-shadow:0 8px 22px rgba(44,42,40,.035)}
@media(max-width:1320px){.admin-grid{grid-template-columns:300px minmax(560px,1fr)}.admin-preview-panel{grid-column:1 / -1;position:relative}.admin-live-img{height:360px}}
@media(max-width:900px){.admin-head{align-items:flex-start;flex-direction:column}.admin-head-actions{width:100%;flex-wrap:wrap}.admin-top-btn{flex:1;justify-content:center}.admin-grid{grid-template-columns:1fr}.admin-section{padding:16px}.admin-section::before{top:18px;bottom:18px}.admin-form textarea{min-height:200px}}
@media(max-width:560px){.admin-modal{padding:0}.admin-panel{width:100vw;height:100vh;max-height:100vh;border-radius:0}.admin-body{padding:12px}.admin-brand-icon{display:none}.admin-head h2{font-size:22px}.admin-top-btn{height:40px;font-size:11px}.admin-card,.admin-section,.admin-promo-suite{border-radius:18px}.admin-card-title{padding:14px}.admin-products,.admin-form{padding:12px}.admin-live-img{height:300px}}

/* === Admin product browser: search/filter/table list === */
.admin-list-tools{padding:14px;border-bottom:1px solid rgba(229,226,217,.9);background:#FFFEFC;display:grid;gap:10px}
.admin-list-search{position:relative}
.admin-list-search i{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#9b948b;font-size:12px}
.admin-list-search input{width:100%;border:1px solid #E7E2D8;background:#fff;border-radius:14px;padding:12px 12px 12px 36px;outline:none;font-size:13px;font-weight:700;color:var(--ink)}
.admin-list-search input:focus{border-color:var(--olive);box-shadow:0 0 0 4px rgba(122,128,98,.10)}
.admin-list-filters{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.admin-list-filters select{width:100%;border:1px solid #E7E2D8;background:#fff;border-radius:13px;padding:10px 11px;outline:none;font-size:12px;font-weight:800;color:#5d5a52}
.admin-list-mode{display:flex;gap:7px;background:#F7F4EE;border:1px solid #EEE9DF;border-radius:999px;padding:4px}
.admin-list-mode button{flex:1;border-radius:999px;background:transparent;padding:8px 10px;font-size:11px;font-weight:900;color:#7d766d;cursor:pointer}
.admin-list-mode button.active{background:#fff;color:var(--ink);box-shadow:0 5px 12px rgba(44,42,40,.06)}
.admin-list-result{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:11px;color:#837c73;font-weight:800}
.admin-clear-search{border:0;background:transparent;color:var(--olive);font-weight:900;cursor:pointer;font-size:11px}
.admin-products.list-mode{gap:8px}
.admin-product-row.compact{grid-template-columns:54px 1fr auto;gap:10px;padding:9px;border-radius:15px}
.admin-product-row.compact img{width:54px;height:54px;border-radius:12px}
.admin-product-row.compact b{font-size:12.5px;line-height:1.25}
.admin-product-row.compact small{font-size:10.5px;margin-top:3px}
.admin-product-row.compact .admin-row-actions{grid-column:auto;align-self:center;display:flex;gap:5px}
.admin-product-row.compact .admin-mini-btn{padding:7px 9px;font-size:11px}
.admin-list-empty{padding:28px 14px;text-align:center;border:1px dashed #DDD4C7;border-radius:18px;background:#fff;color:var(--muted);font-size:13px;line-height:1.6}
.admin-list-empty i{display:block;font-size:24px;color:var(--olive);margin-bottom:8px}
@media(max-width:560px){.admin-list-filters{grid-template-columns:1fr}.admin-product-row.compact{grid-template-columns:48px 1fr}.admin-product-row.compact .admin-row-actions{grid-column:1 / -1;justify-content:flex-end}}


/* === Hiệu ứng thêm vào giỏ: ảnh bay về icon giỏ hàng === */
.cart-fly-img{position:fixed;z-index:99999;width:86px;height:86px;object-fit:cover;border-radius:16px;box-shadow:0 16px 34px rgba(44,42,40,.24);pointer-events:none;will-change:transform,opacity}
.cart-count.bump{animation:cartBump .48s ease}
@keyframes cartBump{0%{transform:scale(1)}35%{transform:scale(1.38)}70%{transform:scale(.92)}100%{transform:scale(1)}}
.cart-added-toast{position:fixed;right:6%;top:76px;z-index:9000;background:#fff;border:1px solid var(--line);box-shadow:0 14px 38px rgba(44,42,40,.14);border-radius:999px;padding:10px 14px;display:flex;align-items:center;gap:9px;font-size:13px;font-weight:900;color:var(--ink);opacity:0;transform:translateY(-8px);pointer-events:none;transition:.22s}
.cart-added-toast.show{opacity:1;transform:translateY(0)}
.cart-added-toast i{color:#00BFA5}
@media(max-width:520px){.cart-fly-img{width:68px;height:68px;border-radius:13px}.cart-added-toast{left:4%;right:4%;top:68px;justify-content:center}}


/* === Simplified checkout right column === */
.checkout-side-card.compact-note{padding:14px 16px}
.checkout-mini-policies{display:grid;grid-template-columns:1fr;gap:8px}
.checkout-mini-policy{display:flex;align-items:flex-start;gap:10px;background:rgba(255,255,255,.72);border:1px solid rgba(229,226,217,.92);border-radius:14px;padding:10px 12px}
.checkout-mini-policy i{width:26px;height:26px;border-radius:10px;display:grid;place-items:center;background:rgba(122,128,98,.12);color:var(--olive);flex:0 0 auto}
.checkout-mini-policy b{display:block;font-size:12px;line-height:1.4;color:var(--ink)}
.checkout-mini-policy span{display:block;font-size:12px;line-height:1.45;color:var(--muted);margin-top:2px}
.checkout-voucher-box .voucher-title{margin-bottom:8px}
.checkout-voucher-box .voucher-title small{display:none}
.shipping-select-note{display:none}
.voucher-message{display:none}
.voucher-message.error{display:block;color:#C92F24}
.voucher-message.error,.voucher-message.success{margin-top:8px;font-size:12px;font-weight:800}
.voucher-message.success{display:block;color:#4D7A50}
.checkout-side-title span{display:none}
.compact-input-caption{font-size:11px;color:var(--muted);margin-bottom:8px}
.checkout-breakdown .checkout-line span:first-child{color:#6a645c}
@media(max-width:640px){.checkout-mini-policy{padding:10px}}


/* === Premium micro-interactions for Takumi Studio === */
.reveal-on-scroll{opacity:0;transform:translateY(26px);transition:opacity .68s ease,transform .68s cubic-bezier(.22,.8,.22,1);will-change:opacity,transform}
.reveal-on-scroll.is-visible{opacity:1;transform:translateY(0)}
.product-card,.featured-mini,.custom-card,.section-title,.catalog-toolbar,.footer{will-change:transform,opacity}
.product-card{transition:transform .28s cubic-bezier(.22,.8,.22,1),filter .28s ease}
.product-card:hover{transform:translateY(-7px)}
.product-card:hover .product-img{box-shadow:0 18px 46px rgba(44,42,40,.10)}
.featured-mini:hover{transform:translateY(-7px);box-shadow:0 18px 42px rgba(44,42,40,.09)}
.product-img img,.featured-mini-img img,.modal-media img{transition:opacity .34s ease,transform .48s cubic-bezier(.22,.8,.22,1),filter .34s ease}
.product-img.is-fading img,.modal-media.is-fading img{opacity:.12;transform:scale(1.018)}
.swatch,.chip{transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease,background .22s ease}
.swatch:hover{transform:scale(1.08)}
.chip:hover{transform:translateY(-1px);box-shadow:0 8px 18px rgba(44,42,40,.06)}
.modal-card{animation:modalSoftIn .32s cubic-bezier(.22,.8,.22,1)}
@keyframes modalSoftIn{from{opacity:0;transform:translateY(18px) scale(.985)}to{opacity:1;transform:translateY(0) scale(1)}}
@media (prefers-reduced-motion:reduce){.reveal-on-scroll,.product-card,.featured-mini,.product-img img,.featured-mini-img img,.modal-media img,.modal-card{transition:none!important;animation:none!important;transform:none!important;opacity:1!important}}


/* === Cleaner checkout left column === */
.checkout-panel-head p{max-width:520px}
.checkout-section--compact{padding:18px 18px 16px}
.checkout-section-title--compact{margin-bottom:12px}
.checkout-address-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.checkout-address-grid .full{grid-column:1 / -1}
.checkout-field-label{display:block;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.08em;color:#6d675f;margin:0 0 8px 2px}
.checkout-field-hint{font-size:12px;color:var(--muted);line-height:1.5;margin-top:8px}
.checkout-address-grid .input-group input{padding-right:14px}
.address-box--smart{padding:16px}
.address-hidden-field{display:none}
.payment-methods.payment-methods--clean{grid-template-columns:1fr 1fr;gap:12px}
.payment-methods--clean .payment-card{padding:16px;min-height:88px}
.payment-methods--clean .payment-info b{font-size:14px}
.payment-methods--clean .payment-info span{margin-top:3px;font-size:12px}
.checkout-section-note{display:none}
@media(max-width:980px){.checkout-address-grid,.payment-methods.payment-methods--clean{grid-template-columns:1fr}}


/* === QR Payment Step - Takumi clean light style === */
.checkout-card.qr-mode{grid-template-columns:1fr;width:min(900px,96vw)}
.checkout-card.qr-mode .checkout-right{display:none}
.checkout-card.qr-mode .checkout-left{padding:30px;background:#fff}
.checkout-main-step.is-hidden{display:none}
.checkout-qr-step{display:none}
.checkout-qr-step.active{display:block;animation:qrStepReveal .28s ease}
@keyframes qrStepReveal{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

.checkout-qr-shell{background:linear-gradient(180deg,#fff,#FAF8F4);border:1px solid var(--line);border-radius:26px;padding:24px;box-shadow:0 16px 42px rgba(44,42,40,.06);color:var(--ink)}
.checkout-qr-topline{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:18px}
.checkout-qr-pill{display:inline-flex;align-items:center;gap:7px;border-radius:999px;padding:8px 12px;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.1em;border:1px solid var(--line);background:#fff;color:#8a837b}
.checkout-qr-pill.active{background:var(--soft2);border-color:rgba(122,128,98,.28);color:var(--olive)}

.checkout-qr-header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:22px;padding-bottom:18px;border-bottom:1px solid var(--line)}
.checkout-qr-header h2{font-size:28px;letter-spacing:-.04em;margin:0 0 8px;color:var(--ink)}
.checkout-qr-header p{font-size:14px;line-height:1.65;color:var(--muted);max-width:560px}

.checkout-qr-panel{display:grid;grid-template-columns:300px 1fr;gap:22px;align-items:start}
.checkout-qr-left{background:#F7F4EE;border:1px solid var(--line);border-radius:24px;padding:18px;text-align:center}
.checkout-qr-bank-badge{display:inline-flex;align-items:center;gap:8px;border-radius:999px;padding:8px 13px;background:#fff;border:1px solid rgba(122,128,98,.18);color:var(--olive);font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.1em;margin-bottom:14px}
.checkout-qr-frame{background:#fff;border:1px solid var(--line);border-radius:22px;padding:14px;box-shadow:0 12px 28px rgba(44,42,40,.055)}
.checkout-qr-frame-inner{background:#fff;border-radius:16px;display:grid;place-items:center}
.checkout-qr-frame-inner img{width:230px;height:230px;object-fit:contain;border-radius:12px}
.checkout-qr-caption{font-size:14px;line-height:1.55;color:var(--ink);font-weight:800;margin-top:14px}
.checkout-qr-caption small{display:block;font-size:12px;font-weight:600;color:var(--muted);margin-top:5px;line-height:1.55}

.checkout-qr-right{display:grid;gap:12px}
.checkout-qr-card-lite{background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px;box-shadow:0 8px 22px rgba(44,42,40,.035)}
.checkout-qr-card-lite.labelled span{display:block;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.1em;color:#8a837b;margin-bottom:8px}

.checkout-qr-timer{display:flex;align-items:center;justify-content:space-between;gap:14px;background:linear-gradient(135deg,#2C2A28,#4B4741);color:#fff}
.checkout-qr-timer span{font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.68)}
.checkout-qr-timer b{font-size:36px;line-height:1;font-weight:900;letter-spacing:-.04em;color:#fff}

.checkout-qr-transfer{font-size:26px;line-height:1.15;font-weight:900;letter-spacing:-.03em;color:var(--olive);word-break:break-word}
.checkout-qr-transfer-sub{font-size:12px;line-height:1.55;color:var(--muted);margin-top:6px}

.checkout-qr-total{display:flex;align-items:center;justify-content:space-between;gap:14px}
.checkout-qr-total .meta{font-size:13px;color:var(--muted);font-weight:800}
.checkout-qr-total .value{font-size:26px;line-height:1;font-weight:900;color:var(--ink);letter-spacing:-.03em;white-space:nowrap}

.checkout-qr-confirm{display:flex;gap:10px;align-items:flex-start;cursor:pointer;background:#FAF8F4}
.checkout-qr-confirm input{margin-top:3px;width:18px;height:18px;accent-color:var(--olive)}
.checkout-qr-confirm b{display:block;font-size:13px;line-height:1.5;color:var(--ink)}

.checkout-qr-actions{display:grid;grid-template-columns:1fr;gap:9px;margin-top:2px}
.checkout-qr-actions .btn{justify-content:center;height:48px;border-radius:14px;font-size:14px}
.checkout-qr-actions .btn.btn-light{background:var(--ink);color:#fff;border:0;font-weight:900}
.checkout-qr-actions .btn.btn-light:hover{background:var(--olive)}
.checkout-qr-actions .btn:disabled{opacity:.45;cursor:not-allowed}
.checkout-qr-actions .text-back{display:inline-flex;justify-content:center;gap:8px;font-size:13px;color:var(--muted);padding-top:2px}
.checkout-qr-actions .text-back:hover{color:var(--ink)}

@media(max-width:820px){
  .checkout-card.qr-mode .checkout-left{padding:18px}
  .checkout-qr-panel{grid-template-columns:1fr}
  .checkout-qr-header{flex-direction:column}
  .checkout-qr-frame-inner img{width:210px;height:210px}
}
@media(max-width:520px){
  .checkout-qr-shell{padding:16px;border-radius:22px}
  .checkout-qr-header h2{font-size:23px}
  .checkout-qr-timer b{font-size:30px}
  .checkout-qr-transfer{font-size:22px}
  .checkout-qr-total .value{font-size:22px}
}


/* === Refined checkout voucher box === */
.checkout-voucher-box{background:rgba(255,255,255,.94);border:1px solid rgba(229,226,217,.95);border-radius:22px;padding:20px;box-shadow:0 12px 28px rgba(44,42,40,.04)}
.checkout-voucher-box .voucher-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
.checkout-voucher-box .voucher-title span{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:900;color:var(--ink);text-transform:uppercase;letter-spacing:.08em}
.checkout-voucher-box .voucher-title em{font-style:normal;font-size:12px;color:var(--muted)}
.compact-input-caption{font-size:12px;color:var(--muted);line-height:1.55;margin:2px 0 10px}
.auto-voucher-list{display:grid;gap:10px;margin-bottom:12px}
.auto-voucher-card{display:flex;align-items:center;gap:10px;border:1px solid rgba(229,226,217,.95);background:#fff;border-radius:16px;padding:12px;cursor:pointer;transition:.22s}
.auto-voucher-card:hover{border-color:#d6d0c3;box-shadow:0 10px 22px rgba(44,42,40,.05);transform:translateY(-1px)}
.auto-voucher-card input{width:18px;height:18px;accent-color:var(--olive)}
.auto-voucher-card.disabled{opacity:.55;cursor:not-allowed;background:#f5f3ee}
.auto-voucher-icon{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:rgba(122,128,98,.1);color:var(--olive);flex:0 0 auto}
.auto-voucher-info{flex:1;min-width:0}.auto-voucher-info b{display:block;font-size:13px;color:var(--ink);line-height:1.4}.auto-voucher-info span{display:block;font-size:12px;color:var(--muted);line-height:1.45;margin-top:3px}
.auto-voucher-value{font-size:12px;font-weight:900;color:#C92F24;background:rgba(233,71,53,.08);border-radius:999px;padding:6px 9px;white-space:nowrap}
.voucher-row{display:flex;gap:10px;align-items:center}.voucher-row input{flex:1;border:1px solid var(--line);background:#fcfcfb;border-radius:13px;padding:12px 13px;outline:none;font-weight:700;color:var(--ink);height:46px}.voucher-row input:focus{border-color:var(--olive);background:#fff;box-shadow:0 0 0 3px rgba(122,128,98,.09)}
.voucher-row .btn{height:46px;border-radius:13px;padding:0 16px;white-space:nowrap}
.voucher-message{font-size:12px;font-weight:800;margin-top:8px;color:var(--muted)}.voucher-message.success{display:block;color:#4D7A50}.voucher-message.error{display:block;color:#C92F24}
@media(max-width:640px){.checkout-voucher-box{padding:16px}.voucher-row{flex-direction:column}.voucher-row .btn,.voucher-row input{width:100%}}


/* === Toast & Order Success Feedback === */
.takumi-toast-wrap{position:fixed;inset:0;z-index:9800;display:grid;place-items:center;pointer-events:none;padding:22px}
.takumi-toast{width:min(390px,92vw);background:#fff;border:1px solid rgba(229,226,217,.95);border-radius:24px;padding:22px 20px;box-shadow:0 28px 80px rgba(44,42,40,.24);display:grid;justify-items:center;text-align:center;gap:12px;animation:takumiToastIn .28s ease both;pointer-events:auto}
.takumi-toast.hide{animation:takumiToastOut .24s ease both}
.takumi-toast-icon{width:54px;height:54px;border-radius:18px;background:rgba(122,128,98,.13);color:var(--olive);display:grid;place-items:center;font-size:22px}
.takumi-toast b{display:block;font-size:17px;line-height:1.35;color:var(--ink);letter-spacing:-.02em}
.takumi-toast span{display:block;font-size:13px;line-height:1.55;color:var(--muted);margin-top:2px}
@keyframes takumiToastIn{from{opacity:0;transform:translateY(12px) scale(.96)}to{opacity:1;transform:none}}
@keyframes takumiToastOut{from{opacity:1;transform:none}to{opacity:0;transform:translateY(8px) scale(.96)}}

.order-success-modal{position:fixed;inset:0;background:rgba(18,17,16,.58);z-index:9900;display:none;align-items:center;justify-content:center;padding:22px;backdrop-filter:blur(8px)}
.order-success-modal.active{display:flex}
.order-success-card{width:min(440px,94vw);background:#fff;border:1px solid rgba(229,226,217,.95);border-radius:26px;padding:28px;text-align:center;box-shadow:0 30px 90px rgba(0,0,0,.24);animation:orderSuccessIn .3s ease both}
.order-success-icon{width:62px;height:62px;border-radius:22px;background:rgba(122,128,98,.13);color:var(--olive);display:grid;place-items:center;margin:0 auto 16px;font-size:26px}
.order-success-card h3{font-size:24px;margin-bottom:8px;letter-spacing:-.035em}
.order-success-card p{font-size:14px;color:var(--muted);line-height:1.7;margin-bottom:18px}
.order-success-card .btn{width:100%;justify-content:center}
@keyframes orderSuccessIn{from{opacity:0;transform:translateY(14px) scale(.98)}to{opacity:1;transform:none}}
@media(max-width:640px){.order-success-card{padding:22px}.takumi-toast{width:min(360px,92vw);padding:20px 18px}}


.order-success-modal.error .order-success-icon{background:rgba(185,95,85,.12);color:#B95F55}


/* === Related products inside product modal === */
.related-panel{border:1px solid var(--line);background:#fff;border-radius:22px;padding:24px 26px;box-shadow:0 12px 34px rgba(44,42,40,.045)}
.related-head{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin-bottom:16px}
.related-head h3{font-size:22px;letter-spacing:-.025em;margin:0;display:flex;align-items:center;gap:10px}
.related-head h3::before{content:"";width:7px;height:24px;border-radius:999px;background:var(--olive);display:inline-block}
.related-head p{font-size:13px;color:var(--muted);line-height:1.55;max-width:420px;margin:0}
.related-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.related-card{background:#FAF8F4;border:1px solid rgba(229,226,217,.95);border-radius:18px;overflow:hidden;cursor:pointer;transition:.24s}
.related-card:hover{transform:translateY(-3px);background:#fff;box-shadow:0 14px 28px rgba(44,42,40,.07)}
.related-img{height:150px;background:#e5e2d9;overflow:hidden;position:relative}
.related-img img{width:100%;height:100%;object-fit:cover;transition:.35s}
.related-card:hover .related-img img{transform:scale(1.045)}
.related-info{padding:12px}
.related-info b{display:block;font-size:13px;line-height:1.35;margin-bottom:6px;color:var(--ink)}
.related-info span{display:block;font-size:12px;font-weight:900;color:var(--olive)}
.related-badge{position:absolute;left:10px;top:10px;border-radius:999px;background:rgba(255,255,255,.9);border:1px solid rgba(229,226,217,.95);padding:5px 8px;font-size:10px;font-weight:900;color:#5d5a52;backdrop-filter:blur(8px)}
@media(max-width:900px){.related-grid{grid-template-columns:repeat(2,1fr)}.related-img{height:160px}.related-head{align-items:flex-start;flex-direction:column}}
@media(max-width:520px){.related-panel{padding:18px}.related-grid{grid-template-columns:1fr 1fr;gap:10px}.related-img{height:130px}.related-info b{font-size:12px}.related-head p{display:none}}


/* === Admin promo visual list upgrade === */
.admin-promo-overview{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:0 0 14px}
.admin-promo-stat{background:#fff;border:1px solid var(--line);border-radius:16px;padding:12px;display:flex;align-items:center;gap:10px;box-shadow:0 8px 18px rgba(44,42,40,.035)}
.admin-promo-stat i{width:34px;height:34px;border-radius:12px;display:grid;place-items:center;background:rgba(122,128,98,.1);color:var(--olive)}
.admin-promo-stat b{display:block;font-size:18px;line-height:1;color:var(--ink)}
.admin-promo-stat span{display:block;font-size:11px;color:var(--muted);font-weight:900;text-transform:uppercase;letter-spacing:.08em;margin-top:4px}
.admin-promo-list{display:grid;gap:10px;max-height:360px;overflow:auto;padding-right:3px}
.admin-promo-item{border:1px solid rgba(229,226,217,.95);border-radius:18px;padding:14px;background:#fff;font-size:12px;box-shadow:0 10px 24px rgba(44,42,40,.035)}
.admin-promo-item.is-active{border-color:rgba(77,122,80,.32);background:linear-gradient(180deg,#fff,#F8FBF6)}
.admin-promo-item.is-scheduled{border-color:rgba(196,154,69,.32);background:linear-gradient(180deg,#fff,#FFFBF2)}
.admin-promo-item.is-expired{opacity:.72;background:#FAF8F4}
.admin-promo-item-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:10px}
.admin-promo-name{min-width:0}.admin-promo-name b{display:block;font-size:14px;line-height:1.35;color:var(--ink);margin-bottom:4px}.admin-promo-name small{display:block;color:var(--muted);line-height:1.45}
.admin-promo-code{display:inline-flex;align-items:center;gap:6px;border:1px dashed rgba(122,128,98,.42);background:rgba(122,128,98,.08);color:var(--olive);border-radius:999px;padding:7px 10px;font-size:12px;font-weight:950;letter-spacing:.04em;white-space:nowrap}
.admin-promo-meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0}
.admin-promo-meta{border:1px solid rgba(229,226,217,.9);background:#FAF8F4;border-radius:13px;padding:9px}
.admin-promo-meta span{display:block;font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.08em;color:#8a837b;margin-bottom:4px}.admin-promo-meta b{font-size:12px;color:var(--ink);line-height:1.35}
.admin-program-status{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:6px 9px;font-size:11px;font-weight:950;margin-top:0}
.admin-program-status.active{background:rgba(75,128,82,.12);color:#4D7A50}
.admin-program-status.scheduled{background:rgba(196,154,69,.15);color:#9B732B}
.admin-program-status.expired{background:rgba(185,95,85,.12);color:#B95F55}
.admin-promo-actions{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
.admin-promo-actions button{border:0;border-radius:999px;padding:8px 11px;font-size:11px;font-weight:900;cursor:pointer;background:#F1EEE6;color:#5d5a52}
.admin-promo-actions button:hover{background:#E8E2D7;color:var(--ink)}
.admin-promo-actions button.danger{background:rgba(185,95,85,.1);color:#B95F55}.admin-promo-actions button.danger:hover{background:#B95F55;color:#fff}
.admin-program-empty{border:1px dashed #ddd;background:#fff;border-radius:16px;padding:18px;text-align:center;color:var(--muted);font-size:13px;line-height:1.55}
@media(max-width:700px){.admin-promo-overview{grid-template-columns:1fr}.admin-promo-meta-grid{grid-template-columns:1fr}.admin-promo-item-top{flex-direction:column}.admin-promo-code{white-space:normal}}


.admin-promo-code.base-sale{border-color:rgba(77,122,80,.36);background:rgba(77,122,80,.09);color:#4D7A50}


/* === COD icon + shipping voucher Shopee-like === */
.payment-icon.cod{
  background:linear-gradient(135deg,#34b6a5,#20a08f) !important;
  color:#fff;
  box-shadow:0 10px 22px rgba(39,170,153,.24);
}

.shipping-voucher-card{
  position:relative;
  display:grid;
  grid-template-columns:190px 1fr 34px;
  align-items:stretch;
  gap:0;
  min-height:126px;
  border:1px solid rgba(229,226,217,.95);
  border-radius:16px;
  overflow:hidden;
  background:#fff;
  box-shadow:0 10px 24px rgba(44,42,40,.045);
  cursor:pointer;
  transition:.22s;
}
.shipping-voucher-card:hover{
  transform:translateY(-1px);
  box-shadow:0 14px 28px rgba(44,42,40,.07);
}
.shipping-voucher-card.checked{
  border-color:#28a995;
  box-shadow:0 0 0 2px rgba(40,169,149,.10),0 14px 28px rgba(44,42,40,.06);
}
.shipping-voucher-card input{
  position:absolute;
  opacity:0;
  pointer-events:none;
}
.shipping-voucher-left{
  position:relative;
  background:linear-gradient(135deg,#46b1a3,#2aa797);
  color:#fff;
  padding:18px 16px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
}
.shipping-voucher-left::before,
.shipping-voucher-left::after{
  content:"";
  position:absolute;
  right:-8px;
  width:16px;height:16px;
  border-radius:50%;
  background:#fff;
  box-shadow:0 0 0 1px rgba(229,226,217,.65);
}
.shipping-voucher-left::before{top:28px}
.shipping-voucher-left::after{bottom:28px}
.shipping-voucher-big{
  font-size:24px;
  line-height:.95;
  font-weight:1000;
  font-style:italic;
  letter-spacing:-.03em;
  text-transform:uppercase;
}
.shipping-voucher-left small{
  display:block;
  margin-top:10px;
  font-size:12px;
  line-height:1.45;
  color:rgba(255,255,255,.9);
}
.shipping-voucher-right{
  padding:18px 18px 16px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}
.shipping-voucher-right b{
  display:block;
  font-size:15px;
  line-height:1.35;
  color:var(--ink);
}
.shipping-voucher-right .ship-sub{
  display:block;
  margin-top:4px;
  font-size:12px;
  color:var(--muted);
  line-height:1.45;
}
.shipping-voucher-tag{
  display:inline-flex;
  align-items:center;
  align-self:flex-start;
  margin-top:10px;
  border:1px solid rgba(233,109,53,.45);
  color:#e96d35;
  background:#fff;
  border-radius:4px;
  padding:5px 8px;
  font-size:11px;
  font-weight:900;
}
.shipping-voucher-expiry{
  display:block;
  margin-top:8px;
  font-size:12px;
  color:#8a837b;
}
.shipping-voucher-check{
  display:grid;
  place-items:center;
  padding:0 12px 0 8px;
}
.shipping-voucher-check span{
  width:20px;height:20px;
  border-radius:50%;
  border:2px solid #cfc8bb;
  background:#fff;
  display:grid;
  place-items:center;
  transition:.2s;
}
.shipping-voucher-card.checked .shipping-voucher-check span{
  border-color:#28a995;
  background:#28a995;
  color:#fff;
}
.shipping-voucher-card.checked .shipping-voucher-check i{opacity:1}
.shipping-voucher-check i{
  font-size:11px;
  opacity:0;
}
@media(max-width:640px){
  .shipping-voucher-card{grid-template-columns:110px 1fr 28px;min-height:118px}
  .shipping-voucher-left{padding:14px 10px}
  .shipping-voucher-big{font-size:20px}
  .shipping-voucher-right{padding:14px 14px 13px}
  .shipping-voucher-right b{font-size:14px}
}



/* === Compact unified voucher cards - Clean 2026 === */
.discount-voucher-card{
  position:relative;
  display:grid;
  grid-template-columns:46px 1fr 20px;
  align-items:center;
  gap:10px;
  min-height:64px;
  border:1px solid #ECE5DA;
  border-radius:14px;
  background:#fff;
  padding:9px 10px;
  box-shadow:none;
  cursor:pointer;
  transition:.18s ease;
  overflow:visible;
}
.discount-voucher-card:hover{
  transform:none;
  border-color:#E8A07E;
  box-shadow:0 8px 20px rgba(44,42,40,.045);
}
.discount-voucher-card.checked{
  border-color:#EA5A31;
  background:linear-gradient(180deg,#fff,#FFF8F4);
  box-shadow:0 0 0 2px rgba(234,90,49,.07);
}
.discount-voucher-card input{position:absolute;opacity:0;pointer-events:none}
.discount-voucher-left{
  width:46px;
  height:46px;
  border-radius:13px;
  background:#FFF0E9;
  color:#EA5A31;
  padding:0;
  display:grid;
  place-items:center;
  text-align:center;
}
.discount-voucher-left i{font-size:17px;line-height:1}
.discount-voucher-left small{display:none}
.discount-voucher-right{
  padding:0;
  display:flex;
  flex-direction:column;
  justify-content:center;
  min-width:0;
}
.discount-voucher-title-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
}
.discount-voucher-title-row b{
  font-size:13px;
  line-height:1.25;
  color:var(--ink);
  min-width:0;
}
.discount-voucher-best{
  display:inline-flex;
  align-items:center;
  border-radius:999px;
  background:#F4EFE8;
  color:#7B7168;
  padding:3px 7px;
  font-size:9px;
  font-weight:900;
  white-space:nowrap;
}
.discount-voucher-card.checked .discount-voucher-best{
  background:#EA5A31;
  color:#fff;
}
.discount-voucher-sub{
  display:block;
  margin-top:3px;
  font-size:11px;
  color:#6F6960;
  line-height:1.35;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.discount-voucher-code{
  display:flex;
  align-items:center;
  gap:8px;
  margin-top:5px;
  font-size:11px;
  color:#8A837B;
  line-height:1.25;
  min-width:0;
}
.discount-voucher-tag{
  display:inline-flex;
  align-items:center;
  align-self:auto;
  margin:0;
  padding:3px 6px;
  border-radius:7px;
  border:1px solid rgba(234,90,49,.22);
  background:#FFF5EF;
  color:#EA5A31;
  font-size:10px;
  font-weight:900;
  white-space:nowrap;
}
.discount-voucher-check{display:grid;place-items:center;padding:0}
.discount-voucher-check span{
  width:18px;
  height:18px;
  border-radius:50%;
  border:1.5px solid #d7d0c2;
  background:#fff;
  display:grid;
  place-items:center;
  transition:.2s;
}
.discount-voucher-check i{font-size:9px;opacity:0}
.discount-voucher-card.checked .discount-voucher-check span{border-color:#EA5A31;background:#EA5A31;color:#fff}
.discount-voucher-card.checked .discount-voucher-check i{opacity:1}
.discount-voucher-card.locked{
  opacity:.52;
  background:#F7F4EE;
  cursor:not-allowed;
  box-shadow:none;
}
.discount-voucher-card.locked:hover{
  transform:none;
  border-color:#ECE5DA;
  box-shadow:none;
}
.discount-voucher-card.locked .discount-voucher-best{
  background:#E9E3DA;
  color:#8D857A;
}
.discount-voucher-card.locked .discount-voucher-left{
  background:#F1EDE6;
  color:#9B9288;
}
.discount-voucher-card.locked .discount-voucher-tag{
  border-color:#DDD4C8;
  background:#fff;
  color:#8D857A;
}

.ship-compact-card{
  position:relative;
  display:grid;
  grid-template-columns:48px 1fr 24px;
  align-items:center;
  gap:9px;
  border:1px solid rgba(229,226,217,.96);
  border-radius:13px;
  background:#fff;
  padding:8px 9px;
  min-height:64px;
  box-shadow:0 6px 14px rgba(44,42,40,.035);
  cursor:pointer;
  transition:.18s;
}
.ship-compact-card:hover{transform:translateY(-1px);box-shadow:0 10px 20px rgba(44,42,40,.05)}
.ship-compact-card.checked{border-color:#28a995;box-shadow:0 0 0 2px rgba(40,169,149,.07),0 10px 20px rgba(44,42,40,.05)}
.ship-compact-card input{position:absolute;opacity:0;pointer-events:none}
.ship-compact-icon{width:48px;height:48px;border-radius:11px;background:linear-gradient(135deg,#46b1a3,#2aa797);color:#fff;display:grid;place-items:center;font-size:19px}
.ship-compact-content b{display:block;font-size:11px;line-height:1.3;color:var(--ink)}
.ship-compact-content span{display:block;font-size:10px;color:var(--muted);line-height:1.35;margin-top:2px}
.ship-compact-content small{display:block;font-size:9px;color:#8a837b;line-height:1.25;margin-top:3px}
.ship-compact-check{display:grid;place-items:center}
.ship-compact-check span{width:16px;height:16px;border-radius:50%;border:2px solid #cfc8bb;background:#fff;display:grid;place-items:center;transition:.2s}
.ship-compact-check i{font-size:9px;opacity:0}
.ship-compact-card.checked .ship-compact-check span{border-color:#28a995;background:#28a995;color:#fff}
.ship-compact-card.checked .ship-compact-check i{opacity:1}

@media(max-width:640px){
  .discount-voucher-card{grid-template-columns:42px 1fr 20px;min-height:60px;padding:8px;gap:8px}
  .discount-voucher-left{width:42px;height:42px}
  .discount-voucher-left i{font-size:16px}
  .discount-voucher-title-row b{font-size:12px}
  .discount-voucher-sub,.discount-voucher-code{font-size:10px}
  .discount-voucher-best{font-size:8px;padding:2px 6px}
  .discount-voucher-tag{font-size:9px;padding:2px 5px}
  .ship-compact-card{grid-template-columns:42px 1fr 22px;padding:7px 8px;min-height:60px}
  .ship-compact-icon{width:42px;height:42px;font-size:17px}
}

/* === Product detail CTA buttons: red/white voucher-inspired === */
.modal-actions.buy-actions{
  grid-template-columns:1fr 1.18fr;
  gap:12px;
}
.modal-actions.buy-actions .btn{
  height:54px;
  border-radius:16px;
  font-weight:900;
  font-size:14px;
  letter-spacing:.01em;
  transition:.22s ease;
}
.modal-actions.buy-actions .btn i{
  font-size:15px;
}
.modal-actions.buy-actions .btn-olive{
  background:#fff;
  color:#ea5530;
  border:1.5px solid rgba(239,103,59,.42);
  box-shadow:0 8px 18px rgba(44,42,40,.035);
}
.modal-actions.buy-actions .btn-olive:hover{
  background:#fff6f2;
  border-color:#ea5530;
  transform:translateY(-1px);
  box-shadow:0 12px 24px rgba(239,103,59,.12);
}
.modal-actions.buy-actions .btn-dark{
  background:linear-gradient(135deg,#ef673b,#ea5530);
  color:#fff;
  border:1px solid transparent;
  box-shadow:0 14px 30px rgba(239,103,59,.26);
}
.modal-actions.buy-actions .btn-dark:hover{
  background:linear-gradient(135deg,#f07249,#eb5d36);
  transform:translateY(-1px);
  box-shadow:0 18px 34px rgba(239,103,59,.32);
}
@media(max-width:640px){
  .modal-actions.buy-actions{
    grid-template-columns:1fr;
    gap:10px;
  }
  .modal-actions.buy-actions .btn{
    height:50px;
    border-radius:14px;
  }
}


/* === Product title badge + rating row === */
.modal-headline{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.product-type-badge{
  display:inline-flex;
  align-items:center;
  min-height:26px;
  padding:5px 10px;
  border-radius:8px;
  background:#fff3ee;
  color:#ea5530;
  border:1px solid rgba(239,103,59,.22);
  font-size:12px;
  font-weight:900;
  line-height:1;
}
#modalName{margin-bottom:10px}
.product-meta-row{
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:12px;
  margin:0 0 14px;
  color:#686056;
  font-size:14px;
}
.product-rating-mini,
.product-review-mini,
.product-sold-mini{
  display:inline-flex;
  align-items:center;
  gap:6px;
  line-height:1;
}
.product-rating-mini b{
  color:var(--ink);
  font-size:15px;
}
.product-rating-mini .stars{
  display:inline-flex;
  gap:1px;
  color:#f4b324;
  font-size:12px;
}
.meta-divider{
  width:1px;
  height:18px;
  background:#ddd4c8;
}
@media(max-width:640px){
  .product-meta-row{gap:8px;font-size:13px}
  .meta-divider{height:15px}
}


/* === Product quantity row === */
.product-qty-row{
  display:flex;
  align-items:center;
  gap:16px;
  margin:12px 0 4px;
  flex-wrap:wrap;
}
.product-qty-label{
  font-size:14px;
  font-weight:700;
  color:#6c645a;
  min-width:72px;
}
.product-qty-control{
  display:inline-flex;
  align-items:center;
  border:1px solid rgba(219,212,201,.95);
  border-radius:12px;
  overflow:hidden;
  background:#fff;
}
.qty-btn{
  width:42px;
  height:42px;
  border:0;
  background:#fff;
  color:#7b746b;
  font-size:24px;
  line-height:1;
  cursor:pointer;
  transition:.18s ease;
}
.qty-btn:hover{
  background:#fff4ef;
  color:#ea5530;
}
#modalQtyInput{
  width:58px;
  height:42px;
  border:0;
  border-left:1px solid rgba(219,212,201,.95);
  border-right:1px solid rgba(219,212,201,.95);
  text-align:center;
  font-size:18px;
  font-weight:800;
  color:#ea5530;
  outline:none;
  background:#fff;
}
#modalQtyInput::-webkit-outer-spin-button,
#modalQtyInput::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
#modalQtyInput[type=number]{-moz-appearance:textfield}
.product-stock-text{
  font-size:14px;
  font-weight:800;
  color:#8c816f;
  letter-spacing:.02em;
}
@media(max-width:640px){
  .product-qty-row{gap:12px}
  .product-qty-label,.product-stock-text{font-size:13px}
  .qty-btn{width:38px;height:38px;font-size:22px}
  #modalQtyInput{width:52px;height:38px;font-size:16px}
}


/* === Flash sale admin toggle === */
.admin-promo-code.is-off{
  background:#f1eee8;
  color:#8a837b;
}
.admin-promo-actions .toggle{
  background:#fff7f3;
  color:#ea5530;
  border-color:rgba(239,103,59,.22);
}


.admin-top-btn.save-product-top{
  background:#fff;
  color:#2C2A28;
  border-color:#fff;
  box-shadow:0 10px 24px rgba(0,0,0,.16);
}
.admin-top-btn.save-product-top i{color:#7A8062}
@media(max-width:760px){
  .admin-head-actions{flex-wrap:wrap;justify-content:flex-end}
  .admin-top-btn{height:38px;padding:0 11px}
}


.product-rating-mini .rating-icon{
  color:#f4b324;
  font-size:13px;
  line-height:1;
  margin-right:2px;
}


/* === Floating contact buttons === */
.floating-contact{
  position:fixed;
  right:20px;
  bottom:22px;
  z-index:4900;
  display:flex;
  flex-direction:column;
  gap:10px;
  align-items:flex-end;
  pointer-events:none;
}
.floating-contact-btn{
  pointer-events:auto;
  width:54px;
  height:54px;
  padding:0;
  border-radius:999px;
  display:flex;
  align-items:center;
  justify-content:flex-start;
  gap:10px;
  overflow:hidden;
  text-decoration:none;
  font-size:13px;
  font-weight:900;
  letter-spacing:.01em;
  color:#fff;
  box-shadow:0 16px 34px rgba(44,42,40,.18);
  border:1px solid rgba(255,255,255,.35);
  backdrop-filter:blur(12px);
  transform:translateZ(0);
  transition:width .24s ease, transform .22s ease, box-shadow .22s ease, filter .22s ease, padding .24s ease;
}
.floating-contact-btn:hover{
  width:150px;
  padding:0 16px 0 9px;
  transform:translateY(-3px);
  box-shadow:0 22px 44px rgba(44,42,40,.24);
  filter:saturate(1.08);
}
.floating-contact-icon{
  width:36px;
  height:36px;
  margin-left:8px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:rgba(255,255,255,.22);
  color:#fff;
  font-size:17px;
  font-weight:1000;
  flex:0 0 auto;
}
.floating-contact-btn:hover .floating-contact-icon{
  margin-left:0;
}
.floating-contact-btn.zalo{
  background:linear-gradient(135deg,#0A8DFF,#0068D9);
}
.floating-contact-btn.messenger{
  background:linear-gradient(135deg,#7B61FF,#0084FF);
}
.floating-contact-text{
  white-space:nowrap;
  opacity:0;
  transform:translateX(8px);
  transition:opacity .18s ease, transform .22s ease;
}
.floating-contact-btn:hover .floating-contact-text{
  opacity:1;
  transform:translateX(0);
}
.checkout-modal.active ~ .floating-contact,
.admin-modal.active ~ .floating-contact,
.modal.active ~ .floating-contact{
  display:none;
}
@media(max-width:640px){
  .floating-contact{
    right:14px;
    bottom:16px;
    gap:8px;
  }
  .floating-contact-btn{
    width:48px;
    height:48px;
  }
  .floating-contact-btn:hover{
    width:136px;
    padding:0 12px 0 8px;
  }
  .floating-contact-icon{
    width:32px;
    height:32px;
    margin-left:7px;
    font-size:15px;
  }
  .floating-contact-btn:hover .floating-contact-icon{
    margin-left:0;
  }
  .floating-contact-text{
    font-size:12px;
  }
}


.logo{display:inline-flex;align-items:center;gap:10px;font-weight:800;font-size:20px;letter-spacing:.8px}
.logo-img{width:34px;height:34px;object-fit:contain;display:block;flex:0 0 auto}
.logo-text{display:inline-flex;align-items:center;gap:4px}
.logo-text span{color:var(--olive)}

.footer-logo{display:inline-flex;align-items:center;gap:10px}
.footer-logo-img{width:38px;height:38px;object-fit:contain;display:block;flex:0 0 auto}
.footer-logo-text{display:inline-flex;align-items:center;gap:4px}
.footer-logo-text span{color:#BFC3A0}

@media(max-width:640px){
  .logo-img{width:30px;height:30px}
  .footer-logo-img{width:34px;height:34px}
}


/* === Logo text style restored === */
.logo,
.footer-logo{
  font-weight:900;
  letter-spacing:.5px;
