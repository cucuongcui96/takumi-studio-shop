  }
  .product-card .swatches{gap:5px!important;}
  .product-card .swatch{
    width:20px!important;
    height:20px!important;
    min-width:20px!important;
    border:1px solid rgba(0,0,0,.12)!important;
    box-shadow:inset 0 0 0 2px rgba(255,255,255,.82),0 2px 5px rgba(0,0,0,.05)!important;
  }
