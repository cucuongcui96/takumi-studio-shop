function adminNewProduct(){
  document.getElementById('adminFormTitle').textContent='Thêm sản phẩm mới';
  document.getElementById('adminProductForm').reset();
  document.getElementById('adminId').value='';
  document.getElementById('adminImg').value='https://iili.io/Cdj4yS1.jpg';
  document.getElementById('adminName').value='';
  adminSaveCategories();
  renderCategoryOptions(getCategories()[0]?.id||'buddha');
  document.getElementById('adminFilter').value='buddha';
  document.getElementById('adminShip').value='true';
  if(document.getElementById('adminRating'))document.getElementById('adminRating').value='4.9';
  adminAutoSalePercent();
  if(document.getElementById('adminSold'))document.getElementById('adminSold').value='';
  adminRenderGalleryRows(['https://iili.io/Cdj4yS1.jpg']);
  adminRenderColorRows(adminDefaultColorRows().map(c=>({...c,image:'https://iili.io/Cdj4yS1.jpg'})));
  adminUpdateLivePreview();
  renderAdminProducts();
}
function adminEditProduct(id){
  const p=takumiProductById(id);if(!p)return;
  document.getElementById('adminFormTitle').textContent='Đang sửa: '+p.name;
  document.getElementById('adminId').value=p.id;
  document.getElementById('adminImg').value=p.img||'';
  document.getElementById('adminName').value=p.name||'';
  adminSaveCategories();
  renderCategoryOptions(p.type||getCategories()[0]?.id||'buddha');
  document.getElementById('adminPrice').value=p.price||0;
  document.getElementById('adminOld').value=p.old||0;
  document.getElementById('adminSale').value=p.sale||0;
  document.getElementById('adminShort').value=p.short||'';
  document.getElementById('adminDesc').value=p.desc||'';
  document.getElementById('adminFilter').value=p.filter||p.type||'buddha';
  document.getElementById('adminShip').value=String(!!p.ship);
  if(document.getElementById('adminRating'))document.getElementById('adminRating').value=p.rating||4.9;
  if(document.getElementById('adminSold'))document.getElementById('adminSold').value=p.sold||'';
  adminAutoSalePercent();
  adminRenderGalleryRows(p.galleryImages&&p.galleryImages.length?p.galleryImages:[p.img||'']);
  adminRenderColorRows((p.colors&&p.colors.length?p.colors:colors).map(c=>({name:c.name,hex:c.hex||'#F4F1EA',image:(p.colorImages&&p.colorImages[c.name])||c.image||p.img||''})));
  adminUpdateLivePreview();
  renderAdminProducts();
}
function adminPreviewImage(){
  const src=document.getElementById('adminImg').value.trim();
  if(!adminGalleryFromRows().length)adminRenderGalleryRows([src||'https://iili.io/Cdj4yS1.jpg']);
}
function adminUploadImage(event){
  const file=event.target.files&&event.target.files[0];
  if(!file)return;
  adminCompressImageFile(file,(data)=>{
    document.getElementById('adminImg').value=data;
    const gallery=adminGalleryFromRows();
    if(!gallery.length || gallery.length===1)adminRenderGalleryRows([data]);
    adminUpdateLivePreview();
  });
}
function adminSetPreviewColor(i){
  adminPreviewColorIndex=i;
  adminUpdateLivePreview();
}
function adminSetPreviewImage(src){
  document.getElementById('adminPreviewImg').src=src;
}

function adminAutoSalePercent(){
  const price=Number(document.getElementById('adminPrice')?.value||0);
  const old=Number(document.getElementById('adminOld')?.value||0);
  const saleInput=document.getElementById('adminSale');
  const preview=document.getElementById('adminDiscountPreview');
  if(old>0&&price>0&&old>price){
    const percent=Math.round((old-price)/old*100);
    if(saleInput)saleInput.value=percent;
    if(preview)preview.innerHTML=`<i class="fa-solid fa-tags"></i> Đang giảm ${percent}% so với giá gốc`;
  }else{
    if(saleInput)saleInput.value='';
    if(preview)preview.innerHTML='<i class="fa-solid fa-tags"></i> Chưa có giảm giá';
  }
}

function adminUpdateLivePreview(){
  const baseImg=document.getElementById('adminImg')?.value.trim()||'https://iili.io/Cdj4yS1.jpg';
  const gallery=adminGalleryFromRows();
  const colorsNow=adminColorObjectsFromRows();
  if(adminPreviewColorIndex>=colorsNow.length)adminPreviewColorIndex=0;
  const selectedColor=colorsNow[adminPreviewColorIndex]||colorsNow[0];
  const previewImg=(selectedColor&&selectedColor.image)||gallery[0]||baseImg;
  const name=document.getElementById('adminName')?.value.trim()||'Tên sản phẩm';
  const short=document.getElementById('adminShort')?.value.trim()||'Mô tả ngắn của sản phẩm sẽ hiện ở đây.';
  const price=Number(document.getElementById('adminPrice')?.value||0);
  const old=Number(document.getElementById('adminOld')?.value||0);
  const sale=Number(document.getElementById('adminSale')?.value||0);
  const ship=document.getElementById('adminShip')?.value==='true';
  const filter=document.getElementById('adminFilter')?.value||'buddha';
  document.getElementById('adminPreviewImg').src=previewImg;
  document.getElementById('adminPreviewName').textContent=name;
  document.getElementById('adminPreviewShort').textContent=short;
  document.getElementById('adminPreviewPrice').textContent='Từ '+money(price);
  document.getElementById('adminPreviewOld').textContent=old?money(old):'';
  const liveRating=Number(document.getElementById('adminRating')?.value||4.9).toFixed(1);
  const liveSold=Number(document.getElementById('adminSold')?.value||86);
  document.getElementById('adminPreviewMeta').innerHTML=`<span class="rating-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><b>${liveRating}</b></span><span class="sold-count"><i class="fa-solid fa-bag-shopping"></i>Đã bán ${liveSold}</span>`;
  document.getElementById('adminPreviewColorName').innerHTML=`<span class="swatch" style="background:${selectedColor.hex};vertical-align:middle;margin-right:6px"></span>${selectedColor.name}`;
  document.getElementById('adminPreviewBadges').innerHTML=`<div>${sale?`<span class="badge sale">-${sale}%</span>`:''}</div><div>${filter==='hot'?`<span class="badge hot">Được chọn nhiều</span>`:''}${ship?`<span class="badge ship" style="margin-top:6px"><i class="fa-solid fa-truck"></i> Freeship</span>`:''}</div>`;
  document.getElementById('adminPreviewSwatches').innerHTML=colorsNow.map((c,i)=>`<button class="admin-preview-swatch ${i===adminPreviewColorIndex?'active':''}" type="button" onclick="adminSetPreviewColor(${i})"><span class="swatch" style="background:${c.hex}"></span>${c.name}</button>`).join('');
  const galleryAll=[...new Set([previewImg,...gallery,baseImg].filter(Boolean))].slice(0,8);
  document.getElementById('adminPreviewGallery').innerHTML=galleryAll.map(src=>`<img src="${escapeAttr(src)}" onclick="adminSetPreviewImage('${escapeAttr(src).replace(/'/g,'&#39;')}')" alt="Ảnh xem trước">`).join('');
}
function adminQuickSaveProduct(){
  const form=document.getElementById('adminProductForm');
  const workspace=document.getElementById('adminWorkspace');
  if(!form || (workspace && workspace.style.display==='none')){
    alert('Bạn cần đăng nhập admin trước khi lưu sản phẩm.');
    return;
  }
  if(form.requestSubmit){
    form.requestSubmit();
  }else{
    adminSaveProduct({preventDefault:()=>{}});
  }
}
function adminSaveProduct(e){
  if(e&&e.preventDefault)e.preventDefault();
  adminAutoSalePercent();
  adminSaveCategories();
  const idRaw=document.getElementById('adminId').value;
  const existingProduct=idRaw?takumiProductById(idRaw):null;
  const numericId=Number(idRaw);
  const productId=idRaw?(existingProduct?existingProduct.id:(Number.isFinite(numericId)?numericId:idRaw)):Date.now();
  takumiUnmarkDeletedProduct(productId);
  const pickedColors=adminColorObjectsFromRows();
  const gallery=adminGalleryFromRows();
  const soldBase=Number.isFinite(Number(productId))?Number(productId):Date.now();
  const product={
    id:productId,
    type:document.getElementById('adminType').value,
    filter:document.getElementById('adminFilter').value,
    name:document.getElementById('adminName').value.trim(),
    img:document.getElementById('adminImg').value.trim(),
    price:Number(document.getElementById('adminPrice').value||0),
    old:Number(document.getElementById('adminOld').value||0),
    sale:Number(document.getElementById('adminSale').value||0),
    ship:document.getElementById('adminShip').value==='true',
    short:document.getElementById('adminShort').value.trim(),
    desc:document.getElementById('adminDesc').value.trim(),
    galleryImages:gallery.length?gallery:[document.getElementById('adminImg').value.trim()],
    rating:Number(document.getElementById('adminRating')?.value||4.9),
    sold:Number(document.getElementById('adminSold')?.value||0)||Math.max(18, soldBase%100+24),
    colors:pickedColors
  };
  product.colorImages={};
  product.colors.forEach(c=>product.colorImages[c.name]=(c.image||product.img));
  product.img=(product.galleryImages[0]||product.colorImages[product.colors[0]?.name]||product.img);
  const idx=(products||[]).findIndex(p=>takumiSameId(p.id,product.id));
  if(idx>=0)products[idx]=product;else products.unshift(product);
  persistProducts();
  refreshStorefront();
  adminEditProduct(product.id);
  alert('Đã lưu sản phẩm và cập nhật giá ngoài website.');
}
function adminDeleteProduct(id){
  const targetId=String(id);
  const p=takumiProductById(targetId);
  if(!p){
    alert('Không tìm thấy sản phẩm cần xóa. Có thể dữ liệu cũ đang lệch ID, hãy tải lại file mới rồi thử lại.');
    return;
  }
  if(!confirm('Xóa sản phẩm "'+p.name+'"?'))return;

  takumiMarkDeletedProduct(targetId);
  products=(products||[]).filter(x=>!takumiSameId(x.id,targetId));

  try{cart=(cart||[]).filter(item=>!takumiSameId(item.id,targetId)&&!takumiSameId(item.productId,targetId));}catch(e){}
  try{vouchers=takumiRemoveProductIdFromList(vouchers,targetId);flashSales=takumiRemoveProductIdFromList(flashSales,targetId);persistPromos();}catch(e){}
  if(currentProduct&&takumiSameId(currentProduct.id,targetId))currentProduct=null;

  persistProducts();
  refreshStorefront();

  const first=products[0];
  if(first)adminEditProduct(first.id);else adminNewProduct();
  renderAdminProducts();
  adminRenderPromos();
}
function adminExportProducts(){
  const data=JSON.stringify(products,null,2);
  const blob=new Blob([data],{type:'application/json'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='takumi-products.json';
  a.click();
  URL.revokeObjectURL(a.href);
}
function adminImportProducts(){
  const input=document.createElement('input');
  input.type='file';
  input.accept='application/json';
  input.onchange=()=>{
    const file=input.files[0];if(!file)return;
    const reader=new FileReader();
    reader.onload=()=>{
      try{
        const data=JSON.parse(reader.result);
        if(!Array.isArray(data))throw new Error('invalid');
        products=data;
        persistProducts();
        refreshStorefront();
        const first=products[0];if(first)adminEditProduct(first.id);
        alert('Đã nhập dữ liệu sản phẩm.');
      }catch(e){alert('File JSON chưa đúng định dạng.')}
    };
    reader.readAsText(file);
  };
  input.click();
}
function adminResetProducts(){
  if(!confirm('Khôi phục toàn bộ sản phẩm mặc định? Dữ liệu đang lưu sẽ bị thay thế.'))return;
  takumiSetDeletedProductIds([]);
  products=JSON.parse(JSON.stringify(defaultProducts));
  persistProducts();
  refreshStorefront();
  const first=products[0];if(first)adminEditProduct(first.id);else adminNewProduct();
}


function defaultVoucherList(){
  // Không tự tạo lại mã mặc định.
  // Trước đây TAKUMI10 bị tự thêm lại sau khi xóa nên vẫn hiện ở phần checkout.
  return [];
}
const TAKUMI_PROMO_STORAGE_VERSION='2026-06-11-price-display-fix-no-auto-flash';
function normalizeVoucherList(list){
  return (Array.isArray(list)?list:[]).filter(v=>v&&String(v.code||'').trim()&&Number(v.value||0)>0);
}
function loadStoredPromos(){
  try{
    // Nếu người dùng từng mở bản cũ, localStorage có thể vẫn giữ mã đã xóa.
    // Khi sang phiên bản này, chỉ dùng dữ liệu nhúng trong file một lần để tránh mã cũ xuất hiện lại.
    const sameVersion=localStorage.getItem('takumi_promo_storage_version')===TAKUMI_PROMO_STORAGE_VERSION;
    const storedV=sameVersion?localStorage.getItem('takumi_vouchers'):null;
    const storedF=sameVersion?localStorage.getItem('takumi_flashSales'):null;
    const parsedV=storedV?JSON.parse(storedV):vouchers;
    const parsedF=storedF?JSON.parse(storedF):flashSales;
    vouchers=normalizeVoucherList(parsedV);
    flashSales=Array.isArray(parsedF)?parsedF.map(f=>({
      ...f,
      enabled:f.enabled!==false&&String(f.enabled)!=='false',
      type:f.type||(f.fixed!==undefined?'fixed':'percent'),
      value:Number(f.value??f.percent??f.fixed??0),
      percent:Number((f.type||'percent')==='percent'?(f.value??f.percent??0):(f.percent||0))
    })).filter(f=>flashValue(f)>0 && String(f.title||'').trim()!=='Flash Sale hôm nay'):[];
    persistPromos();
  }catch(e){
    vouchers=normalizeVoucherList(vouchers);
    flashSales=Array.isArray(flashSales)?flashSales:[];
  }
}
function persistPromos(){
  try{
    localStorage.setItem('takumi_promo_storage_version',TAKUMI_PROMO_STORAGE_VERSION);
    localStorage.setItem('takumi_vouchers',JSON.stringify(normalizeVoucherList(vouchers)));
    localStorage.setItem('takumi_flashSales',JSON.stringify(flashSales));
  }catch(e){}
}


function adminSwitchPromoTab(tab){
  ['Voucher','Flash','List'].forEach(name=>{
    const key=name.toLowerCase();
    const panel=document.getElementById('promoPanel'+name);
    const btn=document.getElementById('promoTab'+name);
    if(panel)panel.classList.toggle('active',key===tab);
    if(btn)btn.classList.toggle('active',key===tab);
  });
  if(tab==='flash')adminEnsureFlashDefaults(false);
}
function adminSyncVoucherTypeUI(){
  const typeEl=document.getElementById('adminVoucherType');
  const valueEl=document.getElementById('adminVoucherValue');
  const labelEl=document.getElementById('adminVoucherValueLabel');
  if(!typeEl||!valueEl||!labelEl)return;
  if(typeEl.value==='fixed'){
    labelEl.textContent='Số tiền giảm';
    valueEl.placeholder='VD: 50000';
  }else{
    labelEl.textContent='Phần trăm giảm';
    valueEl.placeholder='VD: 10';
  }
}
function adminTodayDateTime(hour=0,minute=0){
  const d=new Date();
  d.setHours(hour,minute,0,0);
  return new Date(d.getTime()-d.getTimezoneOffset()*60000).toISOString().slice(0,16);
}
function adminEnsureFlashDefaults(force=false){
  const title=document.getElementById('adminFlashTitle');
  const start=document.getElementById('adminFlashStart');
  const end=document.getElementById('adminFlashEnd');
  if(title && (force || !title.value.trim()))title.value='Flash sale cuối tuần';
  if(start && (force || !start.value))start.value=adminTodayDateTime(0,0);
  if(end && (force || !end.value))end.value=adminTodayDateTime(23,59);
}
function adminSyncFlashTypeUI(){
  const typeEl=document.getElementById('adminFlashType');
  const valueEl=document.getElementById('adminFlashValue');
  const labelEl=document.getElementById('adminFlashValueLabel');
  if(!typeEl||!valueEl||!labelEl)return;
  if(typeEl.value==='fixed'){
    labelEl.textContent='Số tiền giảm';
    valueEl.placeholder='VD: 50000';
  }else{
    labelEl.textContent='Phần trăm giảm';
    valueEl.placeholder='VD: 15';
  }
}
function adminPromoPreset(type){
  const now=new Date();
  const plus7=new Date(now.getTime()+7*24*60*60*1000);
  const plus2h=new Date(now.getTime()+2*60*60*1000);
  const fmt=d=>new Date(d.getTime()-d.getTimezoneOffset()*60000).toISOString().slice(0,16);
  if(type==='event'){
    adminSwitchPromoTab('voucher');
    document.getElementById('adminVoucherCampaign').value='Chương trình ưu đãi đặc biệt';
    document.getElementById('adminVoucherCode').value='TAKUMI10';
    document.getElementById('adminVoucherType').value='fixed';
    document.getElementById('adminVoucherValue').value='50000';
    document.getElementById('adminVoucherMinSpend').value='500000';
    document.getElementById('adminVoucherScope').value='all';
    document.getElementById('adminVoucherNote').value='Giảm toàn bộ sản phẩm';
    document.getElementById('adminVoucherStart').value=fmt(now);
    document.getElementById('adminVoucherEnd').value=fmt(plus7);
    adminSyncVoucherTypeUI();
  }
  if(type==='product'){
    adminSwitchPromoTab('voucher');
    document.getElementById('adminVoucherCampaign').value='Voucher riêng sản phẩm';
    document.getElementById('adminVoucherCode').value='GIAMTHEM';
    document.getElementById('adminVoucherType').value='percent';
    document.getElementById('adminVoucherValue').value='5';
    document.getElementById('adminVoucherMinSpend').value='0';
    document.getElementById('adminVoucherScope').value='product';
    document.getElementById('adminVoucherNote').value='Chỉ áp dụng sản phẩm đang chọn';
    document.getElementById('adminVoucherStart').value=fmt(now);
    document.getElementById('adminVoucherEnd').value=fmt(plus7);
    adminSyncVoucherTypeUI();
  }
  if(type==='flash'){
    adminSwitchPromoTab('flash');
    document.getElementById('adminFlashTitle').value='Flash sale cuối tuần';
    document.getElementById('adminFlashEnabled').value='true';
    document.getElementById('adminFlashType').value='percent';
    document.getElementById('adminFlashValue').value='12';
    document.getElementById('adminFlashScope').value='all';
    document.getElementById('adminFlashStart').value=adminTodayDateTime(0,0);
    document.getElementById('adminFlashEnd').value=adminTodayDateTime(23,59);
    adminSyncFlashTypeUI();
  }
}
function promoStatusClass(item){
  const now=Date.now(),s=toTime(item.start),e=toTime(item.end);
  if(s&&now<s)return ['scheduled','Sắp diễn ra'];
  if(e&&now>e)return ['expired','Đã hết hạn'];
  return ['active','Đang chạy'];
}

function promoDateLabel(v){
  const s=v.start?new Date(v.start).toLocaleString('vi-VN'):'Không giới hạn';
  const e=v.end?new Date(v.end).toLocaleString('vi-VN'):'Không giới hạn';
  return `${s} → ${e}`;
}
function adminCurrentProductId(){
  const id=Number(document.getElementById('adminId')?.value||0);
  return id||null;
}
function adminSaveVoucher(){
  const code=document.getElementById('adminVoucherCode').value.trim().toUpperCase();
  const type=document.getElementById('adminVoucherType').value;
  const value=Number(document.getElementById('adminVoucherValue').value||0);
  const scope=document.getElementById('adminVoucherScope').value;
  const minSpend=Math.max(0,Number(document.getElementById('adminVoucherMinSpend')?.value||0));
  const productId=adminCurrentProductId();
  if(!code||!value){alert('Bạn nhập mã voucher và giá trị giảm.');return}
  if(scope==='product'&&!productId){alert('Bạn chọn/sửa một sản phẩm trước khi tạo voucher riêng cho sản phẩm.');return}
  const item={code,campaign:document.getElementById('adminVoucherCampaign')?.value.trim()||'Chương trình voucher',note:document.getElementById('adminVoucherNote')?.value.trim()||'',type,value,minSpend,scope,productIds:scope==='product'?[productId]:[],start:document.getElementById('adminVoucherStart').value,end:document.getElementById('adminVoucherEnd').value};
  vouchers=vouchers.filter(v=>String(v.code).toUpperCase()!==code);
  vouchers.unshift(item);
  persistPromos();refreshStorefront();
  adminSwitchPromoTab('list');
  alert('Đã lưu voucher.');
}

function adminPromoScopeLabel(item){
  if(!item)return '';
  if(item.scope==='all')return 'Toàn website';
  const ids=(item.productIds||[]).map(Number).filter(Boolean);
  if(!ids.length)return 'Sản phẩm riêng';
  const names=ids.map(id=>products.find(p=>Number(p.id)===id)?.name||('ID '+id));
  return names.join(', ');
}
function adminPromoValueLabel(item){
  if(!item)return '';
  if(item.type==='fixed')return money(Number(item.value)||0);
  if(item.percent!==undefined)return `-${item.percent}%`;
  return `-${item.value}%`;
}
function adminPromoItemClass(item){
  const st=promoStatusClass(item);
  return st[0]==='active'?'is-active':st[0]==='scheduled'?'is-scheduled':'is-expired';
}
function adminPromoStats(list){
  return {
    active:list.filter(x=>promoStatusClass(x)[0]==='active').length,
    scheduled:list.filter(x=>promoStatusClass(x)[0]==='scheduled').length,
    expired:list.filter(x=>promoStatusClass(x)[0]==='expired').length
  };
}
function adminPromoOverviewHtml(items,label){
