let products=loadStoredProducts();
products.forEach(p=>{p.colorImages=p.colorImages||{'Trắng đá':p.img,'Xám đá':p.img,'Vàng cổ':p.img,'Đen nhám':p.img};});
function takumiSameId(a,b){return String(a??'')===String(b??'')}
function takumiIdArg(id){return JSON.stringify(id)}
function takumiProductById(id){return (products||[]).find(p=>takumiSameId(p.id,id))}
function takumiDeletedProductIds(){
  try{return JSON.parse(localStorage.getItem('takumi_deleted_product_ids')||'[]').map(String)}catch(e){return []}
}
function takumiSetDeletedProductIds(ids){
  try{localStorage.setItem('takumi_deleted_product_ids',JSON.stringify([...new Set((ids||[]).map(String))]))}catch(e){}
}
function takumiMarkDeletedProduct(id){
  const ids=takumiDeletedProductIds();
  if(!ids.some(x=>takumiSameId(x,id))){ids.push(String(id));takumiSetDeletedProductIds(ids)}
}
function takumiUnmarkDeletedProduct(id){
  const ids=takumiDeletedProductIds().filter(x=>!takumiSameId(x,id));
  takumiSetDeletedProductIds(ids);
}
function takumiApplyDeletedProducts(list){
  const deleted=takumiDeletedProductIds();
  if(!deleted.length)return list||[];
  return (list||[]).filter(p=>!deleted.some(id=>takumiSameId(id,p.id)));
}
function takumiRemoveProductIdFromList(list,targetId){
  return (list||[]).map(item=>{
    if(!item||item.scope!=='product')return item;
    const next={...item,productIds:(item.productIds||[]).filter(pid=>!takumiSameId(pid,targetId))};
    return next;
  }).filter(item=>item && (item.scope!=='product' || (item.productIds||[]).length));
}
function money(n){return n.toLocaleString('vi-VN')+' ₫'}
function productRating(p){return Number(p.rating||4.9).toFixed(1)}
function compactMetric(n){
  n=Number(n||0);
  if(n>=1000){
    const v=(Math.round(n/100)/10).toFixed(1).replace('.',',').replace(',0','');
    return `${v}k`;
  }
  return String(n);
}
function productReviewCount(p){
  return Number(p.reviewCount||Math.max(allReviews(p).length, p.id*173+215));
}
function productTypeBadge(p){
  if(!p)return 'Takumi Product';
  if(p.type==='buddha')return 'Tượng Phật';
  if(p.type==='decor')return 'Decor';
  if(p.type==='figure')return 'Figure / Custom';
  return 'Takumi Product';
}
function productSold(p){return Number(p.sold||Math.max(18, p.id*7+24))}
function ratingHtml(p){const r=productRating(p);return `<span class="rating-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><b>${r}</b></span>`}
function soldHtml(p){return `<span class="sold-count"><i class="fa-solid fa-bag-shopping"></i>Đã bán ${productSold(p)}</span>`}
function toTime(v){return v?new Date(v).getTime():0}
function promoActive(item){
  const now=Date.now(),s=toTime(item.start),e=toTime(item.end);
  return (!s||now>=s)&&(!e||now<=e);
}
function promoApplies(item,p){
  if(!item||!p)return false;
  if(item.scope==='all')return true;
  return (item.productIds||[]).map(Number).includes(Number(p.id));
}
function flashEnabled(f){
  return f && f.enabled!==false && String(f.enabled)!=='false';
}
function flashType(f){
  return f?.type || (f?.fixed!==undefined?'fixed':'percent');
}
function flashValue(f){
  return Number(f?.value ?? f?.percent ?? f?.fixed ?? 0);
}
function flashValueLabel(f){
  return flashType(f)==='fixed'?`Giảm ${money(flashValue(f))}`:`Giảm ${flashValue(f)}%`;
}
function flashDiscountAmount(f,base){
  if(!f||!base)return 0;
  const value=flashValue(f);
  if(!value)return 0;
  return flashType(f)==='fixed'?Math.min(base,value):Math.round(base*value/100/1000)*1000;
}
function getActiveFlashForProduct(p){
  return (flashSales||[]).find(f=>flashEnabled(f)&&promoActive(f)&&promoApplies(f,p)&&flashValue(f)>0)||null;
}
function takumiVariantStyles(product){
  const styles=[...new Set((product?.variants||[]).map(v=>String(v.style||'').trim()).filter(Boolean))];
  return styles;
}
function takumiFindVariant(product,size,style){
  const variants=Array.isArray(product?.variants)?product.variants:[];
  if(!variants.length || size==='Theo yêu cầu')return null;
  const requestedStyle=String(style||selectedStyle||'').trim();
  return variants.find(v=>String(v.size||'')===String(size||'') && (!requestedStyle || String(v.style||'')===requestedStyle))
      || variants.find(v=>String(v.size||'')===String(size||''))
      || variants[0] || null;
}
function baseProductPrice(p,size){
  const variant=takumiFindVariant(p,size,selectedStyle);
  if(variant && Number(variant.price))return Number(variant.price);
  const m=size==='10cm'?1:size==='15cm'?2.25:size==='20cm'?4.5:0;
  return size==='Theo yêu cầu'?0:Math.round(Number(p?.price||0)*m/1000)*1000;
}
function oldProductPriceFor(p,size){
  const variant=takumiFindVariant(p,size,selectedStyle);
  if(variant && Number(variant.oldPrice||variant.old))return Number(variant.oldPrice||variant.old);
  if(!p||!Number(p.old))return 0;
  const m=size==='10cm'?1:size==='15cm'?2.25:size==='20cm'?4.5:0;
  return size==='Theo yêu cầu'?0:Math.round(Number(p.old)*m/1000)*1000;
}
function cartItemRegularPrice(item){
  return Number(item.basePrice||item.regularPrice||item.price||0);
}
function productBaseSaleAmountForCartItem(item){
  return Math.max(0,Number(item.oldPrice||0)-cartItemRegularPrice(item));
}
function productBaseSalePercentForCartItem(item){
  const old=Number(item.oldPrice||0);
  const saved=productBaseSaleAmountForCartItem(item);
  return old&&saved?Math.round(saved/old*100):0;
}
function cartBaseSaleItems(){
  return (cart||[]).filter(i=>productBaseSaleAmountForCartItem(i)>0);
}
function cartBaseSaleDiscount(){
  return cartBaseSaleItems().reduce((s,i)=>s+(isBaseSaleChecked(i.id)?productBaseSaleAmountForCartItem(i)*cartItemQuantity(i):0),0);
}

function flashPriceFor(p,size){
  const base=baseProductPrice(p,size),flash=getActiveFlashForProduct(p);
  if(!base||!flash)return base;
  return Math.max(0,base-flashDiscountAmount(flash,base));
}
function voucherDiscountAmount(v,p,price){
  if(!v||!promoActive(v)||!promoApplies(v,p)||!price)return 0;
  return v.type==='fixed'?Math.min(price,Number(v.value)||0):Math.round(price*(Number(v.value)||0)/100/1000)*1000;
}
function finalPriceFor(p,size,voucher){
  const afterFlash=flashPriceFor(p,size);
  return Math.max(0,afterFlash-voucherDiscountAmount(voucher,p,afterFlash));
}
function applyVoucher(){
  const input=document.getElementById('voucherCodeInput');
  const msg=document.getElementById('voucherMessage');
  if(!input||!currentProduct)return;
  const code=input.value.trim().toUpperCase();
  const v=(vouchers||[]).find(x=>String(x.code||'').toUpperCase()===code);
  if(!v){activeVoucher=null;msg.textContent='Mã voucher không tồn tại.';msg.className='voucher-message error';updateModal();return;}
  if(!promoActive(v)){activeVoucher=null;msg.textContent='Mã voucher chưa đến thời gian áp dụng hoặc đã hết hạn.';msg.className='voucher-message error';updateModal();return;}
  if(!promoApplies(v,currentProduct)){activeVoucher=null;msg.textContent='Mã voucher này không áp dụng cho sản phẩm đang chọn.';msg.className='voucher-message error';updateModal();return;}
  activeVoucher=v;msg.textContent=`Đã áp dụng mã ${v.code}: ${v.type==='fixed'?money(Number(v.value)||0):'-'+v.value+'%'}`;msg.className='voucher-message success';updateModal();
}
function clearInvalidVoucher(){
  if(activeVoucher&&(!promoActive(activeVoucher)||!promoApplies(activeVoucher,currentProduct)))activeVoucher=null;
}




