function showCartAddedToast(){
  let toast=document.getElementById('cartAddedToast');
  if(!toast){
    toast=document.createElement('div');
    toast.id='cartAddedToast';
    toast.className='cart-added-toast';
    toast.innerHTML='<i class="fa-solid fa-circle-check"></i><span>Đã thêm vào giỏ hàng</span>';
    document.body.appendChild(toast);
  }
  toast.classList.add('show');
  clearTimeout(window.cartAddedToastTimer);
  window.cartAddedToastTimer=setTimeout(()=>toast.classList.remove('show'),1500);
}

function bumpCartIcon(){
  const count=document.getElementById('cartCount');
  if(!count)return;
  count.classList.remove('bump');
  void count.offsetWidth;
  count.classList.add('bump');
}

function flyProductToCart(){
  const source=document.getElementById('modalImg');
  const cartIcon=document.querySelector('.cart-btn');
  if(!source||!cartIcon){showCartAddedToast();bumpCartIcon();return Promise.resolve();}
  const start=source.getBoundingClientRect();
  const end=cartIcon.getBoundingClientRect();
  const clone=source.cloneNode(true);
  clone.className='cart-fly-img';
  clone.style.left=start.left+'px';
  clone.style.top=start.top+'px';
  clone.style.width=Math.min(96,start.width)+'px';
  clone.style.height=Math.min(96,start.height)+'px';
  document.body.appendChild(clone);
  const startX=0,startY=0;
  const endX=end.left+end.width/2-(start.left+Math.min(96,start.width)/2);
  const endY=end.top+end.height/2-(start.top+Math.min(96,start.height)/2);
  const anim=clone.animate([
    {transform:`translate(${startX}px,${startY}px) scale(1)`,opacity:1},
    {transform:`translate(${endX*.45}px,${endY*.25-70}px) scale(.82)`,opacity:.92},
    {transform:`translate(${endX}px,${endY}px) scale(.18)`,opacity:.15}
  ],{duration:760,easing:'cubic-bezier(.22,.8,.22,1)'});
  return anim.finished.catch(()=>{}).then(()=>{clone.remove();showCartAddedToast();bumpCartIcon();});
}


function showTakumiToast(title='Đã thêm vào giỏ hàng', message='Sản phẩm đã được thêm vào giỏ.'){
  let wrap=document.getElementById('takumiToastWrap');
  if(!wrap){
    wrap=document.createElement('div');
    wrap.id='takumiToastWrap';
    wrap.className='takumi-toast-wrap';
    document.body.appendChild(wrap);
  }
  const toast=document.createElement('div');
  toast.className='takumi-toast';
  toast.innerHTML=`<div class="takumi-toast-icon"><i class="fa-solid fa-check"></i></div><div><b>${escapeAttr(title)}</b><span>${escapeAttr(message)}</span></div>`;
  wrap.appendChild(toast);
  setTimeout(()=>toast.classList.add('hide'),2600);
  setTimeout(()=>toast.remove(),2900);
}
