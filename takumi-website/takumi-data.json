function productCard(p){const s=p.selectedColor||p.colors[0];const imgSrc=(p.colorImages&&p.colorImages[s.name])||p.img;const display=productDisplayPrice(p);const old=productDisplayOldPrice(p);return `<article class="product-card reveal-on-scroll" onclick="openProduct(${p.id})"><div class="product-img ${s.cls}" id="imgWrap-${p.id}"><img id="cardImg-${p.id}" src="${imgSrc}" alt="${p.name}" loading="lazy"><div class="badge-layer"><div class="badge-left">${p.sale?`<span class="badge sale">-${p.sale}%</span>`:''}</div><div class="badge-right">${takumiBadgeHtml(p)}${p.ship?`<span class="badge ship"><i class="fa-solid fa-truck"></i> Freeship</span>`:''}</div></div><div class="quick-color" onclick="event.stopPropagation()"><small>Chọn màu</small><div class="swatches">${p.colors.map(c=>`<button title="${c.name}" class="swatch ${c.name===s.name?'active':''}" style="background:${c.hex}" onclick="selectCardColor(event,${p.id},'${c.name}')"></button>`).join('')}</div></div></div><div class="product-info"><h3 class="product-title">${p.name}</h3><p class="product-short">${p.short}</p><div class="price-line"><span class="product-price">Từ ${money(display)}</span>${old?`<span class="old-price">${money(old)}</span>`:''}</div><div class="meta-line">${ratingHtml(p)}${soldHtml(p)}</div></div></article>`}
function renderProducts(){const q=(document.getElementById('searchInput')?.value||'').toLowerCase().trim();const list=products.filter(p=>(p.name+' '+p.short+' '+p.desc+' '+p.type).toLowerCase().includes(q)&&(activeFilter==='all'||p.type===activeFilter||p.filter===activeFilter));document.getElementById('productGrid').innerHTML=list.map(productCard).join('');observeRevealItems()}
function selectCardColor(event,id,colorName){
  if(event)event.stopPropagation();
  const p=products.find(x=>x.id===id);if(!p)return;
  const c=p.colors.find(x=>x.name===colorName)||p.colors[0];p.selectedColor=c;
  const wrap=document.getElementById('imgWrap-'+id);if(!wrap)return;
  const cardImg=document.getElementById('cardImg-'+id);
  const nextSrc=takumiColorImage(p,c.name);
  wrap.querySelectorAll('.swatch').forEach(b=>b.classList.remove('active'));
  if(event&&event.currentTarget)event.currentTarget.classList.add('active');
  wrap.classList.add('is-fading');
  setTimeout(()=>{
    wrap.classList.remove('color-white','color-gray','color-gold','color-black');wrap.classList.add(c.cls);
    if(cardImg&&cardImg.src!==nextSrc)cardImg.src=nextSrc;
    requestAnimationFrame(()=>wrap.classList.remove('is-fading'));
  },150);
}
